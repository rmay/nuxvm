( --- Application Framework --- )

INCLUDE "lib/vfs.lux"
INCLUDE "lib/draw.lux"
INCLUDE "lib/event.lux"
INCLUDE "lib/ui.lux"

MODULE APP

IMPORT VFS
IMPORT DRAW
IMPORT EVENT
IMPORT UI

( --- State --- )
( Using 0x8C0000 range to avoid collision with DRAW::BUF at 0x8F0000 )
@dfd      0x8C0000 ;
@mfd      0x8C0004 ;
@kfd      0x8C0008 ;
@nfd      0x8C0058 ;
@npkt     0x8C0060 ; ( 32 bytes for /dev/menu picks )
@v-frame  0x8C000C ;
@v-mouse  0x8C0010 ;
@v-kbd    0x8C0014 ;
@v-resume 0x8C0018 ;
@mpkt     0x8C0020 ; ( 8 bytes )
@kpkt     0x8C0030 ; ( 8 bytes: Type, pad, KeyCode(2), Modifiers(4) )
@win-w    0x8C0040 ;
@win-h    0x8C0044 ;
@dirty-f  0x8C0048 ;
@text-font-id  0x8C0080 ;
@text-font-grp 0x8C0084 ;
@v-font        0x8C0088 ;
( Alias of UI::APP_MODAL — same cell, not a second reservation. )
@modal-f  ( -- addr ) UI::APP_MODAL ;

( --- ESC Popup State --- )
@esc-open     0x8C0050 ;
@esc-btn-hov  0x8C0054 ; ( 0=none, 1=continue, 2=restart, 3=quit )

( --- Accessors --- )
@draw-fd  ( -- fd ) dfd LOADI ;
@mouse-fd ( -- fd ) mfd LOADI ;
@kbd-fd   ( -- fd ) kfd LOADI ;
@menu-fd  ( -- fd ) nfd LOADI ;
@under-shell? ( -- f ) nfd LOADI ;
@width    ( -- w )  win-w LOADI ;
@height   ( -- h )  win-h LOADI ;

( A caller that bypasses APP::init/loop entirely -- e.g. Fluxio's own
  self-contained event loop, docs/quill_fluxio.md Phase C -- never runs
  open-devices/sync-canvas, so win-w/win-h stay 0. That breaks anything
  that centers on APP::width/height (SF::show's dialog placement), so
  such a caller needs to set them directly instead. )
@win-set! ( w h -- )
    win-h STOREI
    win-w STOREI
;
@dirty!   ( -- )    1 dirty-f STOREI ;
@dirty?   ( -- f )  dirty-f LOADI ;
@dirty-off ( -- )   0 dirty-f STOREI ;
@esc-open? ( -- f ) esc-open LOADI ;
@modal!   ( f -- )  modal-f STOREI ;
@modal?   ( -- f )  modal-f LOADI ;

( --- Vector Setters --- )
@on-frame! ( addr -- ) v-frame STOREI ;
@on-mouse! ( addr -- ) v-mouse STOREI ;
@on-kbd!   ( addr -- ) v-kbd   STOREI ;
@on-resume! ( addr -- ) v-resume STOREI ;

@resume-app ( -- )
    v-resume LOADI dup 0 > [ CALLSTACK ] [ drop ] ?:
;

( --- ESC Popup Routines --- )

@esc-continue ( val -- )
    drop
    0 esc-open STOREI
    resume-app
;

@esc-restart ( val -- )
    drop
    0 esc-open STOREI
    resume-app
    0x600000 JMPSTACK
;

@esc-quit ( val -- )
    drop
    HALT
;

@esc-label ( i -- ptr )
    dup 1 = [
        drop T"Continue"
    ] [
        dup 2 = [
            drop T"Restart App"
        ] [
            drop T"Quit"
        ] ?:
    ] ?:
;

@esc-sync ( -- )
    esc-btn-hov LOADI esc-label UI::overlay-default
;

@esc-build ( -- )
    win-w LOADI 200 - 2 /
    win-h LOADI 160 - 2 /
    2 frame! ( 0:y 1:x )
    UI::overlay-clear
    T"Continue"    1 local@ 40 + 0 local@ 50 +  120 20 [ esc-continue ] UI::overlay-button
    T"Restart App" 1 local@ 40 + 0 local@ 78 +  120 20 [ esc-restart ]  UI::overlay-button
    T"Quit"        1 local@ 40 + 0 local@ 106 + 120 20 [ esc-quit ]    UI::overlay-button
    2 unframe!
    1 esc-btn-hov STOREI
    esc-sync
;

@draw-esc-popup ( -- )
    dfd LOADI DRAW::CHICAGO DRAW::set-font
    win-w LOADI 200 - 2 /
    win-h LOADI 160 - 2 /
    2 frame! ( 0:y 1:x )
    dfd LOADI 1 local@ 2 - 0 local@ 2 - 204 164 0x000000 DRAW::fill-rect
    dfd LOADI 1 local@ 0 local@ 200 160 0xFFFFFF DRAW::fill-rect
    dfd LOADI 1 local@ 35 + 0 local@ 15 + T"System Menu" 0x000000 16 DRAW::draw-str
    2 unframe!
    UI::overlay-draw
;

@handle-esc-mouse ( mpkt -- )
    1 frame! ( 0:mpkt )
    0 local@ UI::overlay-feed
    UI::overlay-handle
    0 local@ EVENT::mouse-x
    0 local@ EVENT::mouse-y
    UI::overlay-pick
    0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
        UI::overlay-held? 0 = [
            0 esc-open STOREI
            resume-app
        ] ?
    ] ?
    1 unframe!
;

@handle-esc-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key
        dup EVENT::KEY_UP_ARROW = [
            esc-btn-hov LOADI 1 - dup 1 < [ drop 3 ] ? esc-btn-hov STOREI
            esc-sync
        ] ?
        dup EVENT::KEY_DOWN_ARROW = [
            esc-btn-hov LOADI 1 + dup 3 > [ drop 1 ] ? esc-btn-hov STOREI
            esc-sync
        ] ?
        dup EVENT::KEY_ENTER = [
            UI::overlay-enter drop
            UI::overlay-handle
        ] ?
        dup EVENT::KEY_ESC = [
            0 esc-open STOREI
            resume-app
        ] ?
        drop
    ] ?
    drop
;

( --- Device Initialization --- )

@open-devices ( -- )
    ( /dev/draw )
    [ T"/dev/draw" VFS::open dup 0 < ] [
        drop VFS::yield drop
    ] |:
    dfd STOREI
    
    ( /dev/mouse )
    [ T"/dev/mouse" VFS::open dup 0 < ] [
        drop VFS::yield drop
    ] |:
    mfd STOREI
    
    ( /dev/kbd )
    [ T"/dev/kbd" VFS::open dup 0 < ] [
        drop VFS::yield drop
    ] |:
    kfd STOREI

    ( /dev/menu is optional; a missing file means the app owns its bar. )
    T"/dev/menu" VFS::open dup 0 < [ drop 0 ] ?
    nfd STOREI
    nfd LOADI UI::export-fd!

    ( Canvas size from /dev/draw: LE u16 w, u16 h. Fallback 960×720. )
    dfd LOADI npkt 4 VFS::read 4 = [
        npkt DRAW::load-word-le win-w STOREI
        npkt 2 + DRAW::load-word-le win-h STOREI
    ] [
        960 win-w STOREI
        720 win-h STOREI
    ] ?:
;

( --- Framework Lifecycle --- )

@sync-canvas ( -- )
    dfd LOADI npkt 4 VFS::read 4 = [
        npkt DRAW::load-word-le win-w STOREI
        npkt 2 + DRAW::load-word-le win-h STOREI
    ] ?
;

@text-font ( -- id ) text-font-id LOADI ;

@font-hook! ( xt -- ) v-font STOREI ;

@use-text-font ( -- )
    dfd LOADI text-font-id LOADI DRAW::set-font
;

@apply-text-font ( id -- )
    1 frame!
    0 local@ text-font-id STOREI
    T"Chicago" 0 UI::item-set
    T"Geneva"  0 UI::item-set
    T"Monaco"  0 UI::item-set
    0 local@ DRAW::CHICAGO = [ T"Chicago" 1 UI::item-set ] ?
    0 local@ DRAW::GENEVA  = [ T"Geneva"  1 UI::item-set ] ?
    0 local@ DRAW::MONACO  = [ T"Monaco"  1 UI::item-set ] ?
    v-font LOADI dup 0 > [ 0 local@ SWAP CALLSTACK ] [ drop ] ?:
    dirty!
    1 unframe!
;

@font-chicago ( val -- ) drop DRAW::CHICAGO apply-text-font ;
@font-geneva  ( val -- ) drop DRAW::GENEVA  apply-text-font ;
@font-monaco  ( val -- ) drop DRAW::MONACO  apply-text-font ;

( Document face only. Menus and buttons stay Chicago. )
@font-menu ( -- )
    T"font" text-font-grp STOREI
    T"Font" UI::menu
    T"Chicago" text-font-grp LOADI [ font-chicago ] UI::radio-item
    T"Geneva"  text-font-grp LOADI [ font-geneva ]  UI::radio-item
    T"Monaco"  text-font-grp LOADI [ font-monaco ]  UI::radio-item
    DRAW::CHICAGO apply-text-font
;

@init ( title-ptr -- )
    VFS::set-window-title
    open-devices
    dfd LOADI DRAW::use
    DRAW::CHICAGO text-font-id STOREI
    0 v-font STOREI
    dfd LOADI DRAW::CHICAGO DRAW::set-font
    0 modal-f STOREI
    dirty!
;

@loop ( -- )
    [ 1 ] [
        dfd LOADI DRAW::begin-frame
        dfd LOADI DRAW::CHICAGO DRAW::set-font
        sync-canvas

        ( 1. Handle Mouse — drain the queue so a drag sees every move )
        [ mfd LOADI mpkt 8 VFS::read 8 = ]
        [
            esc-open LOADI [
                mpkt handle-esc-mouse
            ] [
                v-mouse LOADI dup 0 > [
                    mpkt swap CALLSTACK
                ] [ drop ] ?:
            ] ?:
        ] |:

        ( 2. Handle Keyboard )
        kfd LOADI kpkt 8 VFS::read 8 = [
            esc-open LOADI [
                kpkt handle-esc-kbd
            ] [
                kpkt EVENT::kbd-type EVENT::KEY_DOWN = 
                kpkt EVENT::kbd-key EVENT::KEY_ESC = AND
                modal-f LOADI 0 = AND [
                    1 esc-open STOREI
                    esc-build
                ] [
                    v-kbd LOADI dup 0 > [
                        kpkt swap CALLSTACK
                    ] [ drop ] ?:
                ] ?:
            ] ?:
        ] ?

        nfd LOADI 0 > [
            nfd LOADI npkt 32 VFS::read
            dup 2 >= [
                npkt load-byte 1 = [
                    npkt 1 + load-byte
                    dup 30 > [ drop 30 ] ?
                    npkt 2 + OVER + 0 SWAP store-byte
                    npkt 2 + UI::menu-pick
                ] ?
            ] ?
            drop
        ] ?
        UI::handle

        ( 3. Handle Frame )
        v-frame LOADI dup 0 > [
            CALLSTACK
        ] [ drop ] ?:

        nfd LOADI 0 > [ UI::export ] ?

        ( 4. Handle Overlay )
        esc-open LOADI [
            draw-esc-popup
        ] ?

        dfd LOADI DRAW::end-frame
        VFS::yield DROP
    ] |:
;
