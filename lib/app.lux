( --- Application Framework --- )

INCLUDE "lib/vfs.lux"
INCLUDE "lib/draw.lux"
INCLUDE "lib/event.lux"
INCLUDE "lib/ui.lux"
INCLUDE "lib/time.lux"

MODULE APP

IMPORT VFS
IMPORT DRAW
IMPORT EVENT
IMPORT UI
IMPORT TIME

( --- State ---
  Compiler-allocated (docs/reserve-directive.md). These used to be picked
  by hand out of the 0x8C0000 range specifically to dodge DRAW::BUF at
  0x8F0000 -- that kind of reasoning is what RESERVE removes. )
RESERVE dfd      4 ;
RESERVE mfd      4 ;
RESERVE kfd      4 ;
RESERVE nfd      4 ;
RESERVE npkt    32 ; ( /dev/menu picks )
RESERVE v-frame  4 ;
RESERVE v-mouse  4 ;
RESERVE v-kbd    4 ;
RESERVE v-resume 4 ;
RESERVE mpkt     8 ;
RESERVE kpkt     8 ; ( Type, pad, KeyCode(2), Modifiers(4) )
RESERVE win-w    4 ;
RESERVE win-h    4 ;
RESERVE dirty-f  4 ;
RESERVE text-font-id  4 ;
RESERVE text-font-grp 4 ;
RESERVE v-font        4 ;

( --- Fixed-timestep simulation clock ---
  Painting happens once per rendered frame, but simulation runs on its own
  fixed 16ms step so a game's speed does not depend on how long a frame took
  to draw, or on the host's refresh rate. An app registers on-tick! for
  physics/state and on-frame! for drawing; an app that registers no on-tick
  never reads the clock and behaves exactly as it did before. )
RESERVE v-tick    4 ;  ( simulation hook, 0 = not registered )
RESERVE tick-acc  4 ;  ( unspent milliseconds )
RESERVE tick-ms   4 ;  ( monotonic ms sampled on the previous frame )
RESERVE tfd       4 ;  ( persistent /dev/time fd, 0 = not open )
RESERVE tbuf     16 ;  ( /dev/time snapshot )
RESERVE afd       4 ;  ( persistent /dev/audio fd, 0 = not open )
RESERVE abuf      4 ;  ( /dev/audio packet )

@STEP_MS   16 ;   ( ~60 simulation steps a second )
@MAX_STEPS  5 ;   ( catch-up cap for one rendered frame )
@MAX_DT   100 ;   ( never replay more than 100ms of a stall )
@ALPHA_ONE 256 ;  ( tick-alpha's scale: a whole step )
( Alias of UI::APP_MODAL — same cell, not a second reservation. )
@modal-f  ( -- addr ) UI::APP_MODAL ;

( --- ESC Popup State --- )
RESERVE esc-open    4 ;
RESERVE esc-btn-hov 4 ; ( 0=none, 1=continue, 2=restart, 3=quit )

( --- Accessors --- )
@draw-fd  ( -- fd ) dfd LOADI ;
@mouse-fd ( -- fd ) mfd LOADI ;
@kbd-fd   ( -- fd ) kfd LOADI ;
@menu-fd  ( -- fd ) nfd LOADI ;
@under-shell? ( -- f ) nfd LOADI ;
@width    ( -- w )  win-w LOADI ;
@height   ( -- h )  win-h LOADI ;

( Monotonic milliseconds off the persistent /dev/time fd -- bytes 12-15 of the
  16-byte snapshot. TIME::milli@ would do the same job, but it opens and closes
  the device on every call, and this runs once a frame. Returns tick-ms
  unchanged if the device was never opened, which reads as dt = 0. )
( How far into the current simulation step the renderer is, 0..ALPHA_ONE-1.
  A fixed step never lines up with a frame period -- 16ms against cloister's
  16.67ms means one frame in every ~24 runs two steps -- so an app that paints
  its raw simulation state lurches on those frames. Painting instead at
  `prev + (cur - prev) * tick-alpha / ALPHA_ONE` renders one step behind but
  advances by the same distance every frame, however the steps fell.

  Only meaningful during on-frame, after the tick phase has spent the whole
  steps it owed. )
@tick-alpha ( -- n )
    tick-acc LOADI ALPHA_ONE * STEP_MS /
    dup ALPHA_ONE >= [ drop ALPHA_ONE 1 - ] ?
    dup 0 < [ drop 0 ] ?
;

( Interpolate one value between its previous-step and current-step readings.
  Whole units in, whole units out: an app holding fixed-point state should
  pass the scaled values and divide afterwards, so the fraction survives. )
@lerp ( prev cur -- v )
    OVER - tick-alpha * ALPHA_ONE / +
;

@now-ms ( -- ms )
    tfd LOADI 0 > [
        tfd LOADI tbuf 16 VFS::read 16 = [
            tbuf 12 + TIME::load-int-le
        ] [
            tick-ms LOADI
        ] ?:
    ] [
        tick-ms LOADI
    ] ?:
;

( A caller that bypasses APP::init/loop entirely -- e.g. Fluxio's own
  self-contained event loop, docs/quill_fluxio.md Phase C -- never runs
  open-devices/sync-canvas, so win-w/win-h stay 0. That breaks anything
  that centers on APP::width/height (SF::show's dialog placement), so
  such a caller needs to set them directly instead. )
@win-set! ( w h -- )
    win-h STOREI
    win-w STOREI
;
@dirty!   ( -- )    1 dirty-f STOREI ;
@dirty?   ( -- f )  dirty-f LOADI ;
@dirty-off ( -- )   0 dirty-f STOREI ;
@esc-open? ( -- f ) esc-open LOADI ;
@modal!   ( f -- )  modal-f STOREI ;
@modal?   ( -- f )  modal-f LOADI ;

( --- Vector Setters --- )
@on-frame! ( addr -- ) v-frame STOREI ;

( Registering the sim hook also seeds the clock, so the first tick phase sees
  a small dt rather than the whole interval since the machine booted. )
@on-tick!  ( addr -- )
    v-tick STOREI
    0 tick-acc STOREI
    now-ms tick-ms STOREI
;
@on-mouse! ( addr -- ) v-mouse STOREI ;
@on-kbd!   ( addr -- ) v-kbd   STOREI ;
@on-resume! ( addr -- ) v-resume STOREI ;

@resume-app ( -- )
    v-resume LOADI dup 0 > [ CALLSTACK ] [ drop ] ?:
;

( --- ESC Popup Routines --- )

@esc-continue ( val -- )
    drop
    0 esc-open STOREI
    resume-app
;

@esc-restart ( val -- )
    drop
    0 esc-open STOREI
    resume-app
    0x600000 JMPSTACK
;

@esc-quit ( val -- )
    drop
    HALT
;

@esc-label ( i -- ptr )
    dup 1 = [
        drop T"Continue"
    ] [
        dup 2 = [
            drop T"Restart App"
        ] [
            drop T"Quit"
        ] ?:
    ] ?:
;

@esc-sync ( -- )
    esc-btn-hov LOADI esc-label UI::overlay-default
;

@esc-build ( -- )
    win-w LOADI 200 - 2 /
    win-h LOADI 160 - 2 /
    2 frame! ( 0:y 1:x )
    UI::overlay-clear
    T"Continue"    1 local@ 40 + 0 local@ 50 +  120 20 [ esc-continue ] UI::overlay-button
    T"Restart App" 1 local@ 40 + 0 local@ 78 +  120 20 [ esc-restart ]  UI::overlay-button
    T"Quit"        1 local@ 40 + 0 local@ 106 + 120 20 [ esc-quit ]    UI::overlay-button
    2 unframe!
    1 esc-btn-hov STOREI
    esc-sync
;

@draw-esc-popup ( -- )
    dfd LOADI DRAW::CHICAGO DRAW::set-font
    win-w LOADI 200 - 2 /
    win-h LOADI 160 - 2 /
    2 frame! ( 0:y 1:x )
    dfd LOADI 1 local@ 2 - 0 local@ 2 - 204 164 0x000000 DRAW::fill-rect
    dfd LOADI 1 local@ 0 local@ 200 160 0xFFFFFF DRAW::fill-rect
    dfd LOADI 1 local@ 35 + 0 local@ 15 + T"System Menu" 0x000000 16 DRAW::draw-str
    2 unframe!
    UI::overlay-draw
;

@handle-esc-mouse ( mpkt -- )
    1 frame! ( 0:mpkt )
    0 local@ UI::overlay-feed
    UI::overlay-handle
    0 local@ EVENT::mouse-x
    0 local@ EVENT::mouse-y
    UI::overlay-pick
    0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
        UI::overlay-held? 0 = [
            0 esc-open STOREI
            resume-app
        ] ?
    ] ?
    1 unframe!
;

@handle-esc-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key
        dup EVENT::KEY_UP_ARROW = [
            esc-btn-hov LOADI 1 - dup 1 < [ drop 3 ] ? esc-btn-hov STOREI
            esc-sync
        ] ?
        dup EVENT::KEY_DOWN_ARROW = [
            esc-btn-hov LOADI 1 + dup 3 > [ drop 1 ] ? esc-btn-hov STOREI
            esc-sync
        ] ?
        dup EVENT::KEY_ENTER = [
            UI::overlay-enter drop
            UI::overlay-handle
        ] ?
        dup EVENT::KEY_ESC = [
            0 esc-open STOREI
            resume-app
        ] ?
        drop
    ] ?
    drop
;

( Optional; init already calls this via open-devices. A caller that skips
  APP::init can still beep if it opens the device itself. Missing
  /dev/audio stores 0, and beep is then a no-op. )
@audio-open ( -- )
    T"/dev/audio" VFS::open dup 0 < [ drop 0 ] ?
    afd STOREI
;

@beep { id -- }
    afd LOADI 0 > [
        id abuf DRAW::store-int-le
        afd LOADI abuf 4 VFS::write drop
    ] ?
;

( --- Device Initialization --- )

@open-devices ( -- )
    ( /dev/draw )
    [ T"/dev/draw" VFS::open dup 0 < ] [
        drop VFS::yield drop
    ] |:
    dfd STOREI
    
    ( /dev/mouse )
    [ T"/dev/mouse" VFS::open dup 0 < ] [
        drop VFS::yield drop
    ] |:
    mfd STOREI
    
    ( /dev/kbd )
    [ T"/dev/kbd" VFS::open dup 0 < ] [
        drop VFS::yield drop
    ] |:
    kfd STOREI

    ( /dev/time drives the fixed-timestep clock. Optional in the same sense as
      /dev/menu: without it now-ms reports no elapsed time and on-tick simply
      never fires, which is no worse than not registering one. )
    T"/dev/time" VFS::open dup 0 < [ drop 0 ] ?
    tfd STOREI

    ( /dev/menu is optional; a missing file means the app owns its bar. )
    T"/dev/menu" VFS::open dup 0 < [ drop 0 ] ?
    nfd STOREI

    ( /dev/audio is optional: beep is a no-op when the host has no device. )
    audio-open
    nfd LOADI UI::export-fd!

    ( Canvas size from /dev/draw: LE u16 w, u16 h. Fallback 960×720. )
    dfd LOADI npkt 4 VFS::read 4 = [
        npkt DRAW::load-word-le win-w STOREI
        npkt 2 + DRAW::load-word-le win-h STOREI
    ] [
        960 win-w STOREI
        720 win-h STOREI
    ] ?:
;

( --- Framework Lifecycle --- )

@sync-canvas ( -- )
    dfd LOADI npkt 4 VFS::read 4 = [
        npkt DRAW::load-word-le win-w STOREI
        npkt 2 + DRAW::load-word-le win-h STOREI
    ] ?
;

@text-font ( -- id ) text-font-id LOADI ;

@font-hook! ( xt -- ) v-font STOREI ;

@use-text-font ( -- )
    dfd LOADI text-font-id LOADI DRAW::set-font
;

@apply-text-font ( id -- )
    1 frame!
    0 local@ text-font-id STOREI
    T"Chicago" 0 UI::item-set
    T"Geneva"  0 UI::item-set
    T"Monaco"  0 UI::item-set
    0 local@ DRAW::CHICAGO = [ T"Chicago" 1 UI::item-set ] ?
    0 local@ DRAW::GENEVA  = [ T"Geneva"  1 UI::item-set ] ?
    0 local@ DRAW::MONACO  = [ T"Monaco"  1 UI::item-set ] ?
    v-font LOADI dup 0 > [ 0 local@ SWAP CALLSTACK ] [ drop ] ?:
    dirty!
    1 unframe!
;

@font-chicago ( val -- ) drop DRAW::CHICAGO apply-text-font ;
@font-geneva  ( val -- ) drop DRAW::GENEVA  apply-text-font ;
@font-monaco  ( val -- ) drop DRAW::MONACO  apply-text-font ;

( Document face only. Menus and buttons stay Chicago. )
@font-menu ( -- )
    T"font" text-font-grp STOREI
    T"Font" UI::menu
    T"Chicago" text-font-grp LOADI [ font-chicago ] UI::radio-item
    T"Geneva"  text-font-grp LOADI [ font-geneva ]  UI::radio-item
    T"Monaco"  text-font-grp LOADI [ font-monaco ]  UI::radio-item
    DRAW::CHICAGO apply-text-font
;

@init ( title-ptr -- )
    VFS::set-window-title
    open-devices
    dfd LOADI DRAW::use
    DRAW::CHICAGO text-font-id STOREI
    0 v-font STOREI
    dfd LOADI DRAW::CHICAGO DRAW::set-font
    0 modal-f STOREI
    dirty!
;

( Channel is RGB until an app asks. Call after init, which opens /dev/draw. )
@grayscale! ( -- ) draw-fd DRAW::grayscale ;
@color!     ( -- ) draw-fd DRAW::CHAN_RGB DRAW::chan! ;

@loop ( -- )
    [ 1 ] [
        dfd LOADI DRAW::begin-frame
        dfd LOADI DRAW::CHICAGO DRAW::set-font
        sync-canvas

        ( 1. Handle Mouse — drain the queue so a drag sees every move.
          Uses read-noyield: a plain VFS::read yields the whole VM the
          instant the queue is empty (its natural, expected loop-exit
          case here), which stalls this frame's draw/end-frame for
          1-2 host ticks on every call that finds nothing queued -- the
          common case. read-noyield polls without that side effect. )
        [ mfd LOADI mpkt 8 VFS::read-noyield 8 = ]
        [
            esc-open LOADI [
                mpkt handle-esc-mouse
            ] [
                v-mouse LOADI dup 0 > [
                    mpkt swap CALLSTACK
                ] [ drop ] ?:
            ] ?:
        ] |:

        ( 2. Handle Keyboard — drained like the mouse. A held key is a
          KEY_DOWN/KEY_UP pair, and a burst of auto-repeat arrives faster
          than one packet a frame, so taking a single packet per frame let
          the 64-slot queue back up into visible input lag. )
        [ kfd LOADI kpkt 8 VFS::read-noyield 8 = ]
        [
            esc-open LOADI [
                kpkt handle-esc-kbd
            ] [
                kpkt EVENT::kbd-type EVENT::KEY_DOWN = 
                kpkt EVENT::kbd-key EVENT::KEY_ESC = AND
                modal-f LOADI 0 = AND [
                    1 esc-open STOREI
                    esc-build
                ] [
                    v-kbd LOADI dup 0 > [
                        kpkt swap CALLSTACK
                    ] [ drop ] ?:
                ] ?:
            ] ?:
        ] |:

        nfd LOADI 0 > [
            nfd LOADI npkt 32 VFS::read
            dup 2 >= [
                npkt load-byte 1 = [
                    npkt 1 + load-byte
                    dup 30 > [ drop 30 ] ?
                    npkt 2 + OVER + 0 SWAP store-byte
                    npkt 2 + UI::menu-pick
                ] ?
            ] ?
            drop
        ] ?
        UI::handle

        ( 3. Simulation — fixed STEP_MS steps, however long the frame took.
          A frame that overran replays the steps it missed instead of just
          running the game slower. )
        v-tick LOADI 0 > [
            now-ms { now }
                now tick-ms LOADI - { dt }
                    ( First frame, or a clock that went backwards. )
                    dt 0 < [ 0 dt! ] ?
                    ( Don't replay a long stall -- an app resumed from the ESC
                      menu, or a frame that blew its cycle budget, would
                      otherwise dump seconds of simulation into one frame. )
                    dt MAX_DT > [ MAX_DT dt! ] ?
                    now tick-ms STOREI
                    tick-acc LOADI dt + tick-acc STOREI
                UNGIRD
            UNGIRD

            0 { steps }
                [ tick-acc LOADI STEP_MS >= steps MAX_STEPS < AND ] [
                    v-tick LOADI CALLSTACK
                    tick-acc LOADI STEP_MS - tick-acc STOREI
                    steps 1 + steps!
                ] |:
                ( Capped out: drop the backlog rather than carry it into the
                  next frame, where it would cap out again forever. )
                steps MAX_STEPS >= [ 0 tick-acc STOREI ] ?
            UNGIRD
        ] ?

        ( 4. Handle Frame — drawing only, for an app that also has on-tick )
        v-frame LOADI dup 0 > [
            CALLSTACK
        ] [ drop ] ?:

        nfd LOADI 0 > [ UI::export ] ?

        ( 5. Handle Overlay )
        esc-open LOADI [
            draw-esc-popup
        ] ?

        dfd LOADI DRAW::end-frame
        VFS::yield DROP
    ] |:
;
