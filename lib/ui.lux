( UI Widget Library — Buttons, Checkboxes, Sliders, Scrollbars, Menu bar )

INCLUDE "lib/draw.lux"
INCLUDE "lib/time.lux"
INCLUDE "lib/geom.lux"
INCLUDE "lib/mem.lux"
INCLUDE "lib/event.lux"
INCLUDE "lib/str.lux"

MODULE UI

( --- Theme Colors (System 6 style) --- )
@CLR_BG      0xFFFFFF ;
@CLR_BORDER  0x000000 ;
@CLR_TEXT    0x000000 ;
@CLR_HILIGHT 0xFFFFFF ;
@CLR_SHADOW  0x000000 ;
@CLR_HOVER   0xEEEEEE ;
@CLR_PRESS   0x000000 ;
@CLR_CHECK   0x000000 ;
@CLR_TRACK   0x000000 ;
@CLR_THUMB   0x000000 ;
@CLR_DESK    0xFFFFFF ;

@FONT_CHAR_W  7 ;    ( fallback; prefer DRAW::char-w )
@FONT_CHAR_H  12 ;   ( Chicago 12 )
@BOX         12 ;    ( System 6 checkbox / radio — HIG )
@SL_THUMB_W  17 ;
@SL_THUMB_H  11 ;
@SL_TRACK_W  11 ;
@MENU_H      20 ;
@ITEM_H      18 ;
@MENU_PAD    10 ;
@MENU_MARK   28 ;
@MENU_MIN_TW 48 ;
@MENU_MIN_IW 120 ;
@MI_CMD       0 ;
@MI_CHECK     1 ;
@MI_RADIO     2 ;
@MI_SEP       3 ;
@APP_MODAL   0x8C004C ;

( --- Hit Testing --- )

@in-rect? ( mx my x y w h -- bool )
    6 frame! ( 0:h 1:w 2:y 3:x 4:my 5:mx )
    5 local@ 3 local@ >=
    5 local@ 3 local@ 1 local@ + < AND
    4 local@ 2 local@ >= AND
    4 local@ 2 local@ 0 local@ + < AND
    6 unframe!
;

( --- Control helpers on DRAW primitives --- )

( Framed white box: PaintRect black, inset PaintRect white. )
@frame-rect ( fd x y w h -- )
    5 frame! ( 0:h 1:w 2:y 3:x 4:fd )
    4 local@ 3 local@ 2 local@ 1 local@ 0 local@ CLR_BORDER DRAW::paint-rect
    4 local@ 3 local@ 1 + 2 local@ 1 + 1 local@ 2 - 0 local@ 2 - CLR_BG DRAW::paint-rect
    5 unframe!
;

@dither-rect ( fd x y w h -- )
    5 frame! ( 0:h 1:w 2:y 3:x 4:fd )
    4 local@ 3 local@ 2 local@ 1 local@ 0 local@ CLR_BORDER 0 DRAW::fill-pat
    5 unframe!
;

@hline-rect ( fd x y w h -- )
    5 frame! ( 0:h 1:w 2:y 3:x 4:fd )
    4 local@ 3 local@ 2 local@ 1 local@ 0 local@ CLR_BORDER 1 DRAW::fill-pat
    5 unframe!
;

@desk ( fd x y w h -- )
    5 frame! ( 0:h 1:w 2:y 3:x 4:fd )
    4 local@ 3 local@ 2 local@ 1 local@ 0 local@ CLR_BG DRAW::fill-rect
    4 local@ 3 local@ 2 local@ 1 local@ 0 local@ CLR_BORDER 0 DRAW::fill-pat
    5 unframe!
;

( Menu bar paint lives in mb-draw-bar / mb-draw-drop. )

@draw-border-rect ( fd x y w h fill -- )
    6 frame! ( 0:fill 1:h 2:w 3:y 4:x 5:fd )
    5 local@ 4 local@ 3 local@ 2 local@ 1 local@ CLR_BORDER DRAW::frame-rect
    5 local@ 4 local@ 1 + 3 local@ 1 + 2 local@ 2 - 1 local@ 2 - 0 local@ DRAW::paint-rect
    6 unframe!
;

@draw-3d-rect ( fd x y w h fill -- )
    6 frame! ( 0:fill 1:h 2:w 3:y 4:x 5:fd )
    ( outer border )
    5 local@ 4 local@ 3 local@ 2 local@ 1 local@ CLR_BORDER DRAW::fill-rect
    ( top-left highlight )
    5 local@ 4 local@ 1 + 3 local@ 1 + 2 local@ 2 - 1 CLR_HILIGHT DRAW::fill-rect
    5 local@ 4 local@ 1 + 3 local@ 1 + 1 1 local@ 2 - CLR_HILIGHT DRAW::fill-rect
    ( bottom-right shadow )
    5 local@ 4 local@ 1 + 3 local@ 1 local@ + 1 - 2 local@ 2 - 1 CLR_SHADOW DRAW::fill-rect
    5 local@ 4 local@ 2 local@ + 1 - 3 local@ 1 + 1 1 local@ 2 - CLR_SHADOW DRAW::fill-rect
    ( inner fill )
    5 local@ 4 local@ 2 + 3 local@ 2 + 2 local@ 4 - 1 local@ 4 - 0 local@ DRAW::fill-rect
    6 unframe!
;

( ===== Button ===== )
( Struct (36 bytes): x(4) y(4) w(4) h(4) state(4) label-ptr(4) was-down(4) callback(4) default(4) )
@BTN_SIZE      36 ;
@BTN_X          0 ;
@BTN_Y          4 ;
@BTN_W          8 ;
@BTN_H         12 ;
@BTN_STATE     16 ;
@BTN_LABEL     20 ;
@BTN_WAS_DOWN  24 ;
@BTN_CALLBACK  28 ;
@BTN_DEFAULT   32 ;

@button-init ( addr x y w h label-ptr callback -- )
    7 frame! ( 0:callback 1:label 2:h 3:w 4:y 5:x 6:addr )
    5 local@ 6 local@ BTN_X        + STOREI
    4 local@ 6 local@ BTN_Y        + STOREI
    3 local@ 6 local@ BTN_W        + STOREI
    2 local@ 6 local@ BTN_H        + STOREI
    0        6 local@ BTN_STATE    + STOREI
    1 local@ 6 local@ BTN_LABEL   + STOREI
    0        6 local@ BTN_WAS_DOWN + STOREI
    0 local@ 6 local@ BTN_CALLBACK + STOREI
    0        6 local@ BTN_DEFAULT  + STOREI
    7 unframe!
;

( Generic System 6 push-button face. RoundRect, ovalWidth/Height 6. )
@button-face ( fd x y w h pressed -- )
    6 frame! ( 0:pressed 1:h 2:w 3:y 4:x 5:fd )
    0 local@ [
        5 local@ 4 local@ 3 local@ 2 local@ 1 local@ 6 6 CLR_BORDER DRAW::paint-rrect
    ] [
        5 local@ 4 local@ 3 local@ 2 local@ 1 local@ 6 6 CLR_BG DRAW::paint-rrect
        5 local@ 4 local@ 3 local@ 2 local@ 1 local@ 6 6 CLR_BORDER DRAW::frame-rrect
    ] ?:
    6 unframe!
;

@button-ring ( fd x y w h -- )
    5 frame! ( 0:h 1:w 2:y 3:x 4:fd )
    4 local@ 3 local@ 4 - 2 local@ 4 - 1 local@ 8 + 0 local@ 8 + 6 6 CLR_BORDER DRAW::frame-rrect
    4 local@ 3 local@ 3 - 2 local@ 3 - 1 local@ 6 + 0 local@ 6 + 6 6 CLR_BORDER DRAW::frame-rrect
    4 local@ 3 local@ 2 - 2 local@ 2 - 1 local@ 4 + 0 local@ 4 + 6 6 CLR_BORDER DRAW::frame-rrect
    5 unframe!
;

@button-label ( fd x y w h label color -- )
    7 frame! ( 0:color 1:label 2:h 3:w 4:y 5:x 6:fd )
    6 local@
    1 local@ DRAW::str-w
    3 local@ SWAP - 2 /
    5 local@ +
    2 local@ 2 / 7 -
    4 local@ +
    1 local@
    0 local@ 1 DRAW::draw-str
    7 unframe!
;

@button-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    0 local@ BTN_DEFAULT + LOADI [
        1 local@
        0 local@ BTN_X + LOADI
        0 local@ BTN_Y + LOADI
        0 local@ BTN_W + LOADI
        0 local@ BTN_H + LOADI
        button-ring
    ] ?
    1 local@
    0 local@ BTN_X + LOADI
    0 local@ BTN_Y + LOADI
    0 local@ BTN_W + LOADI
    0 local@ BTN_H + LOADI
    0 local@ BTN_STATE + LOADI 2 =
    button-face
    1 local@
    0 local@ BTN_X + LOADI
    0 local@ BTN_Y + LOADI
    0 local@ BTN_W + LOADI
    0 local@ BTN_H + LOADI
    0 local@ BTN_LABEL + LOADI
    0 local@ BTN_STATE + LOADI 2 = [
        CLR_BG
    ] [
        CLR_TEXT
    ] ?:
    button-label
    2 unframe!
;

@button-update ( addr mx my btn -- clicked? )
    4 frame! ( 0:btn 1:my 2:mx 3:addr )
    2 local@ 1 local@
    3 local@ BTN_X + LOADI
    3 local@ BTN_Y + LOADI
    3 local@ BTN_W + LOADI
    3 local@ BTN_H + LOADI
    in-rect? ( hit )
    dup [
        0 local@ 1 = [
            2 3 local@ BTN_STATE + STOREI
            0
        ] [
            3 local@ BTN_WAS_DOWN + LOADI [
                1 3 local@ BTN_STATE + STOREI
                1
            ] [
                1 3 local@ BTN_STATE + STOREI
                0
            ] ?:
        ] ?:
    ] [
        0 3 local@ BTN_STATE + STOREI
        0
    ] ?:
    0 local@ 3 local@ BTN_WAS_DOWN + STOREI
    swap drop
    4 unframe!
;

@button-tick ( addr mx my btn -- )
    4 frame! ( 0:btn 1:my 2:mx 3:addr )
    2 local@ 1 local@
    3 local@ BTN_X + LOADI
    3 local@ BTN_Y + LOADI
    3 local@ BTN_W + LOADI
    3 local@ BTN_H + LOADI
    in-rect? ( hit )
    dup [
        0 local@ 1 = [
            2 3 local@ BTN_STATE + STOREI
            0
        ] [
            3 local@ BTN_WAS_DOWN + LOADI [
                1 3 local@ BTN_STATE + STOREI
                1
            ] [
                1 3 local@ BTN_STATE + STOREI
                0
            ] ?:
        ] ?:
    ] [
        0 3 local@ BTN_STATE + STOREI
        0
    ] ?:
    0 local@ 3 local@ BTN_WAS_DOWN + STOREI
    ( call stored callback if clicked )
    [
        3 local@ BTN_CALLBACK + LOADI
        dup 0 > [
            CALL
        ] [
            drop
        ] ?:
    ] ?
    drop
    4 unframe!
;

@button-hit? ( addr mx my -- bool )
    3 frame! ( 0:my 1:mx 2:addr )
    1 local@ 0 local@
    2 local@ BTN_X + LOADI
    2 local@ BTN_Y + LOADI
    2 local@ BTN_W + LOADI
    2 local@ BTN_H + LOADI
    in-rect?
    3 unframe!
;

@button-press ( addr -- )
    2 SWAP BTN_STATE + STOREI
;

@button-track ( addr mx my -- )
    3 frame! ( 0:my 1:mx 2:addr )
    2 local@ 1 local@ 0 local@ button-hit? [
        2 2 local@ BTN_STATE + STOREI
    ] [
        0 2 local@ BTN_STATE + STOREI
    ] ?:
    3 unframe!
;

@button-release ( addr mx my -- clicked? )
    3 frame! ( 0:my 1:mx 2:addr )
    0 2 local@ BTN_STATE + STOREI
    2 local@ 1 local@ 0 local@ button-hit?
    3 unframe!
;

( ===== Checkbox ===== )
( Struct (24 bytes): x(4) y(4) size(4) checked(4) label-ptr(4) was-down(4) )
@CB_SIZE     24 ;
@CB_X         0 ;
@CB_Y         4 ;
@CB_SZ        8 ;
@CB_CHK      12 ;
@CB_LABEL    16 ;
@CB_WAS_DOWN 20 ;

@checkbox-init ( addr x y size label-ptr -- )
    5 frame! ( 0:label 1:size 2:y 3:x 4:addr )
    3 local@ 4 local@ CB_X + STOREI
    2 local@ 4 local@ CB_Y + STOREI
    1 local@ 4 local@ CB_SZ + STOREI
    0 4 local@ CB_CHK + STOREI
    0 local@ 4 local@ CB_LABEL + STOREI
    0 4 local@ CB_WAS_DOWN + STOREI
    5 unframe!
;

@checkbox-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    BOX 0 local@ CB_SZ + STOREI
    1 local@
    0 local@ CB_X + LOADI
    0 local@ CB_Y + LOADI
    BOX dup
    frame-rect
    0 local@ CB_CHK + LOADI [
        1 local@
        0 local@ CB_X + LOADI
        0 local@ CB_Y + LOADI
        BOX CLR_BORDER DRAW::x-mark
    ] ?
    ( label: box bottom is 2px below Chicago 12 baseline )
    1 local@
    0 local@ CB_X + LOADI BOX + 8 +
    0 local@ CB_Y + LOADI 2 -
    0 local@ CB_LABEL + LOADI
    CLR_TEXT 1
    DRAW::draw-str
    2 unframe!
;

@checkbox-update ( addr mx my btn -- toggled? )
    4 frame! ( 0:btn 1:my 2:mx 3:addr )
    0 ( toggled )
    0 local@ 1 = [
        2 local@ 1 local@
        3 local@ CB_X + LOADI
        3 local@ CB_Y + LOADI
        3 local@ CB_SZ + LOADI 160 +
        3 local@ CB_SZ + LOADI
        in-rect? [
            3 local@ CB_CHK + LOADI 0 = [ 1 ] [ 0 ] ?:
            3 local@ CB_CHK + STOREI
            drop 1
        ] ?
    ] ?
    4 unframe!
;

( ===== Radio Button ===== )
( Same struct layout as Checkbox (CB_SIZE=24). Only the draw routine differs. )
( Use checkbox-init and checkbox-update for radio buttons.                    )
( Apps manage mutual exclusion by clearing CB_CHK on siblings when one fires. )

@radio-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    BOX 0 local@ CB_SZ + STOREI
    1 local@ 0 local@ CB_X + LOADI 0 local@ CB_Y + LOADI BOX BOX CLR_BORDER DRAW::frame-oval
    0 local@ CB_CHK + LOADI [
        1 local@
        0 local@ CB_X + LOADI 3 +
        0 local@ CB_Y + LOADI 3 +
        6 6 CLR_CHECK DRAW::paint-oval
    ] ?
    1 local@
    0 local@ CB_X + LOADI BOX + 8 +
    0 local@ CB_Y + LOADI 2 -
    0 local@ CB_LABEL + LOADI
    CLR_TEXT 1 DRAW::draw-str
    2 unframe!
;

( Down in circle+label and currently off: turn on, return 1. Else 0. No toggle. )
@radio-update ( addr mx my btn -- selected? )
    4 frame! ( 0:btn 1:my 2:mx 3:addr )
    0
    0 local@ 1 = [
        2 local@ 1 local@
        3 local@ CB_X + LOADI
        3 local@ CB_Y + LOADI
        3 local@ CB_SZ + LOADI 160 +
        3 local@ CB_SZ + LOADI
        in-rect? [
            3 local@ CB_CHK + LOADI 0 = [
                1 3 local@ CB_CHK + STOREI
                drop 1
            ] ?
        ] ?
    ] ?
    4 unframe!
;

( ===== Slider ===== )
( Struct (40 bytes): x y w h min max val dragging pos off )
@SL_SIZE     40 ;
@SL_X         0 ;
@SL_Y         4 ;
@SL_W         8 ;
@SL_H        12 ;
@SL_MIN      16 ;
@SL_MAX      20 ;
@SL_VAL      24 ;
@SL_DRG      28 ;
@SL_POS      32 ;
@SL_OFF      36 ;

( ===== Text Widget ===== )
( Struct (48 bytes): x(4) y(4) w(4) h(4) buf(4) len(4) max(4) cursor(4) anchor(4) target-x(4) drag(4) line-h(4) )
@TX_SIZE      48 ;
@TX_X          0 ;
@TX_Y          4 ;
@TX_W          8 ;
@TX_H         12 ;
@TX_BUF       16 ;
@TX_LEN       20 ;
@TX_MAX       24 ;
@TX_CURSOR    28 ;
@TX_ANCHOR    32 ;
@TX_TARGET_X  36 ;
@TX_DRAG      40 ;
@TX_LINE_H    44 ;

@text-init ( addr x y w h buf max -- )
    7 frame! ( 0:max 1:buf 2:h 3:w 4:y 5:x 6:addr )
    5 local@ 6 local@ TX_X + STOREI
    4 local@ 6 local@ TX_Y + STOREI
    3 local@ 6 local@ TX_W + STOREI
    2 local@ 6 local@ TX_H + STOREI
    1 local@ 6 local@ TX_BUF + STOREI
    0        6 local@ TX_LEN + STOREI
    0 local@ 6 local@ TX_MAX + STOREI
    0        6 local@ TX_CURSOR + STOREI
    -1       6 local@ TX_ANCHOR + STOREI
    0        6 local@ TX_TARGET_X + STOREI
    0        6 local@ TX_DRAG + STOREI
    @FONT_CHAR_H 6 local@ TX_LINE_H + STOREI
    7 unframe!
;

@text-sel-lo ( addr -- idx )
    dup TX_CURSOR + LOADI 
    SWAP TX_ANCHOR + LOADI 
    MIN
;

@text-sel-hi ( addr -- idx )
    dup TX_CURSOR + LOADI 
    SWAP TX_ANCHOR + LOADI 
    MAX
;

@text-sel-active? ( addr -- bool )
    dup TX_ANCHOR + LOADI -1 = [
        drop 0
    ] [
        dup TX_ANCHOR + LOADI over TX_CURSOR + LOADI = [
            drop 0
        ] [
            drop 1
        ] ?:
    ] ?:
;

@text-delete-range ( addr lo hi -- )
    3 frame! ( 0:hi 1:lo 2:addr )
    2 local@ TX_BUF + LOADI 0 local@ +                     ( src )
    2 local@ TX_BUF + LOADI 1 local@ +                     ( dst )
    2 local@ TX_LEN + LOADI 0 local@ -                     ( count )
    MEMORY::move-mem
    2 local@ TX_LEN + LOADI 0 local@ - 1 local@ + 2 local@ TX_LEN + STOREI
    1 local@ 2 local@ TX_CURSOR + STOREI
    -1 2 local@ TX_ANCHOR + STOREI
    3 unframe!
;

@text-delete-selection ( addr -- )
    dup text-sel-active? [
        dup dup text-sel-lo swap text-sel-hi text-delete-range
    ] [
        drop
    ] ?:
;

@text-insert-char ( addr ch -- )
    2 frame! ( 0:ch 1:addr )
    1 local@ TX_BUF + LOADI 0 = [
    ] [
    1 local@ TX_LEN + LOADI 1 local@ TX_MAX + LOADI < [
        ( shift right )
        1 local@ TX_BUF + LOADI 1 local@ TX_CURSOR + LOADI +                 ( src )
        1 local@ TX_BUF + LOADI 1 local@ TX_CURSOR + LOADI + 1 +             ( dst )
        1 local@ TX_LEN + LOADI 1 local@ TX_CURSOR + LOADI -                 ( count )
        MEMORY::move-mem
        ( store char )
        0 local@ 1 local@ TX_BUF + LOADI 1 local@ TX_CURSOR + LOADI + store-byte
        ( update lens )
        1 local@ TX_LEN + LOADI 1 + 1 local@ TX_LEN + STOREI
        1 local@ TX_CURSOR + LOADI 1 + 1 local@ TX_CURSOR + STOREI
    ] ?
    ] ?:
    2 unframe!
;

@text-delete-char ( addr -- )
    1 frame! ( 0:addr )
    0 local@ TX_CURSOR + LOADI 0 > [
        0 local@ TX_BUF + LOADI 0 local@ TX_CURSOR + LOADI +                 ( src )
        0 local@ TX_BUF + LOADI 0 local@ TX_CURSOR + LOADI + 1 -             ( dst )
        0 local@ TX_LEN + LOADI 0 local@ TX_CURSOR + LOADI -                 ( count )
        MEMORY::move-mem
        0 local@ TX_LEN + LOADI 1 - 0 local@ TX_LEN + STOREI
        0 local@ TX_CURSOR + LOADI 1 - 0 local@ TX_CURSOR + STOREI
    ] ?
    1 unframe!
;

@text-find-index ( addr mx my -- idx )
    3 frame! ( 0:my 1:mx 2:addr )
    1 local@ 2 local@ TX_X + LOADI - 0 MAX
    DRAW::char-w / 
    2 local@ TX_LEN + LOADI MIN
    3 unframe!
;

@text-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    
    ( Selection )
    0 local@ text-sel-active? [
        0 local@ text-sel-lo 0 local@ text-sel-hi 
        0 local@ TX_X + LOADI 0 local@ TX_Y + LOADI 0 
        5 frame! ( 0:i 1:y 2:x 3:lo 4:hi )
        [ 0 local@ 4 local@ < ] [
            0 local@ 3 local@ >= [
                1 local@ ( fd )
                2 local@ 1 local@ @FONT_CHAR_W @FONT_CHAR_H
                0xCCDDFF DRAW::fill-rect
            ] ?
            ( Advance x,y )
            5 local@ TX_BUF + LOADI 0 local@ + load-byte
            dup 10 = [
                drop 5 local@ TX_X + LOADI 2 local!
                1 local@ @FONT_CHAR_H + 1 local!
            ] [
                drop 2 local@ @FONT_CHAR_W + 2 local!
                2 local@ 5 local@ TX_X + LOADI 5 local@ TX_W + LOADI + >= [
                    5 local@ TX_X + LOADI 2 local!
                    1 local@ @FONT_CHAR_H + 1 local!
                ] ?
            ] ?:
            0 local@ 1 + 0 local!
        ] |:
        5 unframe!
    ] ?

    ( Text )
    0 local@ TX_X + LOADI 0 local@ TX_Y + LOADI 0 3 frame! ( 0:i 1:y 2:x )
    [ 0 local@ 2 local@ TX_LEN + LOADI < ] [
        ( Caret? )
        0 local@ 2 local@ TX_CURSOR + LOADI = [
            1 local@ 2 local@ @FONT_CHAR_H 2 / + ( fd )
            3 local@ 2 local@ 2 @FONT_CHAR_H 0xCC0000 DRAW::fill-rect
        ] ?

        ( Draw Char )
        1 local@ 3 local@ 2 local@
        2 local@ TX_BUF + LOADI 0 local@ + load-byte
        0x000000 1 DRAW::draw-char
        
        ( Advance )
        2 local@ TX_BUF + LOADI 0 local@ + load-byte
        dup 10 = [
            drop 2 local@ TX_X + LOADI 3 local!
            2 local@ @FONT_CHAR_H + 2 local!
        ] [
            drop 3 local@ @FONT_CHAR_W + 3 local!
            3 local@ 2 local@ TX_X + LOADI 2 local@ TX_W + LOADI + >= [
                2 local@ TX_X + LOADI 3 local!
                2 local@ @FONT_CHAR_H + 2 local!
            ] ?
        ] ?:
        0 local@ 1 + 0 local!
    ] |:
    
    ( Final Caret? )
    0 local@ 2 local@ TX_CURSOR + LOADI = [
        1 local@ 3 local@ 2 local@ 2 @FONT_CHAR_H 0xCC0000 DRAW::fill-rect
    ] ?
    3 unframe!
    2 unframe!
;

@text-update-mouse ( addr mx my type -- )
    4 frame! ( 0:type 1:my 2:mx 3:addr )
    0 local@ EVENT::MOUSE_DOWN = [
        2 local@ 1 local@ 3 local@ TX_X + LOADI 3 local@ TX_Y + LOADI 3 local@ TX_W + LOADI 3 local@ TX_H + LOADI in-rect? [
            3 local@ 2 local@ 1 local@ text-find-index
            dup 3 local@ TX_CURSOR + STOREI
            3 local@ TX_ANCHOR + STOREI
            1 3 local@ TX_DRAG + STOREI
        ] [
            -1 3 local@ TX_ANCHOR + STOREI
        ] ?:
    ] [
        0 local@ EVENT::MOUSE_MOVE = 3 local@ TX_DRAG + LOADI 1 = AND [
            3 local@ 2 local@ 1 local@ text-find-index
            3 local@ TX_CURSOR + STOREI
        ] [
            0 local@ EVENT::MOUSE_UP = [
                0 3 local@ TX_DRAG + STOREI
            ] ?
        ] ?:
    ] ?:
    4 unframe!
;

@text-update-kbd ( addr keycode mods -- )
    3 frame! ( 0:mods 1:keycode 2:addr )
    ( Dispatch similar to Quill )
    1 local@ EVENT::KEY_BACKSPACE = [
        2 local@ text-sel-active? [ 2 local@ text-delete-selection ] [ 2 local@ text-delete-char ] ?:
    ] [
        1 local@ EVENT::KEY_LEFT_ARROW =
        1 local@ EVENT::KEY_RIGHT_ARROW = OR [
            0 local@ EVENT::MOD_SHIFT AND 0 = 0 = [
                ( Shift held: set anchor if not set )
                2 local@ TX_ANCHOR + LOADI -1 = [ 2 local@ TX_CURSOR + LOADI 2 local@ TX_ANCHOR + STOREI ] ?
            ] [
                ( Shift not held: clear selection )
                -1 2 local@ TX_ANCHOR + STOREI
            ] ?:

            1 local@ EVENT::KEY_LEFT_ARROW = [
                2 local@ TX_CURSOR + LOADI 0 > [ 2 local@ TX_CURSOR + LOADI 1 - 2 local@ TX_CURSOR + STOREI ] ?
            ] [
                2 local@ TX_CURSOR + LOADI 2 local@ TX_LEN + LOADI < [ 2 local@ TX_CURSOR + LOADI 1 + 2 local@ TX_CURSOR + STOREI ] ?
            ] ?:
        ] [
            1 local@ STR::printable? [
                2 local@ text-sel-active? [ 2 local@ text-delete-selection ] ?
                2 local@ 1 local@ text-insert-char
            ] [
                1 local@ EVENT::KEY_ENTER = [
                    2 local@ text-sel-active? [ 2 local@ text-delete-selection ] ?
                    2 local@ 10 text-insert-char
                ] ?
            ] ?:
        ] ?:
    ] ?:
    3 unframe!
;

( Thumb top-y for a value. Max is at the top. )
@slider-pos-y ( addr val -- y )
    2 frame! ( 0:val 1:addr )
    1 local@ SL_H + LOADI SL_THUMB_H -
    dup 0 > [
        1 local@ SL_MAX + LOADI 0 local@ -
        OVER *
        1 local@ SL_MAX + LOADI 1 local@ SL_MIN + LOADI -
        dup 0 = [
            drop drop drop
            1 local@ SL_Y + LOADI
        ] [
            /
            1 local@ SL_Y + LOADI +
            SWAP drop
        ] ?:
    ] [
        drop
        1 local@ SL_Y + LOADI
    ] ?:
    2 unframe!
;

@slider-init ( addr x y w h min max val -- )
    8 frame! ( 0:val 1:max 2:min 3:h 4:w 5:y 6:x 7:addr )
    6 local@ 7 local@ SL_X + STOREI
    5 local@ 7 local@ SL_Y + STOREI
    4 local@ 7 local@ SL_W + STOREI
    3 local@ 7 local@ SL_H + STOREI
    2 local@ 7 local@ SL_MIN + STOREI
    1 local@ 7 local@ SL_MAX + STOREI
    0 local@ 7 local@ SL_VAL + STOREI
    0 7 local@ SL_DRG + STOREI
    0 7 local@ SL_OFF + STOREI
    7 local@ 0 local@ slider-pos-y 7 local@ SL_POS + STOREI
    8 unframe!
;

@slider-thumb-y ( addr -- y )
    SL_POS + LOADI
;

@slider-hit? ( addr mx my -- bool )
    3 frame! ( 0:my 1:mx 2:addr )
    1 local@ 0 local@
    2 local@ SL_X + LOADI
    2 local@ SL_Y + LOADI
    2 local@ SL_W + LOADI
    2 local@ SL_H + LOADI
    in-rect?
    3 unframe!
;

@slider-lo ( addr -- y )
    SL_Y + LOADI
;

@slider-hi ( addr -- y )
    dup SL_Y + LOADI SWAP SL_H + LOADI + SL_THUMB_H -
;

( Update SL_VAL from SL_POS. 1 if the integer changed. )
@slider-sync ( addr -- changed? )
    1 frame! ( 0:addr )
    0 local@ SL_H + LOADI SL_THUMB_H -
    dup 0 > [
        0 local@ SL_POS + LOADI 0 local@ SL_Y + LOADI -
        0 MAX
        OVER MIN
        0 local@ SL_MAX + LOADI 0 local@ SL_MIN + LOADI -
        *
        OVER 2 / +
        SWAP /
        0 local@ SL_MAX + LOADI SWAP -
        0 local@ SL_MIN + LOADI MAX
        0 local@ SL_MAX + LOADI MIN
        0 local@ SL_VAL + LOADI OVER = [
            drop 0
        ] [
            0 local@ SL_VAL + STOREI
            1
        ] ?:
    ] [
        drop 0
    ] ?:
    1 unframe!
;

( Grab: thumb keeps click offset; track click centers the thumb. )
@slider-grab ( addr my -- changed? )
    2 frame! ( 0:my 1:addr )
    1 1 local@ SL_DRG + STOREI
    1 local@ 1 local@ SL_VAL + LOADI slider-pos-y
    0 local@ OVER >=
    0 local@ 2 PICK SL_THUMB_H + <
    AND [
        0 local@ SWAP -
        1 local@ SL_OFF + STOREI
        1 local@ 1 local@ SL_VAL + LOADI slider-pos-y
        1 local@ SL_POS + STOREI
        0
    ] [
        drop
        SL_THUMB_H 2 / 1 local@ SL_OFF + STOREI
        0 local@ SL_THUMB_H 2 / -
        1 local@ slider-lo MAX
        1 local@ slider-hi MIN
        1 local@ SL_POS + STOREI
        1 local@ slider-sync
    ] ?:
    2 unframe!
;

@slider-drag ( addr my -- changed? )
    2 frame! ( 0:my 1:addr )
    0 local@ 1 local@ SL_OFF + LOADI -
    1 local@ slider-lo MAX
    1 local@ slider-hi MIN
    1 local@ SL_POS + STOREI
    1 local@ slider-sync
    2 unframe!
;

@slider-release ( addr -- )
    1 frame! ( 0:addr )
    0 0 local@ SL_DRG + STOREI
    0 local@ 0 local@ SL_VAL + LOADI slider-pos-y
    0 local@ SL_POS + STOREI
    1 unframe!
;

( Pointed 3D column, System 6 volume track. )
@sl-track ( fd x y h -- )
    4 frame! ( 0:h 1:y 2:x 3:fd )
    3 local@ 2 local@ 4 + 1 local@          3 1 CLR_BORDER DRAW::fill-rect
    3 local@ 2 local@ 2 + 1 local@ 1 +      7 1 CLR_BORDER DRAW::fill-rect
    3 local@ 2 local@     1 local@ 2 +     11 0 local@ 4 - 1 MAX CLR_BORDER DRAW::fill-rect
    3 local@ 2 local@ 2 + 1 local@ 0 local@ + 2 -  7 1 CLR_BORDER DRAW::fill-rect
    3 local@ 2 local@ 4 + 1 local@ 0 local@ + 1 -  3 1 CLR_BORDER DRAW::fill-rect
    3 local@ 2 local@ 4 + 1 local@ 1 +      3 1 CLR_BG DRAW::fill-rect
    3 local@ 2 local@ 2 + 1 local@ 2 +      7 1 CLR_BG DRAW::fill-rect
    3 local@ 2 local@ 1 + 1 local@ 3 +      9 0 local@ 6 - 1 MAX CLR_BG DRAW::fill-rect
    3 local@ 2 local@ 2 + 1 local@ 0 local@ + 3 -  7 1 CLR_BG DRAW::fill-rect
    3 local@ 2 local@ 4 + 1 local@ 0 local@ + 2 -  3 1 CLR_BG DRAW::fill-rect
    3 local@ 2 local@ 9 + 1 local@ 3 +      1 0 local@ 6 - 1 MAX CLR_BORDER DRAW::fill-rect
    4 unframe!
;

@sl-thumb ( fd x y -- )
    3 frame! ( 0:y 1:x 2:fd )
    2 local@ 1 local@ 0 local@ SL_THUMB_W SL_THUMB_H 6 6 CLR_BORDER DRAW::paint-rrect
    2 local@ 1 local@ 1 + 0 local@ 1 + SL_THUMB_W 2 - SL_THUMB_H 2 - 6 6 CLR_BG DRAW::paint-rrect
    2 local@ 1 local@ SL_THUMB_W 2 / + 1 - 0 local@ 3 + 5 CLR_BORDER DRAW::vline
    2 local@ 1 local@ SL_THUMB_W 2 / + 1 + 0 local@ 3 + 5 CLR_BORDER DRAW::vline
    3 unframe!
;

@SL_NBUF 0x8E0F20 ;

@slider-ticks ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    0 local@ SL_MAX + LOADI 0 local@ SL_MIN + LOADI -
    dup 0 > OVER 10 <= AND [
        drop
        0 local@ SL_MIN + LOADI
        [ dup 0 local@ SL_MAX + LOADI <= ] [
            dup SL_NBUF STR::int-to-str
            1 local@
            0 local@ SL_X + LOADI 4 -
            SL_NBUF STR::strlen DRAW::char-w * -
            0 local@ 2 PICK slider-pos-y
            1 +
            SL_NBUF
            CLR_TEXT 1 DRAW::draw-str
            1 +
        ] |:
        drop
    ] [
        drop
    ] ?:
    2 unframe!
;

@slider-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    1 local@
    0 local@ SL_X + LOADI 0 local@ SL_W + LOADI SL_TRACK_W - 2 / +
    0 local@ SL_Y + LOADI
    0 local@ SL_H + LOADI
    sl-track
    1 local@
    0 local@ SL_X + LOADI 0 local@ SL_W + LOADI SL_THUMB_W - 2 / +
    0 local@ slider-thumb-y
    sl-thumb
    1 local@ 0 local@ slider-ticks
    2 unframe!
;

@slider-update ( addr mx my btn -- value )
    4 frame! ( 0:btn 1:my 2:mx 3:addr )
    0 local@ 1 = [
        3 local@ SL_DRG + LOADI [
            3 local@ 1 local@ slider-drag drop
        ] [
            3 local@ 2 local@ 1 local@ slider-hit? [
                3 local@ 1 local@ slider-grab drop
            ] ?
        ] ?:
    ] [
        3 local@ SL_DRG + LOADI [
            3 local@ slider-release
        ] ?
    ] ?:
    3 local@ SL_VAL + LOADI
    4 unframe!
;

( Event-typed slider for the controlset. MOVE keeps an existing drag. )
@slider-ev ( addr mx my typ -- value )
    4 frame! ( 0:typ 1:my 2:mx 3:addr )
    0 local@ EVENT::MOUSE_DOWN = [
        3 local@ 2 local@ 1 local@ slider-hit? [
            3 local@ 1 local@ slider-grab drop
        ] ?
    ] ?
    3 local@ SL_DRG + LOADI [
        3 local@ 1 local@ slider-drag drop
    ] ?
    0 local@ EVENT::MOUSE_UP = [
        3 local@ slider-release
    ] ?
    3 local@ SL_VAL + LOADI
    4 unframe!
;

( ===== Scrollbar ===== )
( Struct (40 bytes): x(4) y(4) w(4) h(4) min(4) max(4) val(4) dragging(4) was-down(4) thumb-h(4) )
@SB_SIZE      40 ;
@SB_X          0 ;
@SB_Y          4 ;
@SB_W          8 ;
@SB_H         12 ;
@SB_MIN       16 ;
@SB_MAX       20 ;
@SB_VAL       24 ;
@SB_DRG       28 ;
@SB_WAS_DOWN  32 ;
@SB_THUMB_H   36 ;

@scrollbar-init ( addr x y w h min max val thumb-h -- )
    9 frame! ( 0:th 1:val 2:max 3:min 4:h 5:w 6:y 7:x 8:addr )
    7 local@ 8 local@ SB_X + STOREI
    6 local@ 8 local@ SB_Y + STOREI
    5 local@ 8 local@ SB_W + STOREI
    4 local@ 8 local@ SB_H + STOREI
    3 local@ 8 local@ SB_MIN + STOREI
    2 local@ 8 local@ SB_MAX + STOREI
    1 local@ 8 local@ SB_VAL + STOREI
    0        8 local@ SB_DRG + STOREI
    0        8 local@ SB_WAS_DOWN + STOREI
    0 local@ 8 local@ SB_THUMB_H + STOREI
    9 unframe!
;

@scrollbar-thumb-y ( addr -- thumb_y )
    dup SB_MAX + LOADI
    over SB_MIN + LOADI - ( range )
    dup 0 = [
        drop SB_Y + LOADI
    ] [
        1 frame! ( 0:range )
        dup SB_VAL + LOADI
        over SB_MIN + LOADI - ( val-min )
        over SB_H + LOADI
        2 PICK SB_THUMB_H + LOADI - ( track_h )
        * 0 local@ /
        swap SB_Y + LOADI +
        1 unframe!
    ] ?:
;

@scrollbar-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    1 local@ 0 local@ SB_X + LOADI 0 local@ SB_Y + LOADI
    0 local@ SB_W + LOADI 0 local@ SB_H + LOADI dither-rect
    1 local@ 0 local@ SB_X + LOADI 0 local@ SB_Y + LOADI
    0 local@ SB_W + LOADI 0 local@ SB_H + LOADI CLR_BORDER DRAW::draw-rect
    0 local@ scrollbar-thumb-y
    1 local@ 0 local@ SB_X + LOADI OVER
    0 local@ SB_W + LOADI 0 local@ SB_THUMB_H + LOADI
    frame-rect
    drop
    2 unframe!
;

@scrollbar-update ( addr mx my btn -- value )
    4 frame! ( 0:btn 1:my 2:mx 3:addr )
    0 local@ 1 = [
        2 local@ 1 local@
        3 local@ SB_X + LOADI
        3 local@ SB_Y + LOADI
        3 local@ SB_W + LOADI
        3 local@ SB_H + LOADI
        in-rect? [ 1 3 local@ SB_DRG + STOREI ] ?
    ] [
        0 3 local@ SB_DRG + STOREI
    ] ?:
    
    3 local@ SB_DRG + LOADI [
        3 local@ SB_MAX + LOADI 3 local@ SB_MIN + LOADI - dup 0 > [
            ( track_h = h - thumb_h )
            3 local@ SB_H + LOADI 3 local@ SB_THUMB_H + LOADI - ( range track_h )
            1 local@ 3 local@ SB_Y + LOADI - ( range track_h offset )
            0 MAX OVER MIN ( clamp offset )
            ROT * SWAP / ( offset * range / track_h )
            3 local@ SB_MIN + LOADI +
            3 local@ SB_VAL + STOREI
        ] [
            drop
        ] ?:
    ] ?
    3 local@ SB_VAL + LOADI
    4 unframe!
;

( ===== Component scrollbar (System 6, vertical and horizontal) ===== )
( Struct (56 bytes): x y w h min max val dragging off pos horiz part page )
@BAR_SIZE     56 ;
@BAR_X         0 ;
@BAR_Y         4 ;
@BAR_W         8 ;
@BAR_H        12 ;
@BAR_MIN      16 ;
@BAR_MAX      20 ;
@BAR_VAL      24 ;
@BAR_DRG      28 ;
@BAR_OFF      32 ;
@BAR_POS      36 ;
@BAR_HORIZ    40 ;
@BAR_PART     44 ;
@BAR_PAGE     48 ;

@sbar-arrow ( addr -- n )
    dup BAR_HORIZ + LOADI [
        BAR_H + LOADI
    ] [
        BAR_W + LOADI
    ] ?:
;

@sbar-track ( addr -- n )
    dup sbar-arrow
    SWAP
    dup BAR_HORIZ + LOADI [
        BAR_W + LOADI
    ] [
        BAR_H + LOADI
    ] ?:
    SWAP 2 * -
;

@sbar-thumb-n ( addr -- n )
    sbar-track
    dup 16 > [
        drop 16
    ] [
        1 MAX
    ] ?:
;

@sbar-travel ( addr -- n )
    dup sbar-track SWAP sbar-thumb-n - 0 MAX
;

@sbar-origin ( addr -- px )
    dup BAR_HORIZ + LOADI [
        dup BAR_X + LOADI SWAP sbar-arrow +
    ] [
        dup BAR_Y + LOADI SWAP sbar-arrow +
    ] ?:
;

@sbar-pos-from-val ( addr val -- pos )
    2 frame! ( 0:val 1:addr )
    1 local@ sbar-travel
    dup 0 = [
        drop
        1 local@ sbar-origin
    ] [
        0 local@ 1 local@ BAR_MIN + LOADI -
        0 MAX
        1 local@ BAR_MAX + LOADI 1 local@ BAR_MIN + LOADI - MIN
        OVER *
        1 local@ BAR_MAX + LOADI 1 local@ BAR_MIN + LOADI -
        dup 0 = [
            drop drop drop
            1 local@ sbar-origin
        ] [
            /
            1 local@ sbar-origin +
            SWAP drop
        ] ?:
    ] ?:
    2 unframe!
;

@sbar-init ( addr x y w h min max val horiz -- )
    9 frame! ( 0:horiz 1:val 2:max 3:min 4:h 5:w 6:y 7:x 8:addr )
    7 local@ 8 local@ BAR_X + STOREI
    6 local@ 8 local@ BAR_Y + STOREI
    5 local@ 8 local@ BAR_W + STOREI
    4 local@ 8 local@ BAR_H + STOREI
    3 local@ 8 local@ BAR_MIN + STOREI
    2 local@ 8 local@ BAR_MAX + STOREI
    1 local@ 3 local@ MAX 2 local@ MIN 8 local@ BAR_VAL + STOREI
    0 8 local@ BAR_DRG + STOREI
    0 8 local@ BAR_OFF + STOREI
    0 local@ 8 local@ BAR_HORIZ + STOREI
    0 8 local@ BAR_PART + STOREI
    2 local@ 3 local@ - 8 / 1 MAX 8 local@ BAR_PAGE + STOREI
    8 local@ 8 local@ BAR_VAL + LOADI sbar-pos-from-val
    8 local@ BAR_POS + STOREI
    9 unframe!
;

@sbar-sync ( addr -- changed? )
    1 frame! ( 0:addr )
    0 local@ sbar-travel
    dup 0 > [
        0 local@ BAR_POS + LOADI 0 local@ sbar-origin -
        0 MAX OVER MIN
        0 local@ BAR_MAX + LOADI 0 local@ BAR_MIN + LOADI -
        *
        OVER 2 / +
        SWAP /
        0 local@ BAR_MIN + LOADI +
        0 local@ BAR_MIN + LOADI MAX
        0 local@ BAR_MAX + LOADI MIN
        0 local@ BAR_VAL + LOADI OVER = [
            drop 0
        ] [
            0 local@ BAR_VAL + STOREI
            1
        ] ?:
    ] [
        drop 0
    ] ?:
    1 unframe!
;

@sbar-set-val ( addr new -- changed? )
    2 frame! ( 0:new 1:addr )
    0 local@ 1 local@ BAR_MIN + LOADI MAX
    1 local@ BAR_MAX + LOADI MIN
    1 local@ BAR_VAL + LOADI OVER = [
        drop 0
    ] [
        1 local@ BAR_VAL + STOREI
        1 local@ 1 local@ BAR_VAL + LOADI sbar-pos-from-val
        1 local@ BAR_POS + STOREI
        1
    ] ?:
    2 unframe!
;

@sbar-hit? ( addr mx my -- bool )
    3 frame! ( 0:my 1:mx 2:addr )
    1 local@ 0 local@
    2 local@ BAR_X + LOADI
    2 local@ BAR_Y + LOADI
    2 local@ BAR_W + LOADI
    2 local@ BAR_H + LOADI
    in-rect?
    3 unframe!
;

@sbar-which-v ( addr mx my -- part )
    3 frame! ( 0:my 1:mx 2:addr )
    1 local@ 0 local@
    2 local@ BAR_X + LOADI
    2 local@ BAR_Y + LOADI
    2 local@ BAR_W + LOADI
    2 local@ sbar-arrow
    in-rect? [
        1
    ] [
        1 local@ 0 local@
        2 local@ BAR_X + LOADI
        2 local@ BAR_Y + LOADI 2 local@ BAR_H + LOADI + 2 local@ sbar-arrow -
        2 local@ BAR_W + LOADI
        2 local@ sbar-arrow
        in-rect? [
            2
        ] [
            1 local@ 0 local@
            2 local@ BAR_X + LOADI
            2 local@ BAR_POS + LOADI
            2 local@ BAR_W + LOADI
            2 local@ sbar-thumb-n
            in-rect? [
                5
            ] [
                0 local@ 2 local@ BAR_POS + LOADI < [ 3 ] [ 4 ] ?:
            ] ?:
        ] ?:
    ] ?:
    3 unframe!
;

@sbar-which-h ( addr mx my -- part )
    3 frame! ( 0:my 1:mx 2:addr )
    1 local@ 0 local@
    2 local@ BAR_X + LOADI
    2 local@ BAR_Y + LOADI
    2 local@ sbar-arrow
    2 local@ BAR_H + LOADI
    in-rect? [
        1
    ] [
        1 local@ 0 local@
        2 local@ BAR_X + LOADI 2 local@ BAR_W + LOADI + 2 local@ sbar-arrow -
        2 local@ BAR_Y + LOADI
        2 local@ sbar-arrow
        2 local@ BAR_H + LOADI
        in-rect? [
            2
        ] [
            1 local@ 0 local@
            2 local@ BAR_POS + LOADI
            2 local@ BAR_Y + LOADI
            2 local@ sbar-thumb-n
            2 local@ BAR_H + LOADI
            in-rect? [
                5
            ] [
                1 local@ 2 local@ BAR_POS + LOADI < [ 3 ] [ 4 ] ?:
            ] ?:
        ] ?:
    ] ?:
    3 unframe!
;

@sbar-which ( addr mx my -- part )
    3 frame! ( 0:my 1:mx 2:addr )
    2 local@ BAR_MAX + LOADI 2 local@ BAR_MIN + LOADI <= [
        0
    ] [
        2 local@ 1 local@ 0 local@ sbar-hit? [
            2 local@ BAR_HORIZ + LOADI [
                2 local@ 1 local@ 0 local@ sbar-which-h
            ] [
                2 local@ 1 local@ 0 local@ sbar-which-v
            ] ?:
        ] [
            0
        ] ?:
    ] ?:
    3 unframe!
;

@sbar-press ( addr mx my -- changed? )
    3 frame! ( 0:my 1:mx 2:addr )
    2 local@ 1 local@ 0 local@ sbar-which
    dup 2 local@ BAR_PART + STOREI
    dup 0 = [
        drop 0
    ] [
        1 2 local@ BAR_DRG + STOREI
        dup 5 = [
            drop
            2 local@ BAR_HORIZ + LOADI [ 1 local@ ] [ 0 local@ ] ?:
            2 local@ BAR_POS + LOADI -
            2 local@ BAR_OFF + STOREI
            0
        ] [
            dup 1 = [
                drop
                2 local@ 2 local@ BAR_VAL + LOADI 1 - sbar-set-val
            ] [
                dup 2 = [
                    drop
                    2 local@ 2 local@ BAR_VAL + LOADI 1 + sbar-set-val
                ] [
                    dup 3 = [
                        drop
                        2 local@ 2 local@ BAR_VAL + LOADI 2 local@ BAR_PAGE + LOADI - sbar-set-val
                    ] [
                        drop
                        2 local@ 2 local@ BAR_VAL + LOADI 2 local@ BAR_PAGE + LOADI + sbar-set-val
                    ] ?:
                ] ?:
            ] ?:
        ] ?:
    ] ?:
    3 unframe!
;

@sbar-drag ( addr mx my -- changed? )
    3 frame! ( 0:my 1:mx 2:addr )
    2 local@ BAR_PART + LOADI 5 = [
        2 local@ BAR_HORIZ + LOADI [ 1 local@ ] [ 0 local@ ] ?:
        2 local@ BAR_OFF + LOADI -
        2 local@ sbar-origin MAX
        2 local@ sbar-origin 2 local@ sbar-travel + MIN
        2 local@ BAR_POS + STOREI
        2 local@ sbar-sync
    ] [
        0
    ] ?:
    3 unframe!
;

@sbar-release ( addr -- )
    1 frame! ( 0:addr )
    0 0 local@ BAR_DRG + STOREI
    0 0 local@ BAR_PART + STOREI
    0 local@ 0 local@ BAR_VAL + LOADI sbar-pos-from-val
    0 local@ BAR_POS + STOREI
    1 unframe!
;

( System 6 7×4 arrow, centered in an s×s end cap. )
@sbar-tri-up { fd x y s color -- }
    fd
    x s 7 - 2 / + 3 +  y s 4 - 2 / +
    x s 7 - 2 / +      y s 4 - 2 / + 3 +
    x s 7 - 2 / + 6 +  y s 4 - 2 / + 3 +
    color DRAW::paint-tri
;

@sbar-tri-dn { fd x y s color -- }
    fd
    x s 7 - 2 / +      y s 4 - 2 / +
    x s 7 - 2 / + 6 +  y s 4 - 2 / +
    x s 7 - 2 / + 3 +  y s 4 - 2 / + 3 +
    color DRAW::paint-tri
;

@sbar-tri-lt { fd x y s color -- }
    fd
    x s 4 - 2 / +      y s 7 - 2 / + 3 +
    x s 4 - 2 / + 3 +  y s 7 - 2 / +
    x s 4 - 2 / + 3 +  y s 7 - 2 / + 6 +
    color DRAW::paint-tri
;

@sbar-tri-rt { fd x y s color -- }
    fd
    x s 4 - 2 / + 3 +  y s 7 - 2 / + 3 +
    x s 4 - 2 / +      y s 7 - 2 / +
    x s 4 - 2 / +      y s 7 - 2 / + 6 +
    color DRAW::paint-tri
;

@sbar-end ( fd x y w h pressed dir -- )
    7 frame! ( 0:dir 1:pressed 2:h 3:w 4:y 5:x 6:fd )
    1 local@ [
        6 local@ 5 local@ 4 local@ 3 local@ 2 local@ CLR_BORDER DRAW::paint-rect
    ] [
        6 local@ 5 local@ 4 local@ 3 local@ 2 local@ frame-rect
    ] ?:
    6 local@ 5 local@ 4 local@
    3 local@ 2 local@ MIN
    1 local@ [ CLR_BG ] [ CLR_BORDER ] ?:
    0 local@
    dup 0 = [
        drop sbar-tri-up
    ] [
        dup 1 = [
            drop sbar-tri-dn
        ] [
            dup 2 = [
                drop sbar-tri-lt
            ] [
                drop sbar-tri-rt
            ] ?:
        ] ?:
    ] ?:
    7 unframe!
;

@sbar-thumb ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    0 local@ BAR_HORIZ + LOADI [
        1 local@
        0 local@ BAR_POS + LOADI
        0 local@ BAR_Y + LOADI
        0 local@ sbar-thumb-n
        0 local@ BAR_H + LOADI
        frame-rect
    ] [
        1 local@
        0 local@ BAR_X + LOADI
        0 local@ BAR_POS + LOADI
        0 local@ BAR_W + LOADI
        0 local@ sbar-thumb-n
        frame-rect
    ] ?:
    2 unframe!
;

@sbar-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    1 local@ 0 local@ BAR_X + LOADI 0 local@ BAR_Y + LOADI
    0 local@ BAR_W + LOADI 0 local@ BAR_H + LOADI dither-rect
    1 local@ 0 local@ BAR_X + LOADI 0 local@ BAR_Y + LOADI
    0 local@ BAR_W + LOADI 0 local@ BAR_H + LOADI CLR_BORDER DRAW::draw-rect
    0 local@ BAR_HORIZ + LOADI [
        1 local@
        0 local@ BAR_X + LOADI
        0 local@ BAR_Y + LOADI
        0 local@ sbar-arrow
        0 local@ BAR_H + LOADI
        0 local@ BAR_PART + LOADI 1 =
        2
        sbar-end
        1 local@
        0 local@ BAR_X + LOADI 0 local@ BAR_W + LOADI + 0 local@ sbar-arrow -
        0 local@ BAR_Y + LOADI
        0 local@ sbar-arrow
        0 local@ BAR_H + LOADI
        0 local@ BAR_PART + LOADI 2 =
        3
        sbar-end
    ] [
        1 local@
        0 local@ BAR_X + LOADI
        0 local@ BAR_Y + LOADI
        0 local@ BAR_W + LOADI
        0 local@ sbar-arrow
        0 local@ BAR_PART + LOADI 1 =
        0
        sbar-end
        1 local@
        0 local@ BAR_X + LOADI
        0 local@ BAR_Y + LOADI 0 local@ BAR_H + LOADI + 0 local@ sbar-arrow -
        0 local@ BAR_W + LOADI
        0 local@ sbar-arrow
        0 local@ BAR_PART + LOADI 2 =
        1
        sbar-end
    ] ?:
    0 local@ BAR_MAX + LOADI 0 local@ BAR_MIN + LOADI >
    0 local@ sbar-track 0 > AND [
        1 local@ 0 local@ sbar-thumb
    ] ?
    2 unframe!
;

( ===== Listbox ===== )
( Struct (56 bytes): x(4) y(4) w(4) h(4) buf-ptr(4) count(4) selected(4) sb-addr(4) item-h(4) callback(4) was-down(4) dbl-callback(4) last-time(4) last-idx(4) )
@LB_SIZE      56 ;
@LB_X          0 ;
@LB_Y          4 ;
@LB_W          8 ;
@LB_H         12 ;
@LB_BUF       16 ;
@LB_COUNT     20 ;
@LB_SEL       24 ;
@LB_SB        28 ;
@LB_ITEM_H    32 ;
@LB_CALLBACK  36 ;
@LB_WAS_DOWN  40 ;
@LB_DBL_CB    44 ;
@LB_LAST_TIME 48 ;
@LB_LAST_IDX  52 ;

@listbox-init ( addr x y w h buf-ptr count sb-addr item-h callback -- )
    10 frame! ( 0:cb 1:ih 2:sb 3:cnt 4:buf 5:h 6:w 7:y 8:x 9:addr )
    8 local@ 9 local@ LB_X + STOREI
    7 local@ 9 local@ LB_Y + STOREI
    6 local@ 9 local@ LB_W + STOREI
    5 local@ 9 local@ LB_H + STOREI
    4 local@ 9 local@ LB_BUF + STOREI
    3 local@ 9 local@ LB_COUNT + STOREI
    -1       9 local@ LB_SEL + STOREI
    2 local@ 9 local@ LB_SB + STOREI
    1 local@ 9 local@ LB_ITEM_H + STOREI
    0 local@ 9 local@ LB_CALLBACK + STOREI
    0        9 local@ LB_WAS_DOWN + STOREI
    0        9 local@ LB_DBL_CB + STOREI
    0        9 local@ LB_LAST_TIME + STOREI
    -1       9 local@ LB_LAST_IDX + STOREI
    
    ( Initialize scrollbar )
    2 local@ 
    8 local@ 6 local@ + 16 - ( sb_x )
    7 local@ ( sb_y )
    16 ( sb_w )
    5 local@ ( sb_h )
    0 ( min )
    3 local@ 5 local@ 1 local@ / - 0 MAX ( max: count - visible )
    0 ( val )
    16 ( thumb-h )
    scrollbar-init
    10 unframe!
;

@listbox-dbl-callback! ( addr cb -- ) swap LB_DBL_CB + STOREI ;

@listbox-draw ( fd addr -- )
    0 ( i )
    0 ( yi )
    0 local@ LB_SB + LOADI SB_VAL + LOADI ( scroll_val )
    0 local@ LB_X + LOADI 4 + ( curr_x )
    0 local@ LB_Y + LOADI 2 + ( curr_y )
    0 local@ LB_BUF + LOADI ( buf )
    0 local@ LB_COUNT + LOADI ( count )
    9 frame! ( 0:cnt 1:buf 2:y 3:x 4:scroll 5:yi 6:i 7:addr 8:fd )
    
    ( find start of scrolled item )
    [ 4 local@ 0 > ] [
        [ 1 local@ load-byte dup 10 = swap 0 = OR [ 0 ] [ 1 ] ?: ] [ 1 local@ 1 + 1 local! ] |:
        1 local@ load-byte 0 = [ 0 4 local! ] [ 1 local@ 1 + 1 local! 4 local@ 1 - 4 local! ] ?:
    ] |:
    
    ( draw visible items )
    [ 6 local@ 7 local@ LB_H + LOADI 7 local@ LB_ITEM_H + LOADI / < 
      6 local@ 0 local@ < AND ] [
        ( highlight if selected )
        6 local@ 4 local@ + 7 local@ LB_SEL + LOADI = [
            8 local@ 7 local@ LB_X + LOADI 1 + 2 local@ 5 local@ + 7 local@ LB_W + LOADI 17 - 7 local@ LB_ITEM_H + LOADI CLR_PRESS DRAW::fill-rect
        ] ?
        
        ( find end of line )
        1 local@ 0 ( slen )
        [ OVER OVER + load-byte dup 10 = swap 0 = OR 0 = ] [
            1 +
        ] |:
        ( sptr slen )
        
        ( draw string )
        8 local@ 3 local@ 2 local@ 5 local@ + 
        3 PICK 2 PICK
        6 local@ 4 local@ + 7 local@ LB_SEL + LOADI = [ CLR_BG ] [ CLR_TEXT ] ?: 1 DRAW::draw-str-n
        
        ( next line )
        ( sptr slen )
        + 1 + 1 local! ( sptr += slen + 1 )
        5 local@ 7 local@ LB_ITEM_H + LOADI + 5 local! ( yi += LB_ITEM_H )
        6 local@ 1 + 6 local! ( i++ )
    ] |:
    
    ( scrollbar )
    8 local@ 7 local@ LB_SB + LOADI scrollbar-draw
    9 unframe!
;

@listbox-update ( addr mx my btn -- )
    4 frame! ( 0:btn 1:my 2:mx 3:addr )
    ( scrollbar update )
    3 local@ LB_SB + LOADI 2 local@ 1 local@ 0 local@ scrollbar-update drop
    
    ( item selection )
    0 local@ 1 = [
        2 local@ 1 local@
        3 local@ LB_X + LOADI
        3 local@ LB_Y + LOADI
        3 local@ LB_W + LOADI 16 -
        3 local@ LB_H + LOADI
        in-rect? [
            ( calculate clicked index )
            1 local@ 3 local@ LB_Y + LOADI - 3 local@ LB_ITEM_H + LOADI /
            3 local@ LB_SB + LOADI SB_VAL + LOADI +
            dup 3 local@ LB_COUNT + LOADI < [
                ( Check for double click )
                TIME::milli@ ( current time )
                OVER 3 local@ LB_LAST_IDX + LOADI = [
                    dup 3 local@ LB_LAST_TIME + LOADI - 500 < [
                        ( DOUBLE CLICK! )
                        3 local@ LB_DBL_CB + LOADI dup 0 > [ CALL ] [ drop ] ?:
                    ] ?
                ] ?
                3 local@ LB_LAST_TIME + STOREI
                3 local@ LB_LAST_IDX + STOREI

                3 local@ LB_SEL + STOREI
                ( callback )
                3 local@ LB_CALLBACK + LOADI dup 0 > [ CALL ] [ drop ] ?:
            ] [ drop ] ?:
        ] ?
    ] ?
    4 unframe!
;

@listbox-update-data ( addr buf-ptr count -- )
    3 frame! ( 0:cnt 1:buf 2:addr )
    1 local@ 2 local@ LB_BUF + STOREI
    0 local@ 2 local@ LB_COUNT + STOREI
    -1 2 local@ LB_SEL + STOREI
    
    ( Update scrollbar max )
    2 local@ LB_SB + LOADI 
    dup SB_X + LOADI ( sb_addr x )
    over SB_Y + LOADI ( x y )
    2 PICK SB_W + LOADI ( x y w )
    3 PICK SB_H + LOADI ( x y w h )
    0 ( min )
    0 local@ 4 local@ LB_H + LOADI 4 local@ LB_ITEM_H + LOADI / - 0 MAX ( max )
    0 ( val )
    16 ( thumb-h )
    scrollbar-init
    3 unframe!
;

( ===== Controlset — named Inferno-style controls, stack-word API ===== )

FIELDS CTL name kind flags minx miny maxx maxy state value vmin vmax group label on-press on-change payload next ;

@K_BUTTON    1 ;
@K_CHECKBOX  2 ;
@K_RADIO     3 ;
@K_SLIDER    4 ;
@K_SCROLLBAR 5 ;
@K_FIELD     6 ;
@K_LABEL     7 ;
@K_LIST      8 ;
@K_WINDOW    9 ;
@K_MENUBAR  10 ;
@K_MENU     11 ;
@K_MENUITEM 12 ;
@K_GROUPBOX 13 ;

@F_VISIBLE 1 ;
@F_FOCUS   2 ;
@F_TITLE   4 ;
@F_DEFAULT 8 ;
@F_HIDDEN  16 ;

@EV_PRESS   1 ;
@EV_CHECK   2 ;
@EV_UNCHECK 3 ;
@EV_VALUE   4 ;
@EV_SELECT  5 ;
@EV_CLOSE   6 ;
@EV_DRAG    7 ;

@CS_HEAD  0x8E0010 ;
@CS_FOCUS 0x8E0014 ;
@CS_ENAME 0x8E0018 ;
@CS_EKIND 0x8E001C ;
@CS_DRAG  0x8E0020 ;

@TITLE_H 18 ;
@WIN_BORDER 1 ;
@CLOSE_SZ 11 ;
@CLOSE_INSET 8 ;
@CLOSE_Y 3 ;

@reset ( -- )
    0 CS_HEAD STOREI
    0 CS_FOCUS STOREI
    0 CS_ENAME STOREI
    0 CS_EKIND STOREI
    0 CS_DRAG STOREI
;

@ctlnew ( -- )
    MEM::reset
    reset
;

( ===== Components ===== )
( One table. Every kind has text, x y w h, and a handler quotation. )
( feed posts to the ring; handle runs handlers after feed returns. )
@Q_BASE  0x8E1000 ;
@Q_MAX   8 ;
@Q_HEAD  0x8E0F00 ;
@Q_TAIL  0x8E0F04 ;
@Q_CNT   0x8E0F08 ;

@CB_SLAB 0x8E1600 ;
@CB_N    0x8E0F0C ;
@CB_MAX  8 ;

@RD_SLAB 0x8E1800 ;
@RD_N    0x8E0F10 ;
@RD_MAX  8 ;

@SL_SLAB  0x8E1A00 ;
@SL_N     0x8E0F14 ;
@SL_DRAG  0x8E0F18 ;
@SL_MAXN  8 ;

@BN_SLAB  0x8E1D00 ;
@BN_N     0x8E0F24 ;
@BN_DRAG  0x8E0F28 ;
@BN_MAX   16 ;

@SBAR_SLAB 0x8E2800 ;
@SBAR_N    0x8E0F48 ;
@SBAR_DRAG 0x8E0F4C ;
@SBAR_MAXN 8 ;

@MB_N      0x8E0F50 ;
@MN_N      0x8E0F50 ;
@MI_N      0x8E0F54 ;
@MB_CUR    0x8E0F58 ;
@MB_ACTIVE 0x8E0F5C ;
@MB_HOVER  0x8E0F60 ;
@MB_W      0x8E0F64 ;
@MB_HAS    0x8E0F68 ;
@CH_N      0x8E0F6C ;
@CH_SLAB   0x8E1F40 ;
@CH_MAX    8 ;
@CH_SIZE   20 ;
@CH_X       0 ;
@CH_Y       4 ;
@CH_W       8 ;
@CH_H      12 ;
@CH_TEXT   16 ;
@MN_SLAB   0x8E2A00 ;
@MI_SLAB   0x8E2C00 ;
@MN_MAX    8 ;
@MI_MAX    32 ;
@MN_SIZE   20 ;
@MN_X       0 ;
@MN_W       4 ;
@MN_FIRST   8 ;
@MN_COUNT  12 ;
@MN_TEXT   16 ;
@MI_SIZE   16 ;
@MI_MENU    0 ;
@MI_KIND    4 ;
@MI_CHK     8 ;
@MI_ROW    12 ;

@COMP_TAB 0x8E2000 ;
@COMP_N   0x8E0F2C ;
@COMP_MAX 32 ;
@C_SIZE   24 ;
@C_TEXT    0 ;
@C_KIND    4 ;
@C_HAND    8 ;
@C_PAY    12 ;
@C_GRP    16 ;
@C_FLG    20 ;

@new ( -- )
    0 Q_HEAD STOREI
    0 Q_TAIL STOREI
    0 Q_CNT STOREI
    0 CB_N STOREI
    0 RD_N STOREI
    0 SL_N STOREI
    0 SL_DRAG STOREI
    0 BN_N STOREI
    0 BN_DRAG STOREI
    0 SBAR_N STOREI
    0 SBAR_DRAG STOREI
    0 COMP_N STOREI
    0 MB_N STOREI
    0 MI_N STOREI
    -1 MB_CUR STOREI
    -1 MB_ACTIVE STOREI
    -1 MB_HOVER STOREI
    0 MB_W STOREI
    0 MB_HAS STOREI
    0 CH_N STOREI
;

@uinnew ( -- ) new ;

@post ( name ev val -- )
    3 frame! ( 0:val 1:ev 2:name )
    Q_CNT LOADI Q_MAX = [
        Q_TAIL LOADI 1 + Q_MAX MOD Q_TAIL STOREI
        Q_CNT LOADI 1 - Q_CNT STOREI
    ] ?
    Q_BASE Q_HEAD LOADI 12 * +
    2 local@ OVER STOREI
    1 local@ OVER 4 + STOREI
    0 local@ SWAP 8 + STOREI
    Q_HEAD LOADI 1 + Q_MAX MOD Q_HEAD STOREI
    Q_CNT LOADI 1 + Q_CNT STOREI
    3 unframe!
;

( empty: 0.  message: name ev val 1 )
@poll ( -- 0 | name ev val 1 )
    Q_CNT LOADI 0 = [
        0
    ] [
        Q_BASE Q_TAIL LOADI 12 * +
        dup LOADI SWAP
        dup 4 + LOADI SWAP
        8 + LOADI
        Q_TAIL LOADI 1 + Q_MAX MOD Q_TAIL STOREI
        Q_CNT LOADI 1 - Q_CNT STOREI
        1
    ] ?:
;

@comp-at ( i -- row ) C_SIZE * COMP_TAB + ;

@comp-put ( text kind handler payload group flags -- )
    6 frame! ( 0:flags 1:group 2:payload 3:handler 4:kind 5:text )
    COMP_N LOADI COMP_MAX < [
        COMP_N LOADI comp-at
        5 local@ OVER C_TEXT + STOREI
        4 local@ OVER C_KIND + STOREI
        3 local@ OVER C_HAND + STOREI
        2 local@ OVER C_PAY  + STOREI
        1 local@ OVER C_GRP  + STOREI
        0 local@ SWAP C_FLG  + STOREI
        COMP_N LOADI 1 + COMP_N STOREI
    ] ?
    6 unframe!
;

@comp-find ( name -- row | 0 )
    0 SWAP 2 frame! ( 0:name 1:row )
    0 1 local!
    0
    [ dup COMP_N LOADI < ] [
        dup comp-at
        dup C_TEXT + LOADI 0 local@ STR::streq [
            1 local!
            drop
            COMP_N LOADI
        ] [
            drop
            1 +
        ] ?:
    ] |:
    drop
    1 local@
    2 unframe!
;

@rd-clear-group ( group except -- )
    2 frame! ( 0:except 1:group )
    0
    [ dup COMP_N LOADI < ] [
        dup comp-at
        dup C_KIND + LOADI K_RADIO = [
            dup C_GRP + LOADI 1 local@ STR::streq [
                dup C_PAY + LOADI 0 local@ = 0 = [
                    C_PAY + LOADI 0 SWAP CB_CHK + STOREI
                ] [
                    drop
                ] ?:
            ] [
                drop
            ] ?:
        ] [
            drop
        ] ?:
        1 +
    ] |:
    drop
    2 unframe!
;

@rd-pick ( name -- )
    1 frame! ( 0:name )
    0 local@ comp-find dup 0 = [
        drop
    ] [
        dup C_GRP + LOADI
        OVER C_PAY + LOADI
        rd-clear-group
        C_PAY + LOADI
        1 SWAP CB_CHK + STOREI
    ] ?:
    1 unframe!
;

@sl-post ( row -- )
    dup C_TEXT + LOADI
    EV_VALUE
    ROT C_PAY + LOADI SL_VAL + LOADI
    post
;

@sbar-post ( row -- )
    dup C_TEXT + LOADI
    EV_VALUE
    ROT C_PAY + LOADI BAR_VAL + LOADI
    post
;

@bn-post ( row -- )
    C_TEXT + LOADI EV_PRESS 1 post
;

@default ( text -- )
    1 frame! ( 0:text )
    0
    [ dup COMP_N LOADI < ] [
        dup comp-at
        dup C_KIND + LOADI K_BUTTON = [
            dup C_TEXT + LOADI 0 local@ STR::streq [
                1 OVER C_FLG + STOREI
                C_PAY + LOADI 1 SWAP BTN_DEFAULT + STOREI
            ] [
                0 OVER C_FLG + STOREI
                C_PAY + LOADI 0 SWAP BTN_DEFAULT + STOREI
            ] ?:
        ] [
            drop
        ] ?:
        1 +
    ] |:
    drop
    1 unframe!
;

@bn-default ( name -- ) default ;

@enter ( -- posted? )
    0 1 frame! ( 0:posted )
    0
    [ dup COMP_N LOADI < ] [
        dup comp-at
        dup C_KIND + LOADI K_BUTTON = [
            dup C_FLG + LOADI [
                bn-post
                1 0 local!
                COMP_N LOADI
            ] [
                drop
                1 +
            ] ?:
        ] [
            drop
            1 +
        ] ?:
    ] |:
    drop
    0 local@
    1 unframe!
;

@bn-return ( -- posted? ) enter ;

@mn-at ( i -- rec ) MN_SIZE * MN_SLAB + ;
@mi-at ( i -- rec ) MI_SIZE * MI_SLAB + ;

@menu-open? ( -- f ) MB_ACTIVE LOADI -1 > ;

@mb-close ( -- )
    -1 MB_ACTIVE STOREI
    -1 MB_HOVER STOREI
    0 APP_MODAL STOREI
;

@mb-open ( idx -- )
    MB_ACTIVE STOREI
    -1 MB_HOVER STOREI
    1 APP_MODAL STOREI
;

@escape ( -- closed? )
    MB_ACTIVE LOADI -1 > [
        mb-close
        1
    ] [
        0
    ] ?:
;

@mb-drop-w ( tidx -- w )
    0 0 0 4 frame! ( 0:end 1:i 2:best 3:tidx )
    MENU_MIN_IW 2 local!
    3 local@ mn-at MN_FIRST + LOADI 1 local!
    1 local@ 3 local@ mn-at MN_COUNT + LOADI + 0 local!
    [ 1 local@ 0 local@ < ] [
        1 local@ mi-at MI_ROW + LOADI C_TEXT + LOADI
        DRAW::str-w MENU_MARK + 16 +
        2 local@ MAX 2 local!
        1 local@ 1 + 1 local!
    ] |:
    2 local@
    4 unframe!
;

@mb-hit-title ( mx my -- idx|-1 )
    -1 0 4 frame! ( 0:i 1:found 2:my 3:mx )
    2 local@ 0 >=
    2 local@ MENU_H < AND [
        [ 0 local@ MN_N LOADI < 1 local@ -1 = AND ] [
            3 local@ 2 local@
            0 local@ mn-at MN_X + LOADI
            0
            0 local@ mn-at MN_W + LOADI
            MENU_H
            in-rect? [
                0 local@ 1 local!
            ] ?
            0 local@ 1 + 0 local!
        ] |:
    ] ?
    1 local@
    4 unframe!
;

@mb-in-drop? ( mx my -- f )
    2 frame! ( 0:my 1:mx )
    MB_ACTIVE LOADI -1 > [
        1 local@ 0 local@
        MB_ACTIVE LOADI mn-at MN_X + LOADI
        MENU_H
        MB_ACTIVE LOADI mb-drop-w
        MB_ACTIVE LOADI mn-at MN_COUNT + LOADI ITEM_H *
        in-rect?
    ] [
        0
    ] ?:
    2 unframe!
;

@mb-hit-item ( mx my -- mi-idx|-1 )
    2 frame! ( 0:my 1:mx )
    1 local@ 0 local@ mb-in-drop? [
        0 local@ MENU_H - ITEM_H /
        dup 0 < [
            drop -1
        ] [
            dup MB_ACTIVE LOADI mn-at MN_COUNT + LOADI >= [
                drop -1
            ] [
                MB_ACTIVE LOADI mn-at MN_FIRST + LOADI +
            ] ?:
        ] ?:
    ] [
        -1
    ] ?:
    2 unframe!
;

@mi-clear-group ( group except-row -- )
    2 frame! ( 0:except 1:group )
    0
    [ dup COMP_N LOADI < ] [
        dup comp-at
        dup C_KIND + LOADI K_MENUITEM = [
            dup C_FLG + LOADI MI_RADIO = [
                dup C_GRP + LOADI 1 local@ STR::streq [
                    dup 0 local@ = 0 = [
                        C_PAY + LOADI 0 SWAP MI_CHK + STOREI
                    ] [
                        drop
                    ] ?:
                ] [
                    drop
                ] ?:
            ] [
                drop
            ] ?:
        ] [
            drop
        ] ?:
        1 +
    ] |:
    drop
    2 unframe!
;

@mb-apply ( item-idx -- )
    1 frame! ( 0:idx )
    0 local@ mi-at MI_KIND + LOADI
    dup MI_SEP = [
        drop
    ] [
        dup MI_CMD = [
            drop
            0 local@ mi-at MI_ROW + LOADI C_TEXT + LOADI
            EV_PRESS 1 post
            mb-close
        ] [
            dup MI_CHECK = [
                drop
                0 local@ mi-at MI_CHK + LOADI 0 = [ 1 ] [ 0 ] ?:
                dup 0 local@ mi-at MI_CHK + STOREI
                0 local@ mi-at MI_ROW + LOADI C_TEXT + LOADI
                SWAP
                dup 0 = [ EV_UNCHECK ] [ EV_CHECK ] ?:
                SWAP
                post
                mb-close
            ] [
                drop
                0 local@ mi-at MI_CHK + LOADI [
                    mb-close
                ] [
                    0 local@ mi-at MI_ROW + LOADI
                    dup C_GRP + LOADI
                    OVER
                    mi-clear-group
                    1 0 local@ mi-at MI_CHK + STOREI
                    0 local@ mi-at MI_ROW + LOADI C_TEXT + LOADI
                    EV_SELECT 1 post
                    mb-close
                ] ?:
            ] ?:
        ] ?:
    ] ?:
    1 unframe!
;

@mb-down-open ( mx my -- )
    2 frame! ( 0:my 1:mx )
    1 local@ 0 local@ mb-hit-title
    dup -1 > [
        MB_ACTIVE LOADI = [
            mb-close
        ] [
            1 local@ 0 local@ mb-hit-title mb-open
        ] ?:
    ] [
        drop
        1 local@ 0 local@ mb-in-drop? [
            1 local@ 0 local@ mb-hit-item
            dup -1 > [
                dup mi-at MI_KIND + LOADI MI_SEP = [
                    drop
                ] [
                    mb-apply
                ] ?:
            ] [
                drop
            ] ?:
        ] [
            mb-close
        ] ?:
    ] ?:
    2 unframe!
;

@mb-move-open ( mx my -- )
    2 frame! ( 0:my 1:mx )
    1 local@ 0 local@ mb-hit-title
    dup -1 > [
        dup MB_ACTIVE LOADI = [
            drop
        ] [
            mb-open
        ] ?:
    ] [
        drop
        1 local@ 0 local@ mb-in-drop? [
            1 local@ 0 local@ mb-hit-item
            dup -1 > [
                dup mi-at MI_KIND + LOADI MI_SEP = [
                    drop
                    -1 MB_HOVER STOREI
                ] [
                    MB_ACTIVE LOADI mn-at MN_FIRST + LOADI -
                    MB_HOVER STOREI
                ] ?:
            ] [
                drop
                -1 MB_HOVER STOREI
            ] ?:
        ] [
            -1 MB_HOVER STOREI
        ] ?:
    ] ?:
    2 unframe!
;

@mb-feed-open ( mpkt -- )
    1 frame! ( 0:mpkt )
    0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
        0 local@ EVENT::mouse-x 0 local@ EVENT::mouse-y mb-down-open
    ] [
        0 local@ EVENT::mouse-type EVENT::MOUSE_MOVE = [
            0 local@ EVENT::mouse-x 0 local@ EVENT::mouse-y mb-move-open
        ] ?
    ] ?:
    1 unframe!
;

@mb-str ( fd x y ptr color -- )
    16 DRAW::draw-str
;

@mb-draw-bar ( -- )
    DRAW::fd 0 0 MB_W LOADI MENU_H CLR_BG DRAW::fill-rect
    DRAW::fd 0 MENU_H 1 - MB_W LOADI 1 CLR_BORDER DRAW::fill-rect
    0 1 frame! ( 0:i )
    0 0 local!
    [ 0 local@ MN_N LOADI < ] [
        0 local@ MB_ACTIVE LOADI = [
            DRAW::fd
            0 local@ mn-at MN_X + LOADI
            0
            0 local@ mn-at MN_W + LOADI
            MENU_H
            CLR_BORDER DRAW::fill-rect
        ] ?
        DRAW::fd
        0 local@ mn-at MN_X + LOADI MENU_PAD +
        MENU_H 2 / 7 -
        0 local@ mn-at MN_TEXT + LOADI
        0 local@ MB_ACTIVE LOADI = [ CLR_BG ] [ CLR_TEXT ] ?:
        mb-str
        0 local@ 1 + 0 local!
    ] |:
    1 unframe!
;

@mb-draw-drop ( -- )
    MB_ACTIVE LOADI -1 > [
        0 0 0 0 0 0 6 frame! ( 0:x 1:y 2:w 3:i 4:iy 5:color )
        MB_ACTIVE LOADI mn-at MN_X + LOADI 0 local!
        MENU_H 1 local!
        MB_ACTIVE LOADI mb-drop-w 2 local!
        DRAW::fd 0 local@ 1 local@ 2 local@
        MB_ACTIVE LOADI mn-at MN_COUNT + LOADI ITEM_H *
        CLR_BG draw-border-rect
        0 3 local!
        [ 3 local@ MB_ACTIVE LOADI mn-at MN_COUNT + LOADI < ] [
            1 local@ 3 local@ ITEM_H * + 4 local!
            MB_ACTIVE LOADI mn-at MN_FIRST + LOADI 3 local@ +
            mi-at
            dup MI_KIND + LOADI MI_SEP = [
                drop
                DRAW::fd 0 local@ 2 + 4 local@ ITEM_H 2 / + 2 local@ 4 - CLR_BORDER DRAW::dash-h
            ] [
                3 local@ MB_HOVER LOADI = [
                    DRAW::fd 0 local@ 4 local@ 2 local@ ITEM_H CLR_BORDER DRAW::fill-rect
                    CLR_BG
                ] [
                    CLR_TEXT
                ] ?:
                5 local!
                dup MI_CHK + LOADI [
                    DRAW::fd
                    0 local@ 8 +
                    4 local@ ITEM_H 12 - 2 / +
                    5 local@ DRAW::check-mark
                ] ?
                MI_ROW + LOADI C_TEXT + LOADI
                DRAW::fd SWAP
                0 local@ MENU_MARK + SWAP
                4 local@ ITEM_H 2 / 7 - + SWAP
                5 local@ mb-str
            ] ?:
            3 local@ 1 + 3 local!
        ] |:
        6 unframe!
    ] ?
;

@menubar ( w -- )
    MB_W STOREI
    MB_HAS LOADI [
    ] [
        COMP_N LOADI COMP_MAX < [
            T"menubar" K_MENUBAR 0 0 0 0 comp-put
            1 MB_HAS STOREI
        ] ?
    ] ?:
;

@menu ( title -- )
    1 frame! ( 0:title )
    MN_N LOADI MN_MAX < COMP_N LOADI COMP_MAX < AND [
        MN_N LOADI mn-at
        MN_N LOADI 0 = [
            MENU_PAD
        ] [
            MN_N LOADI 1 - mn-at
            dup MN_X + LOADI SWAP MN_W + LOADI +
        ] ?:
        OVER MN_X + STOREI
        0 local@ DRAW::str-w 20 +
        dup MENU_MIN_TW < [ drop MENU_MIN_TW ] ?
        OVER MN_W + STOREI
        MI_N LOADI OVER MN_FIRST + STOREI
        0 OVER MN_COUNT + STOREI
        0 local@ OVER MN_TEXT + STOREI
        drop
        MN_N LOADI MB_CUR STOREI
        0 local@ K_MENU 0 MN_N LOADI mn-at 0 0 comp-put
        MN_N LOADI 1 + MN_N STOREI
    ] ?
    1 unframe!
;

@item-add ( text handler kind group -- )
    4 frame! ( 0:group 1:kind 2:handler 3:text )
    MB_CUR LOADI 0 >=
    MI_N LOADI MI_MAX < AND
    COMP_N LOADI COMP_MAX < AND [
        MB_CUR LOADI MI_N LOADI mi-at MI_MENU + STOREI
        1 local@ MI_N LOADI mi-at MI_KIND + STOREI
        0 MI_N LOADI mi-at MI_CHK + STOREI
        3 local@ K_MENUITEM 2 local@ MI_N LOADI mi-at 0 local@ 1 local@ comp-put
        COMP_N LOADI 1 - comp-at MI_N LOADI mi-at MI_ROW + STOREI
        MB_CUR LOADI mn-at MN_COUNT +
        dup LOADI 1 + SWAP STOREI
        MI_N LOADI 1 + MI_N STOREI
    ] ?
    4 unframe!
;

@item ( text handler -- )
    MI_CMD 0 item-add
;

@check-item ( text handler -- )
    MI_CHECK 0 item-add
;

@radio-item ( text group handler -- )
    3 frame! ( 0:handler 1:group 2:text )
    2 local@ 0 local@ MI_RADIO 1 local@ item-add
    3 unframe!
;

@sep ( -- )
    T"-" 0 MI_SEP 0 item-add
;

@item-set ( name val -- )
    2 frame! ( 0:val 1:name )
    0
    [ dup COMP_N LOADI < ] [
        dup comp-at
        dup C_KIND + LOADI K_MENUITEM = [
            dup C_TEXT + LOADI 1 local@ STR::streq [
                0 local@ OVER C_PAY + LOADI MI_CHK + STOREI
                dup C_FLG + LOADI MI_RADIO = [
                    0 local@ [
                        dup C_GRP + LOADI OVER mi-clear-group
                        1 SWAP C_PAY + LOADI MI_CHK + STOREI
                    ] [
                        drop
                    ] ?:
                ] [
                    drop
                ] ?:
                drop
                COMP_N LOADI
            ] [
                drop
                1 +
            ] ?:
        ] [
            drop
            1 +
        ] ?:
    ] |:
    drop
    2 unframe!
;

@item@ ( name -- 0|1 )
    1 frame! ( 0:name )
    0 local@ comp-find
    dup 0 = [
        drop 0
    ] [
        dup C_KIND + LOADI K_MENUITEM = [
            C_PAY + LOADI MI_CHK + LOADI
        ] [
            drop 0
        ] ?:
    ] ?:
    1 unframe!
;

@button ( text x y w h handler -- )
    6 frame! ( 0:handler 1:h 2:w 3:y 4:x 5:text )
    BN_N LOADI BN_MAX < COMP_N LOADI COMP_MAX < AND [
        BN_SLAB BN_N LOADI BTN_SIZE * +
        dup 4 local@ 3 local@ 2 local@ 1 local@ 5 local@ 0 button-init
        5 local@ SWAP K_BUTTON SWAP 0 local@ SWAP 0 0 comp-put
        BN_N LOADI 1 + BN_N STOREI
    ] ?
    6 unframe!
;

@checkbox ( text x y w h handler -- )
    6 frame! ( 0:handler 1:h 2:w 3:y 4:x 5:text )
    CB_N LOADI CB_MAX < COMP_N LOADI COMP_MAX < AND [
        CB_SLAB CB_N LOADI CB_SIZE * +
        dup 4 local@ 3 local@ 1 local@ 5 local@ checkbox-init
        5 local@ SWAP K_CHECKBOX SWAP 0 local@ SWAP 0 0 comp-put
        CB_N LOADI 1 + CB_N STOREI
    ] ?
    6 unframe!
;

@radio ( text x y w h group handler -- )
    7 frame! ( 0:handler 1:group 2:h 3:w 4:y 5:x 6:text )
    RD_N LOADI RD_MAX < COMP_N LOADI COMP_MAX < AND [
        RD_SLAB RD_N LOADI CB_SIZE * +
        dup 5 local@ 4 local@ 2 local@ 6 local@ checkbox-init
        6 local@ SWAP K_RADIO SWAP 0 local@ SWAP 1 local@ 0 comp-put
        RD_N LOADI 1 + RD_N STOREI
    ] ?
    7 unframe!
;

@slider ( text x y w h min max val handler -- )
    9 frame! ( 0:handler 1:val 2:max 3:min 4:h 5:w 6:y 7:x 8:text )
    SL_N LOADI SL_MAXN < COMP_N LOADI COMP_MAX < AND [
        SL_SLAB SL_N LOADI SL_SIZE * +
        dup 7 local@ 6 local@ 5 local@ 4 local@ 3 local@ 2 local@ 1 local@ slider-init
        8 local@ SWAP K_SLIDER SWAP 0 local@ SWAP 0 0 comp-put
        SL_N LOADI 1 + SL_N STOREI
    ] ?
    9 unframe!
;

@vscroll ( text x y w h min max val handler -- )
    9 frame! ( 0:handler 1:val 2:max 3:min 4:h 5:w 6:y 7:x 8:text )
    SBAR_N LOADI SBAR_MAXN < COMP_N LOADI COMP_MAX < AND [
        SBAR_SLAB SBAR_N LOADI BAR_SIZE * +
        dup 7 local@ 6 local@ 5 local@ 4 local@ 3 local@ 2 local@ 1 local@ 0 sbar-init
        8 local@ SWAP K_SCROLLBAR SWAP 0 local@ SWAP 0 0 comp-put
        SBAR_N LOADI 1 + SBAR_N STOREI
    ] ?
    9 unframe!
;

@hscroll ( text x y w h min max val handler -- )
    9 frame! ( 0:handler 1:val 2:max 3:min 4:h 5:w 6:y 7:x 8:text )
    SBAR_N LOADI SBAR_MAXN < COMP_N LOADI COMP_MAX < AND [
        SBAR_SLAB SBAR_N LOADI BAR_SIZE * +
        dup 7 local@ 6 local@ 5 local@ 4 local@ 3 local@ 2 local@ 1 local@ 1 sbar-init
        8 local@ SWAP K_SCROLLBAR SWAP 0 local@ SWAP 0 0 comp-put
        SBAR_N LOADI 1 + SBAR_N STOREI
    ] ?
    9 unframe!
;

@ch-init ( addr x y w h text -- )
    6 frame! ( 0:text 1:h 2:w 3:y 4:x 5:addr )
    4 local@ 5 local@ CH_X + STOREI
    3 local@ 5 local@ CH_Y + STOREI
    2 local@ 5 local@ CH_W + STOREI
    1 local@ 5 local@ CH_H + STOREI
    0 local@ 5 local@ CH_TEXT + STOREI
    6 unframe!
;

( Labeled FrameRect. (x,y,w,h) is the frame; title sits on the top edge. )
@groupbox-draw { fd addr -- }
    fd addr CH_X + LOADI addr CH_Y + LOADI addr CH_W + LOADI addr CH_H + LOADI CLR_BORDER DRAW::frame-rect
    addr CH_TEXT + LOADI dup 0 > [
        { ptr }
            ptr DRAW::str-w 8 + { tw }
                fd addr CH_X + LOADI 6 + addr CH_Y + LOADI 5 - tw 10 CLR_BG DRAW::paint-rect
                fd addr CH_X + LOADI 10 + addr CH_Y + LOADI 6 - ptr CLR_TEXT 1 DRAW::draw-str
            }
        }
    ] [ drop ] ?:
;

@label-draw ( fd addr -- )
    2 frame! ( 0:addr 1:fd )
    1 local@
    0 local@ CH_X + LOADI
    0 local@ CH_Y + LOADI
    0 local@ CH_TEXT + LOADI
    CLR_TEXT 1 DRAW::draw-str
    2 unframe!
;

@groupbox ( text x y w h -- )
    5 frame! ( 0:h 1:w 2:y 3:x 4:text )
    CH_N LOADI CH_MAX < COMP_N LOADI COMP_MAX < AND [
        CH_SLAB CH_N LOADI CH_SIZE * +
        dup 3 local@ 2 local@ 1 local@ 0 local@ 4 local@ ch-init
        4 local@ SWAP K_GROUPBOX SWAP 0 SWAP 0 0 comp-put
        CH_N LOADI 1 + CH_N STOREI
    ] ?
    5 unframe!
;

@label ( text x y -- )
    3 frame! ( 0:y 1:x 2:text )
    CH_N LOADI CH_MAX < COMP_N LOADI COMP_MAX < AND [
        CH_SLAB CH_N LOADI CH_SIZE * +
        dup 1 local@ 0 local@ 0 0 2 local@ ch-init
        2 local@ SWAP K_LABEL SWAP 0 SWAP 0 0 comp-put
        CH_N LOADI 1 + CH_N STOREI
    ] ?
    3 unframe!
;

@cb-add ( name x y size label -- )
    5 frame! ( 0:label 1:size 2:y 3:x 4:name )
    0 local@ 3 local@ 2 local@ 1 local@ 1 local@ 0 checkbox
    4 local@ 0 local@ STR::streq 0 = [
        COMP_N LOADI 0 > [
            COMP_N LOADI 1 - comp-at
            4 local@ SWAP C_TEXT + STOREI
        ] ?
    ] ?
    5 unframe!
;

@rd-add ( name group x y size label -- )
    6 frame! ( 0:label 1:size 2:y 3:x 4:group 5:name )
    0 local@ 3 local@ 2 local@ 1 local@ 1 local@ 4 local@ 0 radio
    5 local@ 0 local@ STR::streq 0 = [
        COMP_N LOADI 0 > [
            COMP_N LOADI 1 - comp-at
            5 local@ SWAP C_TEXT + STOREI
        ] ?
    ] ?
    6 unframe!
;

@sl-add ( name x y w h min max val -- )
    8 frame! ( 0:val 1:max 2:min 3:h 4:w 5:y 6:x 7:name )
    7 local@ 6 local@ 5 local@ 4 local@ 3 local@ 2 local@ 1 local@ 0 local@ 0 slider
    8 unframe!
;

@bn-add ( name x y w h label -- )
    6 frame! ( 0:label 1:h 2:w 3:y 4:x 5:name )
    0 local@ 4 local@ 3 local@ 2 local@ 1 local@ 0 button
    5 local@ 0 local@ STR::streq 0 = [
        COMP_N LOADI 0 > [
            COMP_N LOADI 1 - comp-at
            5 local@ SWAP C_TEXT + STOREI
        ] ?
    ] ?
    6 unframe!
;

@draw ( -- )
    0
    [ dup COMP_N LOADI < ] [
        dup comp-at
        DRAW::fd
        OVER C_PAY + LOADI
        ROT C_KIND + LOADI
        dup K_BUTTON = [
            drop button-draw
        ] [
        dup K_CHECKBOX = [
            drop checkbox-draw
        ] [
        dup K_RADIO = [
            drop radio-draw
        ] [
        dup K_SLIDER = [
            drop slider-draw
        ] [
        dup K_SCROLLBAR = [
            drop sbar-draw
        ] [
        dup K_MENUBAR = [
            drop drop drop
            mb-draw-bar
        ] [
        dup K_GROUPBOX = [
            drop groupbox-draw
        ] [
        dup K_LABEL = [
            drop label-draw
        ] [
            drop drop drop
        ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
        1 +
    ] |:
    drop
    mb-draw-drop
;

@cb-draw ( -- ) draw ;
@rd-draw ( -- ) draw ;
@sl-draw ( -- ) draw ;
@bn-draw ( -- ) draw ;

@handle ( -- )
    [ poll ]
    [
        3 frame! ( 0:val 1:ev 2:name )
        2 local@ comp-find
        dup 0 = [
            drop
        ] [
            C_HAND + LOADI
            dup 0 > [
                0 local@ SWAP CALL
            ] [
                drop
            ] ?:
        ] ?:
        3 unframe!
    ] |:
;

( Overlay component table — modal menus. Does not touch the app table. )
@OV_TAB   0x8E2400 ;
@OV_SLAB  0x8E2600 ;
@OV_Q     0x8E2500 ;
@OV_N     0x8E0F30 ;
@OV_BNN   0x8E0F34 ;
@OV_DRAG  0x8E0F38 ;
@OV_QH    0x8E0F3C ;
@OV_QT    0x8E0F40 ;
@OV_QC    0x8E0F44 ;
@OV_MAX   8 ;

@ov-at ( i -- row ) C_SIZE * OV_TAB + ;

@ov-put ( text kind handler payload group flags -- )
    6 frame! ( 0:flags 1:group 2:payload 3:handler 4:kind 5:text )
    OV_N LOADI OV_MAX < [
        OV_N LOADI ov-at
        5 local@ OVER C_TEXT + STOREI
        4 local@ OVER C_KIND + STOREI
        3 local@ OVER C_HAND + STOREI
        2 local@ OVER C_PAY  + STOREI
        1 local@ OVER C_GRP  + STOREI
        0 local@ SWAP C_FLG  + STOREI
        OV_N LOADI 1 + OV_N STOREI
    ] ?
    6 unframe!
;

@ov-find ( name -- row | 0 )
    0 SWAP 2 frame! ( 0:name 1:row )
    0 1 local!
    0
    [ dup OV_N LOADI < ] [
        dup ov-at
        dup C_TEXT + LOADI 0 local@ STR::streq [
            1 local!
            drop
            OV_N LOADI
        ] [
            drop
            1 +
        ] ?:
    ] |:
    drop
    1 local@
    2 unframe!
;

@ov-post ( name ev val -- )
    3 frame! ( 0:val 1:ev 2:name )
    OV_QC LOADI Q_MAX = [
        OV_QT LOADI 1 + Q_MAX MOD OV_QT STOREI
        OV_QC LOADI 1 - OV_QC STOREI
    ] ?
    OV_Q OV_QH LOADI 12 * +
    2 local@ OVER STOREI
    1 local@ OVER 4 + STOREI
    0 local@ SWAP 8 + STOREI
    OV_QH LOADI 1 + Q_MAX MOD OV_QH STOREI
    OV_QC LOADI 1 + OV_QC STOREI
    3 unframe!
;

@ov-poll ( -- 0 | name ev val 1 )
    OV_QC LOADI 0 = [
        0
    ] [
        OV_Q OV_QT LOADI 12 * +
        dup LOADI SWAP
        dup 4 + LOADI SWAP
        8 + LOADI
        OV_QT LOADI 1 + Q_MAX MOD OV_QT STOREI
        OV_QC LOADI 1 - OV_QC STOREI
        1
    ] ?:
;

@ov-bn-post ( row -- )
    C_TEXT + LOADI EV_PRESS 1 ov-post
;

@overlay-clear ( -- )
    0 OV_N STOREI
    0 OV_BNN STOREI
    0 OV_DRAG STOREI
    0 OV_QH STOREI
    0 OV_QT STOREI
    0 OV_QC STOREI
;

@overlay-button ( text x y w h handler -- )
    6 frame! ( 0:handler 1:h 2:w 3:y 4:x 5:text )
    OV_BNN LOADI OV_MAX < OV_N LOADI OV_MAX < AND [
        OV_SLAB OV_BNN LOADI BTN_SIZE * +
        dup 4 local@ 3 local@ 2 local@ 1 local@ 5 local@ 0 button-init
        5 local@ SWAP K_BUTTON SWAP 0 local@ SWAP 0 0 ov-put
        OV_BNN LOADI 1 + OV_BNN STOREI
    ] ?
    6 unframe!
;

@overlay-default ( text -- )
    1 frame! ( 0:text )
    0
    [ dup OV_N LOADI < ] [
        dup ov-at
        dup C_TEXT + LOADI 0 local@ STR::streq [
            1 OVER C_FLG + STOREI
            C_PAY + LOADI 1 SWAP BTN_DEFAULT + STOREI
        ] [
            0 OVER C_FLG + STOREI
            C_PAY + LOADI 0 SWAP BTN_DEFAULT + STOREI
        ] ?:
        1 +
    ] |:
    drop
    1 unframe!
;

@overlay-enter ( -- posted? )
    0 1 frame! ( 0:posted )
    0
    [ dup OV_N LOADI < ] [
        dup ov-at
        dup C_FLG + LOADI [
            ov-bn-post
            1 0 local!
            OV_N LOADI
        ] [
            drop
            1 +
        ] ?:
    ] |:
    drop
    0 local@
    1 unframe!
;

@overlay-held? ( -- f ) OV_DRAG LOADI ;

@overlay-draw ( -- )
    0
    [ dup OV_N LOADI < ] [
        dup ov-at C_PAY + LOADI
        DRAW::fd SWAP button-draw
        1 +
    ] |:
    drop
;

@overlay-handle ( -- )
    [ ov-poll ]
    [
        3 frame! ( 0:val 1:ev 2:name )
        2 local@ ov-find
        dup 0 = [
            drop
        ] [
            C_HAND + LOADI
            dup 0 > [
                0 local@ SWAP CALL
            ] [
                drop
            ] ?:
        ] ?:
        3 unframe!
    ] |:
;

@overlay-pick ( mx my -- )
    2 frame! ( 0:my 1:mx )
    0
    [ dup OV_N LOADI < ] [
        dup ov-at
        dup C_PAY + LOADI
        1 local@ 0 local@ button-hit? [
            C_TEXT + LOADI overlay-default
            OV_N LOADI
        ] [
            drop
            1 +
        ] ?:
    ] |:
    drop
    2 unframe!
;

@overlay-feed ( mpkt -- )
    1 frame! ( 0:mpkt )
    OV_DRAG LOADI [
        OV_DRAG LOADI 1 - ov-at
        dup C_PAY + LOADI
        0 local@ EVENT::mouse-x
        0 local@ EVENT::mouse-y
        0 local@ EVENT::mouse-type EVENT::MOUSE_UP = [
            button-release [
                ov-bn-post
            ] [
                drop
            ] ?:
            0 OV_DRAG STOREI
        ] [
            button-track
            drop
        ] ?:
    ] [
        0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
            0
            [ dup OV_N LOADI < ] [
                dup ov-at
                dup C_PAY + LOADI
                0 local@ EVENT::mouse-x
                0 local@ EVENT::mouse-y
                button-hit? [
                    dup C_PAY + LOADI
                    button-press
                    drop
                    1 + OV_DRAG STOREI
                    OV_N LOADI
                ] [
                    drop
                    1 +
                ] ?:
            ] |:
            drop
        ] ?
    ] ?:
    1 unframe!
;

@feed ( mpkt -- )
    0 SWAP 2 frame! ( 0:mpkt 1:hit )
    0 1 local!
    MB_ACTIVE LOADI -1 > [
        0 local@ mb-feed-open
        1 1 local!
    ] [
        0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
            0 local@ EVENT::mouse-x 0 local@ EVENT::mouse-y mb-hit-title
            dup -1 > [
                mb-open
                1 1 local!
            ] [
                drop
            ] ?:
        ] ?
    ] ?:
    1 local@ [
    ] [
    SL_DRAG LOADI [
        SL_DRAG LOADI 1 - comp-at
        dup C_PAY + LOADI
        0 local@ EVENT::mouse-y
        slider-drag [
            sl-post
        ] [
            drop
        ] ?:
        0 local@ EVENT::mouse-type EVENT::MOUSE_UP = [
            SL_DRAG LOADI 1 - comp-at C_PAY + LOADI
            slider-release
            0 SL_DRAG STOREI
        ] ?
    ] [
        SBAR_DRAG LOADI [
            SBAR_DRAG LOADI 1 - comp-at
            dup C_PAY + LOADI
            0 local@ EVENT::mouse-x
            0 local@ EVENT::mouse-y
            sbar-drag [
                sbar-post
            ] [
                drop
            ] ?:
            0 local@ EVENT::mouse-type EVENT::MOUSE_UP = [
                SBAR_DRAG LOADI 1 - comp-at C_PAY + LOADI
                sbar-release
                0 SBAR_DRAG STOREI
            ] ?
        ] [
        BN_DRAG LOADI [
            BN_DRAG LOADI 1 - comp-at
            dup C_PAY + LOADI
            0 local@ EVENT::mouse-x
            0 local@ EVENT::mouse-y
            0 local@ EVENT::mouse-type EVENT::MOUSE_UP = [
                button-release [
                    bn-post
                ] [
                    drop
                ] ?:
                0 BN_DRAG STOREI
            ] [
                button-track
                drop
            ] ?:
        ] [
        0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
            0
            [ dup COMP_N LOADI < ] [
                dup comp-at
                dup C_KIND + LOADI K_CHECKBOX = [
                    dup C_PAY + LOADI
                    0 local@ EVENT::mouse-x
                    0 local@ EVENT::mouse-y
                    1
                    checkbox-update [
                        1 1 local!
                        dup C_TEXT + LOADI
                        SWAP C_PAY + LOADI CB_CHK + LOADI
                        dup 0 = [ EV_UNCHECK ] [ EV_CHECK ] ?:
                        SWAP
                        post
                        drop
                        COMP_N LOADI
                    ] [
                        drop
                        1 +
                    ] ?:
                ] [
                    drop
                    1 +
                ] ?:
            ] |:
            drop
            1 local@ 0 = [
                0
                [ dup COMP_N LOADI < ] [
                    dup comp-at
                    dup C_KIND + LOADI K_RADIO = [
                        dup C_PAY + LOADI
                        0 local@ EVENT::mouse-x
                        0 local@ EVENT::mouse-y
                        1
                        radio-update [
                            dup C_GRP + LOADI
                            OVER C_PAY + LOADI
                            rd-clear-group
                            dup C_TEXT + LOADI EV_SELECT 1 post
                            drop drop
                            COMP_N LOADI
                        ] [
                            drop
                            1 +
                        ] ?:
                    ] [
                        drop
                        1 +
                    ] ?:
                ] |:
                drop
            ] ?
            1 local@ 0 = [
                0
                [ dup COMP_N LOADI < ] [
                    dup comp-at
                    dup C_KIND + LOADI K_SLIDER = [
                        dup C_PAY + LOADI
                        0 local@ EVENT::mouse-x
                        0 local@ EVENT::mouse-y
                        slider-hit? [
                            dup C_PAY + LOADI
                            0 local@ EVENT::mouse-y
                            slider-grab [
                                sl-post
                            ] [
                                drop
                            ] ?:
                            1 + SL_DRAG STOREI
                            COMP_N LOADI
                        ] [
                            drop
                            1 +
                        ] ?:
                    ] [
                        drop
                        1 +
                    ] ?:
                ] |:
                drop
            ] ?
            1 local@ 0 = [
                0
                [ dup COMP_N LOADI < ] [
                    dup comp-at
                    dup C_KIND + LOADI K_SCROLLBAR = [
                        dup C_PAY + LOADI
                        0 local@ EVENT::mouse-x
                        0 local@ EVENT::mouse-y
                        sbar-hit? [
                            dup C_PAY + LOADI
                            0 local@ EVENT::mouse-x
                            0 local@ EVENT::mouse-y
                            sbar-press [
                                sbar-post
                            ] [
                                drop
                            ] ?:
                            1 + SBAR_DRAG STOREI
                            1 1 local!
                            COMP_N LOADI
                        ] [
                            drop
                            1 +
                        ] ?:
                    ] [
                        drop
                        1 +
                    ] ?:
                ] |:
                drop
            ] ?
            1 local@ 0 = [
                0
                [ dup COMP_N LOADI < ] [
                    dup comp-at
                    dup C_KIND + LOADI K_BUTTON = [
                        dup C_PAY + LOADI
                        0 local@ EVENT::mouse-x
                        0 local@ EVENT::mouse-y
                        button-hit? [
                            dup C_PAY + LOADI
                            button-press
                            drop
                            1 + BN_DRAG STOREI
                            1 1 local!
                            COMP_N LOADI
                        ] [
                            drop
                            1 +
                        ] ?:
                    ] [
                        drop
                        1 +
                    ] ?:
                ] |:
                drop
            ] ?
        ] ?
        ] ?:
        ] ?:
    ] ?:
    ] ?:
    2 unframe!
;

@payload-init { ctl -- }
    ctl CTL.kind@
    dup K_BUTTON = [
        drop
        BTN_SIZE MEM::allot dup ctl CTL.payload!
        0 0 80 24 0 0 button-init
    ] [
    dup K_CHECKBOX = [
        drop
        CB_SIZE MEM::allot dup ctl CTL.payload!
        0 0 16 0 checkbox-init
    ] [
    dup K_RADIO = [
        drop
        CB_SIZE MEM::allot dup ctl CTL.payload!
        0 0 16 0 checkbox-init
    ] [
    dup K_SLIDER = [
        drop
        SL_SIZE MEM::allot dup ctl CTL.payload!
        0 0 100 16 0 100 0 slider-init
    ] [
    dup K_SCROLLBAR = [
        drop
        SB_SIZE MEM::allot dup ctl CTL.payload!
        0 0 16 100 0 100 0 16 scrollbar-init
    ] [
    dup K_FIELD = [
        drop
        TX_SIZE MEM::allot
        256 MEM::allot { p buf }
            p ctl CTL.payload!
            p 0 0 100 20 buf 255 text-init
        }
    ] [
        drop
        0 ctl CTL.payload!
    ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
;

@create { name kind -- ctl }
    CTL.SIZE MEM::allot
    { ctl }
        name ctl CTL.name!
        kind ctl CTL.kind!
        F_VISIBLE ctl CTL.flags!
        0 ctl CTL.minx!
        0 ctl CTL.miny!
        0 ctl CTL.maxx!
        0 ctl CTL.maxy!
        0 ctl CTL.state!
        0 ctl CTL.value!
        0 ctl CTL.vmin!
        0 ctl CTL.vmax!
        0 ctl CTL.group!
        0 ctl CTL.label!
        0 ctl CTL.on-press!
        0 ctl CTL.on-change!
        0 ctl CTL.payload!
        CS_HEAD LOADI ctl CTL.next!
        ctl CS_HEAD STOREI
        ctl payload-init
        ctl
    }
;

@ctl-button   { name -- ctl } name K_BUTTON   create ;
@ctl-checkbox { name -- ctl } name K_CHECKBOX create ;
@ctl-radio    { name -- ctl } name K_RADIO    create ;
@ctl-slider   { name -- ctl } name K_SLIDER   create ;
@scrollbar { name -- ctl } name K_SCROLLBAR create ;
@field    { name -- ctl } name K_FIELD    create ;
@ctl-label { name -- ctl } name K_LABEL    create ;
@window   { name -- ctl } name K_WINDOW   create ;

@sync-payload ( ctl -- )
    1 frame! ( 0:ctl )
    0 local@ CTL.payload@ dup 0 = [ drop ] [
        0 local@ CTL.minx@ OVER STOREI
        0 local@ CTL.miny@ OVER 4 + STOREI
        0 local@ CTL.kind@ K_CHECKBOX = 0 local@ CTL.kind@ K_RADIO = OR [
            BOX OVER 8 + STOREI
            0 local@ CTL.value@ OVER CB_CHK + STOREI
            0 local@ CTL.label@ SWAP CB_LABEL + STOREI
        ] [
            0 local@ CTL.maxx@ 0 local@ CTL.minx@ - OVER 8 + STOREI
            0 local@ CTL.maxy@ 0 local@ CTL.miny@ - OVER 12 + STOREI
            0 local@ CTL.kind@ K_BUTTON = [
                0 local@ CTL.label@ OVER BTN_LABEL + STOREI
                0 local@ CTL.on-press@ OVER BTN_CALLBACK + STOREI
                0 local@ CTL.flags@ F_DEFAULT AND [ 1 ] [ 0 ] ?: SWAP BTN_DEFAULT + STOREI
            ] [
                0 local@ CTL.kind@ K_SLIDER = [
                    0 local@ CTL.vmin@ OVER SL_MIN + STOREI
                    0 local@ CTL.vmax@ OVER SL_MAX + STOREI
                    0 local@ CTL.value@ SWAP SL_VAL + STOREI
                ] [
                    0 local@ CTL.kind@ K_SCROLLBAR = [
                        0 local@ CTL.vmin@ OVER SB_MIN + STOREI
                        0 local@ CTL.vmax@ OVER SB_MAX + STOREI
                        0 local@ CTL.value@ SWAP SB_VAL + STOREI
                    ] [ drop ] ?:
                ] ?:
            ] ?:
        ] ?:
    ] ?:
    1 unframe!
;

@rect! { ctl minx miny maxx maxy -- ctl }
    minx ctl CTL.minx!
    miny ctl CTL.miny!
    maxx ctl CTL.maxx!
    maxy ctl CTL.maxy!
    ctl sync-payload
    ctl
;

@text! { ctl ptr -- ctl }
    ptr ctl CTL.label!
    ctl sync-payload
    ctl
;

@value! { c v -- c }
    v c CTL.value!
    c sync-payload
    c
;

@value@ { ctl -- n } ctl CTL.value@ ;

@range! { ctl lo hi val -- ctl }
    lo ctl CTL.vmin!
    hi ctl CTL.vmax!
    val ctl CTL.value!
    ctl sync-payload
    ctl
;

@group! { ctl name -- ctl } name ctl CTL.group! ctl ;

@on-press!  { ctl quot -- ctl } quot ctl CTL.on-press!  ctl sync-payload ctl ;
@on-change! { ctl quot -- ctl } quot ctl CTL.on-change! ctl ;

@show! { ctl -- ctl }
    ctl CTL.flags@ F_HIDDEN -1 XOR AND F_VISIBLE OR ctl CTL.flags!
    ctl
;
@hide! { ctl -- ctl }
    ctl CTL.flags@ F_VISIBLE -1 XOR AND F_HIDDEN OR ctl CTL.flags!
    ctl
;
@focus! { ctl -- ctl }
    ctl CS_FOCUS STOREI
    ctl CTL.flags@ F_FOCUS OR ctl CTL.flags!
    ctl
;
@title! { ctl n -- ctl }
    n [
        ctl CTL.flags@ F_TITLE OR ctl CTL.flags!
    ] [
        ctl CTL.flags@ F_TITLE -1 XOR AND ctl CTL.flags!
    ] ?:
    ctl
;
@default! { ctl -- ctl }
    ctl CTL.flags@ F_DEFAULT OR ctl CTL.flags!
    ctl sync-payload
    ctl
;

@is-visible? { ctl -- bool }
    ctl CTL.flags@ F_VISIBLE AND 0 = 0 =
    ctl CTL.flags@ F_HIDDEN AND 0 = AND
;

@win-client { ctl -- minx miny maxx maxy }
    ctl CTL.minx@ WIN_BORDER +
    ctl CTL.miny@ TITLE_H +
    ctl CTL.maxx@ WIN_BORDER -
    ctl CTL.maxy@ WIN_BORDER -
;

@win-hit { ctl x y -- where }
    x y ctl CTL.minx@ ctl CTL.miny@ ctl CTL.maxx@ ctl CTL.maxy@ GEOM::pt-in-rect? 0 = [
        0
    ] [
        x ctl CTL.minx@ CLOSE_INSET + >=
        x ctl CTL.minx@ CLOSE_INSET + CLOSE_SZ + < AND
        y ctl CTL.miny@ CLOSE_Y + >= AND
        y ctl CTL.miny@ CLOSE_Y + CLOSE_SZ + < AND [
            3
        ] [
            y ctl CTL.miny@ >=
            y ctl CTL.miny@ TITLE_H + < AND [
                2
            ] [
                1
            ] ?:
        ] ?:
    ] ?:
;

@win-chrome { ctl -- }
    ( drop shadow )
    DRAW::fd ctl CTL.minx@ 2 + ctl CTL.miny@ 2 +
    ctl CTL.maxx@ ctl CTL.minx@ -
    ctl CTL.maxy@ ctl CTL.miny@ -
    CLR_BORDER DRAW::paint-rect
    ( black 1px frame, white body )
    DRAW::fd ctl CTL.minx@ ctl CTL.miny@
    ctl CTL.maxx@ ctl CTL.minx@ -
    ctl CTL.maxy@ ctl CTL.miny@ -
    CLR_BORDER DRAW::paint-rect
    DRAW::fd ctl CTL.minx@ 1 + ctl CTL.miny@ 1 +
    ctl CTL.maxx@ ctl CTL.minx@ - 2 -
    ctl CTL.maxy@ ctl CTL.miny@ - 2 -
    CLR_BG DRAW::paint-rect
    ( title bar: white, then even horizontal black lines )
    DRAW::fd ctl CTL.minx@ 1 + ctl CTL.miny@ 1 +
    ctl CTL.maxx@ ctl CTL.minx@ - 2 - TITLE_H 2 -
    CLR_BG DRAW::paint-rect
    DRAW::fd ctl CTL.minx@ 1 + ctl CTL.miny@ 1 +
    ctl CTL.maxx@ ctl CTL.minx@ - 2 - TITLE_H 2 -
    CLR_BORDER 1 DRAW::fill-pat
    DRAW::fd ctl CTL.minx@ ctl CTL.miny@ TITLE_H + 1 -
    ctl CTL.maxx@ ctl CTL.minx@ - 1 CLR_BORDER DRAW::paint-rect
    ( go-away box, left )
    DRAW::fd ctl CTL.minx@ CLOSE_INSET + ctl CTL.miny@ CLOSE_Y +
    CLOSE_SZ CLOSE_SZ CLR_BG DRAW::paint-rect
    DRAW::fd ctl CTL.minx@ CLOSE_INSET + ctl CTL.miny@ CLOSE_Y +
    CLOSE_SZ CLOSE_SZ CLR_BORDER DRAW::frame-rect
    DRAW::fd ctl CTL.minx@ CLOSE_INSET + 2 + ctl CTL.miny@ CLOSE_Y + 2 +
    7 7 CLR_BORDER DRAW::frame-rect
    ctl CTL.label@ 0 > [
        ctl CTL.label@ strlen DRAW::char-w * 16 +
        { tw }
            DRAW::fd
            ctl CTL.minx@ ctl CTL.maxx@ + tw - 2 /
            ctl CTL.miny@ 3 +
            tw 12 CLR_BG DRAW::paint-rect
            DRAW::fd
            ctl CTL.minx@ ctl CTL.maxx@ + tw - 2 / 8 +
            ctl CTL.miny@ 3 +
            ctl CTL.label@ CLR_TEXT 1 DRAW::draw-str
        }
    ] ?
;

@draw-one { ctl -- }
    ctl is-visible? [
        ctl CTL.kind@ K_WINDOW = [
            ctl win-chrome
        ] [
            ctl sync-payload
            ctl CTL.kind@ K_FIELD = [
                DRAW::fd ctl CTL.minx@ ctl CTL.miny@
                ctl CTL.maxx@ ctl CTL.minx@ -
                ctl CTL.maxy@ ctl CTL.miny@ -
                frame-rect
            ] ?
            DRAW::fd ctl CTL.payload@
            ctl CTL.kind@ K_BUTTON = [ button-draw ] [
            ctl CTL.kind@ K_CHECKBOX = [ checkbox-draw ] [
            ctl CTL.kind@ K_RADIO = [ radio-draw ] [
            ctl CTL.kind@ K_SLIDER = [ slider-draw ] [
            ctl CTL.kind@ K_SCROLLBAR = [ scrollbar-draw ] [
            ctl CTL.kind@ K_FIELD = [ text-draw ] [
            ctl CTL.kind@ K_LABEL = [
                drop drop
                ctl CTL.label@ 0 > [
                    DRAW::fd ctl CTL.minx@ ctl CTL.miny@ ctl CTL.label@ CLR_TEXT 1 DRAW::draw-str
                ] ?
            ] [ drop drop ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
        ] ?:
    ] ?
;

@ctl-draw ( -- )
    ( windows first so their client fill does not cover widgets )
    CS_HEAD LOADI
    [ dup 0 > ] [
        dup CTL.kind@ K_WINDOW = [ dup draw-one ] ?
        CTL.next@
    ] |:
    drop
    CS_HEAD LOADI
    [ dup 0 > ] [
        dup CTL.kind@ K_WINDOW = 0 = [ dup draw-one ] ?
        CTL.next@
    ] |:
    drop
;

@clear-radio-group ( group except -- )
    2 frame! ( 0:except 1:group )
    CS_HEAD LOADI
    [ dup 0 > ] [
        dup CTL.kind@ K_RADIO =
        OVER 0 local@ = 0 = AND
        OVER CTL.group@ 0 > AND [
            dup CTL.group@ 1 local@ STR::streq [
                0 OVER value! drop
            ] ?
        ] ?
        CTL.next@
    ] |:
    drop
    2 unframe!
;

@hit-mouse ( ctl mx my typ -- )
    4 frame! ( 0:typ 1:my 2:mx 3:ctl )
    3 local@ CTL.payload@ 0 = [
        4 unframe!
    ] [
        3 local@ sync-payload
        3 local@ CTL.kind@ K_BUTTON = [
            3 local@ CTL.payload@ 2 local@ 1 local@
            0 local@ EVENT::MOUSE_DOWN = [ 1 ] [ 0 ] ?:
            button-update [
                3 local@ CTL.on-press@ dup 0 > [ CALL ] [ drop ] ?:
            ] ?
        ] ?
        3 local@ CTL.kind@ K_CHECKBOX = [
            0 local@ EVENT::MOUSE_DOWN = [
                3 local@ CTL.value@ 0 = [ 1 ] [ 0 ] ?:
                3 local@ CTL.value!
                3 local@ sync-payload
            ] ?
        ] ?
        3 local@ CTL.kind@ K_RADIO = [
            0 local@ EVENT::MOUSE_DOWN = [
                3 local@ CTL.group@ 0 > [
                    3 local@ CTL.group@ 3 local@ clear-radio-group
                ] ?
                1 3 local@ CTL.value!
                3 local@ sync-payload
            ] ?
        ] ?
        3 local@ CTL.kind@ K_SLIDER = [
            3 local@ CTL.payload@ 2 local@ 1 local@ 0 local@ slider-ev
            3 local@ CTL.value!
            3 local@ CTL.payload@ SL_DRG + LOADI [
                3 local@ CS_DRAG STOREI
            ] [
                CS_DRAG LOADI 3 local@ = [ 0 CS_DRAG STOREI ] ?
            ] ?:
        ] ?
        3 local@ CTL.kind@ K_FIELD = [
            3 local@ CS_FOCUS STOREI
            3 local@ CTL.payload@ 2 local@ 1 local@ 0 local@ text-update-mouse
        ] ?
        4 unframe!
    ] ?:
;

@in-ctl? ( ctl mx my -- bool )
    3 frame! ( 0:my 1:mx 2:ctl )
    1 local@ 0 local@
    2 local@ CTL.minx@ 2 local@ CTL.miny@
    2 local@ CTL.maxx@ 2 local@ CTL.maxy@
    GEOM::pt-in-rect?
    3 unframe!
;

@hit-walk ( mx my typ -- )
    3 frame! ( 0:typ 1:my 2:mx )
    CS_HEAD LOADI
    [ dup 0 > ] [
        dup CTL.kind@ K_WINDOW = [
            CTL.next@
        ] [
            dup is-visible? [
                dup 2 local@ 1 local@ in-ctl? [
                    dup 2 local@ 1 local@ 0 local@ hit-mouse
                    drop 0
                ] [
                    CTL.next@
                ] ?:
            ] [
                CTL.next@
            ] ?:
        ] ?:
    ] |:
    drop
    3 unframe!
;

@mouse ( mpkt -- )
    1 frame! ( 0:mpkt )
    CS_DRAG LOADI dup 0 > [
        0 local@ EVENT::mouse-x
        0 local@ EVENT::mouse-y
        0 local@ EVENT::mouse-type
        hit-mouse
        0 local@ EVENT::mouse-type EVENT::MOUSE_UP = [ 0 CS_DRAG STOREI ] ?
    ] [
        drop
        0 local@ EVENT::mouse-x
        0 local@ EVENT::mouse-y
        0 local@ EVENT::mouse-type
        hit-walk
    ] ?:
    0 drop
    1 unframe!
;

@kbd ( kpkt -- )
    1 frame! ( 0:kpkt )
    CS_FOCUS LOADI dup 0 > [
        dup CTL.payload@ 0 = [
            drop
        ] [
            dup CTL.kind@ K_FIELD = [
                CTL.payload@
                0 local@ EVENT::kbd-key
                0 local@ EVENT::kbd-mods
                text-update-kbd
            ] [ drop ] ?:
        ] ?:
    ] [ drop ] ?:
    1 unframe!
;

