( Logger Module for Lux )

INCLUDE "lib/sci.lux"

MODULE LOG

( Memory for logging state. Compiler-allocated -- this flag was the
  original collision (0x803000, inside Quill's FILE_BUF); with RESERVE
  there is no address to get wrong. See docs/reserve-directive.md. )
RESERVE ENABLED-FLAG 4 ;

@ENABLE ( -- )
    1 ENABLED-FLAG STOREI
;

@DISABLE ( -- )
    0 ENABLED-FLAG STOREI
;

@MSG ( ptr -- )
    ENABLED-FLAG LOADI [
        SCI::DEBUG-PRINT
    ] [
        drop
    ] ?:
;
