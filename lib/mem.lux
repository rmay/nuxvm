( Bump allocator. Heap band is MM_LUX_HEAP_BASE..MM_LUX_HEAP_END
  (0xA00000..0xC00000, include/memory_map.h) -- owned exclusively by this
  module, nothing else may place a global in this range.

  HERE_ADDR used to be 0x8E0000, which collided with lib/ui.lux's base
  address; HEAP_START used to be 0xA00000 flush against the band start,
  which collided with apps/Quill.lux's PASTE_BUF. See docs/memory-map.md.

  Both the bump pointer and the heap itself are now RESERVE'd, so this
  module no longer owns a band of its own -- it is an ordinary consumer of
  the reservation band like everything else, and the two hand-picked bounds
  it used to keep in step with include/memory_map.h are gone.

  256KB against a worst case of roughly 18KB: COMP_MAX (48) controls, each
  allotting at most a CTL record plus a text field and its 256-byte buffer
  (lib/ui.lux is the only caller in the tree). )

INCLUDE "lib/core.lux"

MODULE MEM

@HEAP_BYTES 262144 ;
RESERVE HEAP 262144 ;
RESERVE HERE_ADDR 4 ;

@HEAP_START ( -- addr ) HEAP ;
@HEAP_END   ( -- addr ) HEAP HEAP_BYTES + ;

@here ( -- addr ) HERE_ADDR LOADI ;

@reset ( -- )
    HEAP_START HERE_ADDR STOREI
;

@ensure ( -- )
    here 0 = [ reset ] ?
    here HEAP_START < [ reset ] ?
    here HEAP_END >= [ reset ] ?
;

@align ( -- )
    ensure
    here 3 + 0xFFFFFFFC AND HERE_ADDR STOREI
;

@allot { n -- addr }
    ensure
    align
    n 1 < [
        0
    ] [
        here
        dup n +
        dup OVER < [
            drop drop 0
        ] [
            dup HEAP_END >= [
                drop drop 0
            ] [
                HERE_ADDR STOREI
            ] ?:
        ] ?:
    ] ?:
;
