( Bump allocator. Heap band is MM_LUX_HEAP_BASE..MM_LUX_HEAP_END
  (0xA00000..0xC00000, include/memory_map.h) -- owned exclusively by this
  module, nothing else may place a global in this range.

  HERE_ADDR used to be 0x8E0000, which collided with lib/ui.lux's base
  address; HEAP_START used to be 0xA00000 flush against the band start,
  which collided with apps/Quill.lux's PASTE_BUF. Both are now
  self-contained within this module's own band: the first 0x100 bytes hold
  HERE_ADDR itself, the heap proper starts right after. See
  docs/memory-map.md. )

INCLUDE "lib/core.lux"

MODULE MEM

@HEAP_START 0xA00100 ;
@HEAP_END   0xC00000 ;
@HERE_ADDR  0xA00000 ;

@here ( -- addr ) HERE_ADDR LOADI ;

@reset ( -- )
    HEAP_START HERE_ADDR STOREI
;

@ensure ( -- )
    here 0 = [ reset ] ?
    here HEAP_START < [ reset ] ?
    here HEAP_END >= [ reset ] ?
;

@align ( -- )
    ensure
    here 3 + 0xFFFFFFFC AND HERE_ADDR STOREI
;

@allot { n -- addr }
    ensure
    align
    n 1 < [
        0
    ] [
        here
        dup n +
        dup OVER < [
            drop drop 0
        ] [
            dup HEAP_END >= [
                drop drop 0
            ] [
                HERE_ADDR STOREI
            ] ?:
        ] ?:
    ] ?:
;
