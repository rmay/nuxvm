( Checkbox, radios, volume slider, scrollbars, System 6 buttons,
  a menu bar (command / check / radio / separator), and SF::.
  ./bin/cloister apps/UIDemo.bin )

INCLUDE "lib/app.lux"
INCLUDE "lib/ui.lux"
INCLUDE "lib/sf.lux"

MODULE DEMO

IMPORT APP
IMPORT UI
IMPORT DRAW
IMPORT EVENT
IMPORT STR
IMPORT SF

@last 0x8A0014 ;
@kind 0x8A0018 ;
@msg  0x8A001C ;
@grp  0x8A0020 ;
@nbuf 0x8A0030 ;

@cb-set ( name val -- )
    2 frame! ( 0:val 1:name )
    1 local@ UI::comp-find
    dup 0 = [
        drop
    ] [
        UI::C_PAY + LOADI
        0 local@ SWAP UI::CB_CHK + STOREI
    ] ?:
    2 unframe!
;

@hidden-msg ( val -- )
    0 kind STOREI
    [
        T"message: checked"
    ] [
        T"message: off"
    ] ?:
    msg STOREI
;

( Panel checkbox: feed already toggled the box. Only sync the menu mark. )
@on-hidden ( val -- )
    dup last STOREI
    dup SF::hidden!
    T"Show hidden" SWAP UI::item-set
    last LOADI hidden-msg
;

( Edit → Show hidden: toolkit already toggled the mark. Sync the box. )
@on-hidden-item ( val -- )
    dup last STOREI
    dup SF::hidden!
    T"Show hidden files" SWAP cb-set
    T"Show hidden" last LOADI UI::item-set
    last LOADI hidden-msg
;

@on-pick ( path -- )
    6 kind STOREI
    msg STOREI
;

@on-left ( val -- )
    drop
    T"Left" UI::rd-pick
    T"Align Left" 1 UI::item-set
    1 kind STOREI T"message: Left" msg STOREI
;
@on-center ( val -- )
    drop
    T"Center" UI::rd-pick
    T"Align Center" 1 UI::item-set
    1 kind STOREI T"message: Center" msg STOREI
;
@on-right ( val -- )
    drop
    T"Right" UI::rd-pick
    T"Align Right" 1 UI::item-set
    1 kind STOREI T"message: Right" msg STOREI
;
@on-ok     ( val -- ) drop 3 kind STOREI T"message: OK"     msg STOREI ;
@on-cancel ( val -- ) drop 3 kind STOREI T"message: Cancel" msg STOREI ;
@on-open   ( val -- ) drop SF::show ;
@on-quit   ( val -- ) drop HALT ;
@on-about  ( val -- ) drop 3 kind STOREI T"message: About UI Demo" msg STOREI ;

@on-vol ( val -- )
    last STOREI
    2 kind STOREI
;

@on-vbar ( val -- )
    last STOREI
    4 kind STOREI
;

@on-hbar ( val -- )
    last STOREI
    5 kind STOREI
;

@on-mouse ( mpkt -- )
    SF::open? [
        SF::mouse
    ] [
        UI::feed
    ] ?:
;

@on-kbd ( kpkt -- )
    SF::open? [
        SF::kbd
    ] [
        dup EVENT::kbd-type EVENT::KEY_DOWN = [
            dup EVENT::kbd-key EVENT::KEY_ESC = [
                drop
                UI::escape drop
            ] [
                EVENT::kbd-key EVENT::KEY_ENTER = [
                    UI::enter drop
                ] ?
            ] ?:
        ] [
            drop
        ] ?:
    ] ?:
;

@on-frame ( -- )
    UI::handle
    DRAW::fd 0 0 APP::width APP::height UI::CLR_BG DRAW::paint-rect
    DRAW::fd 40 40 500 236 UI::CLR_BG DRAW::paint-rect
    DRAW::fd 40 40 500 236 UI::CLR_BORDER DRAW::frame-rect
    kind LOADI 2 =
    kind LOADI 4 = OR
    kind LOADI 5 = OR [
        last LOADI nbuf STR::int-to-str
        kind LOADI 4 = [
            DRAW::fd 56 258 T"vscroll: " UI::CLR_TEXT 1 DRAW::draw-str
            DRAW::fd 119 258 nbuf UI::CLR_TEXT 1 DRAW::draw-str
        ] [
        kind LOADI 5 = [
            DRAW::fd 56 258 T"hscroll: " UI::CLR_TEXT 1 DRAW::draw-str
            DRAW::fd 119 258 nbuf UI::CLR_TEXT 1 DRAW::draw-str
        ] [
            DRAW::fd 56 258 T"message: " UI::CLR_TEXT 1 DRAW::draw-str
            DRAW::fd 119 258 nbuf UI::CLR_TEXT 1 DRAW::draw-str
        ] ?: ] ?:
    ] [
        msg LOADI 0 > [
            DRAW::fd 56 258 msg LOADI UI::CLR_TEXT 1 DRAW::draw-str
        ] ?
    ] ?:
    UI::draw
    SF::open? [
        SF::draw
    ] ?
;

@start
    T"UI Demo" APP::init
    UI::new
    0 last STOREI
    0 kind STOREI
    0 msg STOREI
    0 SF::hidden!
    [ on-pick ] SF::on-ok!
    T"align" grp STOREI
    APP::width UI::menubar
    T"File" UI::menu
    T"Open File" [ on-open ]  UI::item
    T"About"     [ on-about ] UI::item
    UI::sep
    T"Quit"      [ on-quit ]  UI::item
    T"Edit" UI::menu
    T"Show hidden" [ on-hidden-item ] UI::check-item
    UI::sep
    T"Align Left"   grp LOADI [ on-left ]   UI::radio-item
    T"Align Center" grp LOADI [ on-center ] UI::radio-item
    T"Align Right"  grp LOADI [ on-right ]  UI::radio-item
    T"Click a control" 56 56 UI::label
    T"Speaker Volume" 268 56 UI::label
    T"Scroll" 400 56 UI::label
    T"Show hidden files" 56 88 200 12 [ on-hidden ] UI::checkbox
    T"Alignment" 48 128 220 80 UI::groupbox
    T"Left"   56 140 80 12 grp LOADI [ on-left ]   UI::radio
    T"Center" 56 164 80 12 grp LOADI [ on-center ] UI::radio
    T"Right"  56 188 80 12 grp LOADI [ on-right ]  UI::radio
    T"Show hidden" 0 UI::item-set
    1 on-left
    T"Volume" 320 80 17 112 0 7 4 [ on-vol ] UI::slider
    T"V" 412 80 16 112 0 20 6 [ on-vbar ] UI::vscroll
    T"H" 360 200 120 16 0 20 8 [ on-hbar ] UI::hscroll
    T"Open..." 173 228 67 20 [ on-open ]   UI::button
    T"Cancel"  248 228 59 20 [ on-cancel ] UI::button
    T"OK"      319 228 59 20 [ on-ok ]     UI::button
    T"OK" UI::default
    [ on-mouse ] APP::on-mouse!
    [ on-kbd ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    APP::loop
;

DEMO::start
