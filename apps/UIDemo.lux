( Checkbox, radios, volume slider, and System 6 buttons on the UI message ring.
  ./bin/cloister apps/UIDemo.bin )

INCLUDE "lib/app.lux"
INCLUDE "lib/ui.lux"

MODULE DEMO

IMPORT APP
IMPORT UI
IMPORT DRAW
IMPORT EVENT
IMPORT STR

@last      0x8A0014 ;
@last-ev   0x8A0018 ;
@last-name 0x8A001C ;
@grp       0x8A0020 ;
@nbuf      0x8A0030 ;

@on-ui ( name ev val -- )
    SWAP
    dup last-ev STOREI
    dup UI::EV_SELECT = SWAP UI::EV_PRESS = OR [
        drop
        last-name STOREI
    ] [
        last STOREI
        drop
    ] ?:
;

@msg-radio ( -- )
    last-name LOADI T"align-left" STR::streq [
        DRAW::fd 56 258 T"message: Left" UI::CLR_TEXT 1 DRAW::draw-str
    ] [
        last-name LOADI T"align-center" STR::streq [
            DRAW::fd 56 258 T"message: Center" UI::CLR_TEXT 1 DRAW::draw-str
        ] [
            DRAW::fd 56 258 T"message: Right" UI::CLR_TEXT 1 DRAW::draw-str
        ] ?:
    ] ?:
;

@msg-press ( -- )
    last-name LOADI T"ok" STR::streq [
        DRAW::fd 56 258 T"message: OK" UI::CLR_TEXT 1 DRAW::draw-str
    ] [
        DRAW::fd 56 258 T"message: Cancel" UI::CLR_TEXT 1 DRAW::draw-str
    ] ?:
;

@msg-check ( -- )
    last LOADI [
        DRAW::fd 56 258 T"message: checked" UI::CLR_TEXT 1 DRAW::draw-str
    ] [
        DRAW::fd 56 258 T"message: off" UI::CLR_TEXT 1 DRAW::draw-str
    ] ?:
;

@msg-value ( -- )
    last LOADI nbuf STR::int-to-str
    DRAW::fd 56 258 T"message: " UI::CLR_TEXT 1 DRAW::draw-str
    DRAW::fd 119 258 nbuf UI::CLR_TEXT 1 DRAW::draw-str
;

@on-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        EVENT::kbd-key EVENT::KEY_ENTER = [
            UI::bn-return drop
        ] ?
    ] [
        drop
    ] ?:
;

@on-frame ( -- )
    [ UI::poll ]
    [ on-ui ]
    |:

    DRAW::fd 0 0 APP::width APP::height UI::CLR_BG DRAW::fill-rect
    DRAW::fd 40 40 400 236 UI::CLR_BORDER DRAW::fill-rect
    DRAW::fd 41 41 398 234 UI::CLR_BG DRAW::fill-rect
    DRAW::fd 56 56 T"Click a control" UI::CLR_TEXT 1 DRAW::draw-str
    DRAW::fd 56 124 T"Alignment" UI::CLR_TEXT 1 DRAW::draw-str
    DRAW::fd 268 56 T"Speaker Volume" UI::CLR_TEXT 1 DRAW::draw-str
    last-ev LOADI UI::EV_PRESS = [
        msg-press
    ] [
        last-ev LOADI UI::EV_SELECT = [
            msg-radio
        ] [
            last-ev LOADI UI::EV_VALUE = [
                msg-value
            ] [
                msg-check
            ] ?:
        ] ?:
    ] ?:
    UI::cb-draw
    UI::rd-draw
    UI::sl-draw
    UI::bn-draw
;

@start
    T"UI Demo" APP::init
    UI::uinnew
    0 last STOREI
    0 last-ev STOREI
    0 last-name STOREI
    T"show-hidden" 56 88 12 T"Show hidden files" UI::cb-add
    T"align" grp STOREI
    T"align-left"   grp LOADI 56 140 12 T"Left"   UI::rd-add
    T"align-center" grp LOADI 56 164 12 T"Center" UI::rd-add
    T"align-right"  grp LOADI 56 188 12 T"Right"  UI::rd-add
    T"align-left" UI::rd-pick
    T"align-left" last-name STOREI
    UI::EV_SELECT last-ev STOREI
    T"volume" 320 80 17 112 0 7 4 UI::sl-add
    T"cancel" 248 228 59 20 T"Cancel" UI::bn-add
    T"ok"     319 228 59 20 T"OK"     UI::bn-add
    T"ok" UI::bn-default
    [ UI::feed ] APP::on-mouse!
    [ on-kbd ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    APP::loop
;

DEMO::start
