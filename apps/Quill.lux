( --- Quill: Plan9-style text editor ---
  Menus and user-visible behavior match apps/fluxio/Quill.fx (the product
  spec): File > New/Open/Save/Save As/Quit, Edit > Cut/Copy/Paste/Select All,
  View > Toggle Hex, File > New's unsaved-changes confirm, hex nibble
  editing, hollow blue hex caret + ASCII companion, pixel-width wrap,
  hex click-to-byte via per-glyph widths, short-row hex ASCII alignment,
  status-bar basename.

  Lux-native input stays (Fluxio lacks a modifier builtin, so fx uses
  Tab/Home/Esc placeholders instead): Cmd/Ctrl+C/X/V/S/A, Shift-extend,
  Tab indent, Home/End/Page, Cloister Esc overlay (APP::loop). 1MB
  chunked I/O and manuscript.quill as the startup document also stay. )

INCLUDE "lib/app.lux"
INCLUDE "lib/doc.lux"
INCLUDE "lib/core.lux"
INCLUDE "lib/str.lux"

MODULE MAIN
VERSION 399000

IMPORT APP
IMPORT VFS
IMPORT DRAW
IMPORT EVENT
IMPORT STR
IMPORT UI
IMPORT SF
IMPORT DIALOG
IMPORT DOC

( --- Window geometry --- )
@WIN_W      960 ;
@WIN_H      720 ;
@BAR_H      24 ;
@SB_W       16 ;
@MARGIN     16 ;
@PANE_X     16 ;
@PANE_Y     40 ;
@PANE_H     644 ;
@LINE_H     20 ;
@CARET_H    14 ;
@FONT_SIZE  18 ;
RESERVE COLUMNS-VAL 4 ;
@COLUMNS ( -- n ) COLUMNS-VAL LOADI ;
RESERVE VISIBLE_LINES-VAL 4 ;
@VISIBLE_LINES ( -- n ) VISIBLE_LINES-VAL LOADI ;
@STATUS_H   28 ;
RESERVE STATUS_BUF 256 ;

@CLR_BG     0xFFFFFF ;
@CLR_FRAME  0xAAAAAA ;
@CLR_TEXT   0x000000 ;
@CLR_CARET  0xCC0000 ;
@CLR_HEX_CARET 0x0000FF ;
@CLR_SEL    0xCCDDFF ;

( --- Memory layout ---
  Each of these has a declared bound, so the compiler places them
  (docs/reserve-directive.md). FILE_BUF used to sit at 0x800000, a 1MB span
  that covered the globals of every library Quill includes -- inert only
  because those libraries' addresses happened to be read and written through
  their own accessors. LINE_STARTS below is the one buffer still placed by
  hand; see the note there. )
@FILE_BUF_MAX   0x100000 ;
RESERVE FILE_BUF 0x100000 ;   ( FILE_BUF_MAX )
@FONT_BYTES     8448 ;
RESERVE FONT_DATA 8448 ;      ( FONT_BYTES )
@PASTE_MAX      0x10000 ;
RESERVE PASTE_BUF 0x10000 ;   ( PASTE_MAX )

( --- State --- )
RESERVE file-len 4 ;
RESERVE cursor 4 ;
RESERVE last-key 4 ;
RESERVE caret-x 4 ;
RESERVE caret-y 4 ;
RESERVE target-col 4 ;
RESERVE anchor 4 ;
RESERVE drag 4 ;
RESERVE frame-count 4 ;
RESERVE char-w-val 4 ;
RESERVE hex-mode 4 ;
RESERVE hex-nibble 4 ;
RESERVE prev-cursor 4 ;
RESERVE scroll-y 4 ;
RESERVE HEX_LINE_BUF 256 ;
RESERVE sb-bar 56 ;
RESERVE VFS_PATH_BUF 512 ;

RESERVE CHUNK_PARAM_BLOCK 20 ;
RESERVE file-fd 4 ;
RESERVE file-offset 4 ;
RESERVE total-size 4 ;
RESERVE orig-chunk-len 4 ;
@CHUNK_SIZE       65536 ;
RESERVE line-count 4 ;
RESERVE mouse-held 4 ;
RESERVE needs-redraw 4 ;
( The one buffer here that is NOT RESERVE'd, because it has no bound to
  declare: worst case (every line blank) it needs 4 bytes * FILE_BUF_MAX
  entries -- 4MB, larger than the whole reservation band. Reserving it would
  mean first capping the line count and making the indexer respect that cap,
  which is a change to how Quill handles pathological files, not a change of
  address. Until then it keeps a hand-picked address, and it now has the
  whole former app-buffer band to itself: every other Quill buffer moved out,
  so an overrun has more clear room than it did before, not less. )
@LINE_STARTS      0x900000 ;

( --- Font width --- )
@char-w ( -- w ) char-w-val LOADI ;
@PANE_W ( -- w ) WIN_W PANE_X - SB_W - ;

( Pixel advance of one glyph at FONT_SIZE. Newline has no width. )
@ch-advance ( ch -- w )
    dup 10 = [ drop 0 ] [
        FONT_DATA + load-byte
        dup 0 = [ drop 6 ] ?
        FONT_SIZE * 16 /
    ] ?:
;

( Pixel width of FILE_BUF from start up to end. )
@span-w ( start end -- px )
    2 frame! ( 0:end 1:start )
    0 1 local@
    [ dup 0 local@ < ] [
        dup FILE_BUF + load-byte ch-advance
        rot + swap
        1 +
    ] |:
    drop
    2 unframe!
;

( --- Line cache ---
  Pixel-width wrap, same algorithm as Quill.fx rebuild_lines: wrap at the
  last space on the line when one exists past the line start, otherwise
  hard-wrap at the overflowing character. First glyph on a line always
  consumes even if it is wider than the pane. )
@rebuild-lines ( -- )
    0 0 0 0 0 5 frame! ( 0:idx 1:row 2:col-x 3:line-start 4:last-space )
    0 LINE_STARTS STOREI
    1 1 local!
    PANE_X 2 local!
    -1 4 local!
    [ 0 local@ file-len LOADI < ] [
        FILE_BUF 0 local@ + load-byte
        dup 10 = [
            drop
            PANE_X 2 local!
            0 local@ 1 + 3 local!
            -1 4 local!
            3 local@ 1 local@ 4 * LINE_STARTS + STOREI
            1 local@ 1 + 1 local!
            0 local@ 1 + 0 local!
        ] [
            dup ch-advance
            2 local@ OVER + PANE_X PANE_W + >
            2 local@ PANE_X > AND [
                drop drop
                4 local@ 3 local@ > [
                    4 local@ 1 + 3 local!
                ] [
                    0 local@ 3 local!
                ] ?:
                3 local@ 1 local@ 4 * LINE_STARTS + STOREI
                1 local@ 1 + 1 local!
                PANE_X 2 local!
                -1 4 local!
                3 local@ 0 local!
            ] [
                swap dup 32 = [ 0 local@ 4 local! ] ?
                drop
                2 local@ + 2 local!
                0 local@ 1 + 0 local!
            ] ?:
        ] ?:
    ] |:
    1 local@ line-count STOREI
    5 unframe!
;

( --- Lazy Loading Helpers --- )

( Calculate A * B / C safely )
@mul-div ( A B C -- res )
    3 frame! ( 0:C 1:B 2:A )
    2 local@ 0 local@ / 1 local@ *
    2 local@ 0 local@ MOD 1 local@ 4 / *
    0 local@ 4 / dup 0 = [ drop 1 ] ? /
    +
    3 unframe!
;

( Calculate total lines )
@get-total-lines ( -- total-lines )
    hex-mode LOADI 1 = [
        total-size LOADI 16 /
    ] [
        file-len LOADI 0 = [ 0 ] [
            total-size LOADI file-len LOADI rc-from-idx drop file-len LOADI mul-div
        ] ?:
    ] ?:
;

( Calculate absolute scroll-y )
@get-abs-scroll-y ( -- abs-scroll-y )
    hex-mode LOADI 1 = [
        file-offset LOADI 16 / scroll-y LOADI +
    ] [
        file-len LOADI 0 = [ 0 ] [
            file-offset LOADI file-len LOADI rc-from-idx drop file-len LOADI mul-div
            scroll-y LOADI +
        ] ?:
    ] ?:
;

@save-current-chunk ( -- )
    file-fd LOADI 0 >= [
        DOC::dirty? [
            ( Setup CMD_WRITE_CHUNK parameter block )
            file-fd LOADI CHUNK_PARAM_BLOCK STOREI
            FILE_BUF CHUNK_PARAM_BLOCK 4 + STOREI
            file-len LOADI CHUNK_PARAM_BLOCK 8 + STOREI
            file-offset LOADI CHUNK_PARAM_BLOCK 12 + STOREI
            orig-chunk-len LOADI CHUNK_PARAM_BLOCK 16 + STOREI
            
            ( Write via VFS )
            CHUNK_PARAM_BLOCK VFS::write-chunk drop
            
            ( Update total size by difference )
            file-len LOADI orig-chunk-len LOADI - ( diff )
            total-size LOADI + total-size STOREI
            
            ( Update orig-chunk-len )
            file-len LOADI orig-chunk-len STOREI
            DOC::clean!
        ] ?
    ] ?
;

@load-chunk-at ( abs-pos -- )
    1 frame! ( 0:abs-pos )
    file-fd LOADI 0 >= [
        ( Write back current chunk if dirty )
        DOC::dirty? [ save-current-chunk ] ?
        
        ( Calculate chunk start offset: start = abs-pos - CHUNK_SIZE / 2 )
        0 local@ CHUNK_SIZE 2 / - ( start )
        
        ( Boundary check: start < 0 )
        dup 0 < [ drop 0 ] ?
        
        ( Boundary check: start + CHUNK_SIZE > total-size )
        dup CHUNK_SIZE + total-size LOADI > [
            drop total-size LOADI CHUNK_SIZE - 0 MAX
        ] ?
        
        ( Seek to start )
        dup
        file-fd LOADI swap VFS::seek drop
        
        ( Read CHUNK_SIZE bytes into FILE_BUF )
        dup
        file-offset STOREI
        
        file-fd LOADI FILE_BUF CHUNK_SIZE VFS::read ( bytes-read )
        dup file-len STOREI
        dup orig-chunk-len STOREI
        rebuild-lines
        
        ( Set cursor position relative to chunk )
        0 local@ file-offset LOADI - cursor STOREI
        
        DOC::clean!
    ] ?
    1 unframe!
;

@check-lazy-load ( -- )
    file-fd LOADI 0 >= [
        cursor LOADI 8192 < [
            file-offset LOADI 0 > [
                cursor LOADI file-offset LOADI + load-chunk-at
            ] ?
        ] [
            cursor LOADI file-len LOADI 8192 - > [
                file-offset LOADI file-len LOADI + total-size LOADI < [
                    cursor LOADI file-offset LOADI + load-chunk-at
                ] ?
            ] ?
        ] ?:
    ] ?
;

@sb-x ( -- x ) PANE_X PANE_W + ;
@sb-max ( -- n ) get-total-lines VISIBLE_LINES - 0 MAX ;

@sync-bar ( -- )
    UI::SBAR_DRAG LOADI 0 = [
        sb-bar LOADI
        sb-x PANE_Y SB_W PANE_H
        0 sb-max get-abs-scroll-y 0
        UI::sbar-init
        VISIBLE_LINES sb-bar LOADI UI::BAR_PAGE + STOREI
    ] ?
;

@on-scroll ( val -- )
    dup
    get-total-lines dup 0 = [ drop 0 ] [
        swap total-size LOADI swap mul-div
    ] ?:
    load-chunk-at
    file-len LOADI 0 = [ 0 ] [
        file-offset LOADI file-len LOADI rc-from-idx drop file-len LOADI mul-div
    ] ?:
    - scroll-y STOREI
    1 needs-redraw STOREI
;

( --- Buffer Helpers --- )

@insert-char ( ch -- )
    file-len LOADI FILE_BUF_MAX >= [ drop ] [
        cursor LOADI FILE_BUF +
        cursor LOADI FILE_BUF + 1 +
        file-len LOADI cursor LOADI -
        MEMORY::move-mem
        FILE_BUF cursor LOADI + store-byte
        file-len LOADI 1 + file-len STOREI
        cursor LOADI 1 + cursor STOREI
        DOC::dirty!
        rebuild-lines
    ] ?:
;

@insert-bytes ( src n -- )
    2 frame! ( 0:n 1:src )
    file-len LOADI 0 local@ + FILE_BUF_MAX > [
    ] [
        FILE_BUF cursor LOADI +                 ( src )
        FILE_BUF cursor LOADI + 0 local@ +      ( dst )
        file-len LOADI cursor LOADI -           ( count )
        MEMORY::move-mem
        1 local@                                 ( src )
        FILE_BUF cursor LOADI +                  ( dst )
        0 local@                                 ( count )
        MEMORY::move-mem
        file-len LOADI 0 local@ + file-len STOREI
        cursor LOADI 0 local@ + cursor STOREI
        DOC::dirty!
        rebuild-lines
    ] ?:
    2 unframe!
;

@delete-char ( -- )
    cursor LOADI 0 > [
        cursor LOADI FILE_BUF +
        cursor LOADI FILE_BUF + 1 -
        file-len LOADI cursor LOADI -
        MEMORY::move-mem
        file-len LOADI 1 - file-len STOREI
        cursor LOADI 1 - cursor STOREI
        DOC::dirty!
        rebuild-lines
    ] ?
;

@cursor-left ( -- )
    cursor LOADI 0 > [ cursor LOADI 1 - cursor STOREI ] ?
;

@cursor-right ( -- )
    cursor LOADI file-len LOADI < [ cursor LOADI 1 + cursor STOREI ] ?
;

( --- Coordinate Mapping --- )

@rc-from-idx ( idx -- r c )
    hex-mode LOADI 1 = [
        dup 16 / swap 16 MOD 3 * 6 +
    ] [
        0 0 0 rot 4 frame! ( 0:idx 1:r 2:found 3:target-idx )
        line-count LOADI 1 - 1 local!
        [ 2 local@ 0 = ] [
            1 local@ 4 * LINE_STARTS + LOADI 3 local@ <= [
                1 2 local!
            ] [
                1 local@ 1 - 1 local!
            ] ?:
        ] |:
        1 local@
        3 local@ 1 local@ 4 * LINE_STARTS + LOADI -
        4 unframe!
    ] ?:
;

@idx-from-rc ( r c -- idx )
    hex-mode LOADI 1 = [
        swap 16 * swap 6 - 3 / 0 MAX 15 MIN +
        dup file-len LOADI MIN
    ] [
        2 frame! ( 0:c 1:r )
        1 local@ line-count LOADI 1 - MIN 0 MAX 1 local!
        1 local@ 4 * LINE_STARTS + LOADI 0 local@ +
        1 local@ 1 + line-count LOADI < [
            1 local@ 1 + 4 * LINE_STARTS + LOADI 1 -
            MIN
        ] [
            file-len LOADI MIN
        ] ?:
        2 unframe!
    ] ?:
;

@line-at ( r -- idx ) 4 * LINE_STARTS + LOADI ;

@line-end-at ( r -- idx )
    dup 1 + line-count LOADI < [
        1 + line-at
    ] [
        drop file-len LOADI
    ] ?:
;

( If px is past the last glyph, land on the line end. )
@click-idx ( r px -- idx )
    over line-at
    rot
    dup line-end-at
    swap
    4 frame! ( 0:r 1:end 2:start 3:px )
    1 local@ 2 local@ > [
        FILE_BUF 1 local@ 1 - + load-byte 10 = [
            1 local@ 1 - 1 local!
        ] ?
    ] ?
    2 local@ 1 local@ span-w
    3 local@ <= [
        1 local@
    ] [
        0 local@ 3 local@ char-w 2 / + char-w / idx-from-rc
    ] ?:
    4 unframe!
;

@hex-byte-at ( idx -- b )
    dup file-len LOADI < [ FILE_BUF + load-byte ] [ drop 0 ] ?:
;

@hex-ascii-ch ( b -- ch )
    dup 32 < [ drop 46 ] [
        dup 126 > [ drop 46 ] ?
    ] ?:
;

@nibble-to-hex ( n -- ch ) dup 10 < [ 48 + ] [ 10 - 65 + ] ?: ;

@hex-col-x ( row-addr col -- x )
    PANE_X 0 4 frame! ( 0:c 1:x 2:col 3:row-addr )
    1 local@ 3 local@ 12 SHR 15 AND nibble-to-hex ch-advance + 1 local!
    1 local@ 3 local@ 8 SHR 15 AND nibble-to-hex ch-advance + 1 local!
    1 local@ 3 local@ 4 SHR 15 AND nibble-to-hex ch-advance + 1 local!
    1 local@ 3 local@ 15 AND nibble-to-hex ch-advance + 1 local!
    1 local@ 32 ch-advance + 1 local!
    1 local@ 32 ch-advance + 1 local!
    [ 0 local@ 2 local@ < ] [
        3 local@ 0 local@ + hex-byte-at
        dup 4 SHR 15 AND nibble-to-hex ch-advance 1 local@ + 1 local!
        15 AND nibble-to-hex ch-advance 1 local@ + 1 local!
        32 ch-advance 1 local@ + 1 local!
        0 local@ 1 + 0 local!
    ] |:
    1 local@
    4 unframe!
;

@hex-ascii-col-x ( row-addr col -- x )
    0 3 frame! ( 0:c 1:col 2:row-addr )
    2 local@ 16 hex-col-x
    32 ch-advance 2 * +
    [ 0 local@ 1 local@ < ] [
        2 local@ 0 local@ + hex-byte-at hex-ascii-ch ch-advance +
        0 local@ 1 + 0 local!
    ] |:
    3 unframe!
;

@hex-find-click-index ( mx my -- idx )
    0 0 0 0 6 frame! ( 0:done 1:result-col 2:col 3:row-addr 4:my 5:mx )
    15 1 local!
    4 local@ PANE_Y - 0 MAX LINE_H /
    dup 0 < [ drop 0 ] ?
    dup VISIBLE_LINES 1 - > [ drop VISIBLE_LINES 1 - 0 MAX ] ?
    scroll-y LOADI + 16 *
    dup file-len LOADI > [ drop file-len LOADI 16 / 16 * ] ?
    3 local!
    [ 2 local@ 16 < 0 local@ 0 = AND ] [
        3 local@ 2 local@ 1 + hex-col-x 5 local@ > [
            2 local@ 1 local!
            1 0 local!
        ] ?
        2 local@ 1 + 2 local!
    ] |:
    3 local@ 1 local@ +
    dup file-len LOADI > [ drop file-len LOADI ] ?
    6 unframe!
;

@find-index-by-xy ( tx ty -- idx )
    hex-mode LOADI 1 = [
        hex-find-click-index
    ] [
        PANE_Y - 0 MAX LINE_H / scroll-y LOADI +
        dup line-count LOADI >= [
            drop drop file-len LOADI
        ] [
            swap PANE_X - 0 MAX
            click-idx
        ] ?:
    ] ?:
;

@move-sel ( new-idx mods -- )
    EVENT::MOD_SHIFT AND [
        anchor LOADI -1 = [ cursor LOADI anchor STOREI ] ?
    ] [
        sel-clear
    ] ?:
    cursor STOREI
;

@go-left ( mods -- )
    dup EVENT::MOD_SHIFT AND 0 = sel-active? AND [
        drop
        sel-lo cursor STOREI
        sel-clear
    ] [
        cursor LOADI 0 > [ cursor LOADI 1 - ] [ cursor LOADI ] ?:
        swap move-sel
    ] ?:
;

@go-right ( mods -- )
    dup EVENT::MOD_SHIFT AND 0 = sel-active? AND [
        drop
        sel-hi cursor STOREI
        sel-clear
    ] [
        cursor LOADI file-len LOADI < [ cursor LOADI 1 + ] [ cursor LOADI ] ?:
        swap move-sel
    ] ?:
;

@go-up ( mods -- )
    cursor LOADI rc-from-idx drop 1 - 0 MAX target-col LOADI idx-from-rc
    swap move-sel
;

@go-down ( mods -- )
    cursor LOADI rc-from-idx drop 1 + target-col LOADI idx-from-rc
    swap move-sel
;

@go-page-up ( mods -- )
    scroll-y LOADI VISIBLE_LINES - 0 MAX scroll-y STOREI
    cursor LOADI rc-from-idx drop VISIBLE_LINES - 0 MAX target-col LOADI idx-from-rc
    swap move-sel
;

@go-page-down ( mods -- )
    scroll-y LOADI VISIBLE_LINES + get-total-lines VISIBLE_LINES - 0 MAX MIN scroll-y STOREI
    cursor LOADI rc-from-idx drop VISIBLE_LINES + target-col LOADI idx-from-rc
    swap move-sel
;

@go-home ( mods -- )
    dup EVENT::MOD_CMD AND [
        0 swap move-sel
    ] [
        cursor LOADI rc-from-idx drop 0 idx-from-rc
        swap move-sel
    ] ?:
;

@go-end ( mods -- )
    dup EVENT::MOD_CMD AND [
        file-len LOADI swap move-sel
    ] [
        cursor LOADI rc-from-idx drop line-end-at
        dup 0 > [
            dup 1 - FILE_BUF + load-byte 10 = [ 1 - ] ?
        ] ?
        swap move-sel
    ] ?:
;

( --- Selection --- )

@sel-active? ( -- flag )
    anchor LOADI -1 = 0 =
    anchor LOADI cursor LOADI = 0 = AND
;
@sel-lo ( -- idx ) cursor LOADI anchor LOADI MIN ;
@sel-hi ( -- idx ) cursor LOADI anchor LOADI MAX ;

@delete-selection ( -- )
    sel-active? [
        sel-lo sel-hi 2 frame! ( 0:hi 1:lo )
        FILE_BUF 0 local@ + FILE_BUF 1 local@ + file-len LOADI 0 local@ - MEMORY::move-mem
        file-len LOADI 0 local@ - 1 local@ + file-len STOREI
        1 local@ cursor STOREI
        -1 anchor STOREI DOC::dirty!
        rebuild-lines
        2 unframe!
    ] ?
;

@sel-clear ( -- ) -1 anchor STOREI ;

@sel-or-delete ( -- )
    hex-mode LOADI [
        sel-active? [ delete-selection ] ?
    ] [
        sel-active? [ delete-selection ] [ delete-char ] ?:
    ] ?:
;

@type-bytes ( src n -- )
    hex-mode LOADI [ drop drop ] [
        sel-active? [ delete-selection ] ?
        dup file-len LOADI + FILE_BUF_MAX > [ drop drop ] [
            insert-bytes
        ] ?:
    ] ?:
;

@type-char ( ch -- )
    hex-mode LOADI [ drop ] [
        sel-active? [ delete-selection ] ?
        file-len LOADI FILE_BUF_MAX >= [ drop ] [
            insert-char
        ] ?:
    ] ?:
;

@select-all ( -- )
    file-len LOADI 0 > [
        0 anchor STOREI
        file-len LOADI cursor STOREI
    ] ?
;

( --- Hex Helpers --- )
@byte-to-hex ( b ptr -- ) 2 frame! 1 local@ 4 SHR 15 AND nibble-to-hex 0 local@ store-byte 1 local@ 15 AND nibble-to-hex 0 local@ 1 + store-byte 2 unframe! ;
@addr-to-hex ( a ptr -- ) 2 frame! 1 local@ 12 SHR 15 AND nibble-to-hex 0 local@ store-byte 1 local@ 8 SHR 15 AND nibble-to-hex 0 local@ 1 + store-byte 1 local@ 4 SHR 15 AND nibble-to-hex 0 local@ 2 + store-byte 1 local@ 15 AND nibble-to-hex 0 local@ 3 + store-byte 2 unframe! ;

@hex-digit-value ( key -- n )
    dup 48 >= OVER 57 <= AND [ 48 - ] [
    dup 65 >= OVER 70 <= AND [ 65 - 10 + ] [
    dup 97 >= OVER 102 <= AND [ 97 - 10 + ] [
    drop -1
    ] ?: ] ?: ] ?:
;

@edit-hex-nibble ( digit -- )
    FILE_BUF cursor LOADI + load-byte
    hex-nibble LOADI 0 = [
        15 AND swap 4 LSHIFT OR
    ] [
        240 AND OR
    ] ?:
    FILE_BUF cursor LOADI + store-byte
    DOC::dirty!
    hex-nibble LOADI 0 = [
        1 hex-nibble STOREI
    ] [
        0 hex-nibble STOREI
        cursor LOADI 1 + file-len LOADI < [
            cursor LOADI 1 + cursor STOREI
        ] ?
    ] ?:
    rebuild-lines
;

@render-hex-row ( addr -- )
    0 2 frame! ( 0:i 1:addr )
    0 [ dup 72 < ] [ dup 32 HEX_LINE_BUF rot + store-byte 1 + ] |: drop
    1 local@ HEX_LINE_BUF addr-to-hex
    [ 0 local@ 16 < ] [
        1 local@ 0 local@ + hex-byte-at
        dup 4 SHR 15 AND nibble-to-hex HEX_LINE_BUF 6 + 0 local@ 3 * + store-byte
        dup 15 AND nibble-to-hex HEX_LINE_BUF 6 + 0 local@ 3 * + 1 + store-byte
        hex-ascii-ch HEX_LINE_BUF 56 + 0 local@ + store-byte
        0 local@ 1 + 0 local!
    ] |:
    2 unframe!
;

@draw-rect-outline ( x y w h color -- )
    5 frame! ( 0:color 1:h 2:w 3:y 4:x )
    APP::draw-fd 4 local@ 3 local@ 2 local@ 1 0 local@ DRAW::fill-rect
    APP::draw-fd 4 local@ 3 local@ 1 local@ + 1 - 2 local@ 1 0 local@ DRAW::fill-rect
    APP::draw-fd 4 local@ 3 local@ 1 1 local@ 0 local@ DRAW::fill-rect
    APP::draw-fd 4 local@ 2 local@ + 1 - 3 local@ 1 1 local@ 0 local@ DRAW::fill-rect
    5 unframe!
;

( --- Rendering --- )

@draw-caret ( x y -- )
    LINE_H CARET_H - 2 / +
    APP::draw-fd rot rot 2 CARET_H CLR_CARET DRAW::fill-rect
;

@flush-seg ( start end x y -- )
    4 frame! ( 0:y 1:x 2:end 3:start )
    2 local@ 3 local@ - dup 0 > [
        APP::draw-fd 1 local@ 0 local@ FILE_BUF 3 local@ + 2 local@ 3 local@ - CLR_TEXT FONT_SIZE DRAW::draw-string
    ] ?
    drop ( len )
    4 unframe!
;

@draw-selection ( -- )
    sel-active? [
        sel-lo dup rc-from-idx 3 frame! ( 0:c 1:r 2:i )
        [ 2 local@ sel-hi < ] [
            1 local@ scroll-y LOADI - ( rel_r )
            dup 0 >= OVER VISIBLE_LINES < AND [
                APP::draw-fd
                1 local@ line-at 2 local@ span-w PANE_X +
                rot LINE_H * PANE_Y +
                FILE_BUF 2 local@ + load-byte ch-advance
                dup 0 = [ drop 1 ] ?
                LINE_H CLR_SEL DRAW::fill-rect
            ] [ drop ] ?:
            2 local@ 1 + 2 local!
            1 local@ 1 + line-count LOADI < [
                2 local@ 1 local@ 1 + line-at = [
                    1 local@ 1 + 1 local!
                    0 0 local!
                ] [
                    0 local@ 1 + 0 local!
                ] ?:
            ] [
                0 local@ 1 + 0 local!
            ] ?:
        ] |: 3 unframe!
    ] ?
;

@draw-hex-caret ( -- )
    cursor LOADI 16 / scroll-y LOADI - ( rel_r )
    dup 0 >= OVER VISIBLE_LINES < AND [
        LINE_H * PANE_Y +
        cursor LOADI 16 / 16 *
        cursor LOADI 16 MOD
        cursor LOADI hex-byte-at
        4 frame! ( 0:b 1:col 2:row-addr 3:y )
        2 local@ 1 local@ hex-col-x
        0 local@ 4 SHR 15 AND nibble-to-hex
        hex-nibble LOADI [
            ch-advance +
            0 local@ 15 AND nibble-to-hex
        ] ?
        ( x nibble-ch )
        dup ch-advance
        ( x nibble-ch w )
        swap drop
        ( x w )
        3 local@ swap CARET_H CLR_HEX_CARET draw-rect-outline
        2 local@ 1 local@ hex-ascii-col-x
        0 local@ hex-ascii-ch ch-advance
        3 local@ swap CARET_H CLR_HEX_CARET draw-rect-outline
        4 unframe!
    ] [ drop ] ?:
;

@layout-and-render ( -- )
    hex-mode LOADI 1 = [
        scroll-y LOADI 16 * ( start_idx )
        [ dup file-len LOADI <= ] [
            dup 16 / scroll-y LOADI - ( rel_r )
            dup 0 >= OVER VISIBLE_LINES < AND [
                OVER swap 2 frame! ( 0:rel_r 1:idx )
                1 local@ render-hex-row
                APP::draw-fd PANE_X 0 local@ LINE_H * PANE_Y + HEX_LINE_BUF 72 CLR_TEXT FONT_SIZE DRAW::draw-string
                2 unframe!
            ] [
                VISIBLE_LINES >= [ drop file-len LOADI 1 + ] [ drop ] ?:
            ] ?:
            16 +
        ] |:
        drop
        draw-hex-caret
    ] [
        0 0 0 0 4 frame! ( 0:r 1:start 2:end 3:draw-end )
        scroll-y LOADI 0 MAX 0 local!
        [ 0 local@ line-count LOADI <
          0 local@ scroll-y LOADI - VISIBLE_LINES < AND ]
        [
            0 local@ line-at 1 local!
            0 local@ line-end-at 2 local!
            2 local@ 3 local!
            3 local@ 1 local@ > [
                FILE_BUF 3 local@ 1 - + load-byte 10 = [
                    3 local@ 1 - 3 local!
                ] ?
            ] ?
            1 local@ 3 local@ PANE_X
            0 local@ scroll-y LOADI - LINE_H * PANE_Y +
            flush-seg
            cursor LOADI 1 local@ >= [
                cursor LOADI 2 local@ <
                cursor LOADI file-len LOADI = 2 local@ file-len LOADI = AND
                OR [
                    1 local@ cursor LOADI 3 local@ MIN span-w PANE_X + caret-x STOREI
                    0 local@ scroll-y LOADI - LINE_H * PANE_Y + caret-y STOREI
                ] ?
            ] ?
            0 local@ 1 + 0 local!
        ] |:
        4 unframe!
        cursor LOADI rc-from-idx drop scroll-y LOADI -
        dup 0 >= OVER VISIBLE_LINES < AND [
            drop caret-x LOADI caret-y LOADI draw-caret
        ] [ drop ] ?:
    ] ?:
;

@path-basename ( -- ptr ) DOC::path STR::basename ;

@draw-status-line ( -- )
    APP::draw-fd 0 PANE_Y PANE_H + WIN_W STATUS_H 0xEEEEEE DRAW::fill-rect
    APP::draw-fd 0 PANE_Y PANE_H + WIN_W 1 CLR_FRAME DRAW::draw-rect

    path-basename STATUS_BUF STR::strcpy
    STATUS_BUF STR::strlen 40 > [
        0 STATUS_BUF 40 + store-byte
    ] ?
    DOC::dirty? [
        T" *" STATUS_BUF STATUS_BUF STR::strlen + STR::strcpy
    ] ?
    T"  " STATUS_BUF STATUS_BUF STR::strlen + STR::strcpy
    cursor LOADI rc-from-idx 1 + swap 1 + swap 2 frame! ( 0:c 1:r )
    1 local@ STATUS_BUF STATUS_BUF STR::strlen + STR::int-to-str
    T":" STATUS_BUF STATUS_BUF STR::strlen + STR::strcpy
    0 local@ STATUS_BUF STATUS_BUF STR::strlen + STR::int-to-str
    2 unframe!
    APP::draw-fd 4 PANE_Y PANE_H + 5 + STATUS_BUF CLR_TEXT FONT_SIZE DRAW::draw-str
;

@save-bytes ( p -- )
    1 frame! ( 0:p )
    file-fd LOADI 0 >= [ file-fd LOADI VFS::close drop -1 file-fd STOREI ] ?
    0 local@ VFS_PATH_BUF VFS::sys-file
    dup 2 VFS::open-mode
    dup 0 < [
        drop 6 VFS::open-mode
    ] [ swap drop ] ?:
    dup 0 >= [
        file-fd STOREI
        file-len LOADI total-size STOREI
    ] [ drop ] ?:
    save-current-chunk
    1 needs-redraw STOREI
    1 unframe!
;

@reset-doc ( -- )
    file-fd LOADI 0 >= [ file-fd LOADI VFS::close drop -1 file-fd STOREI ] ?
    0 file-len STOREI 0 cursor STOREI -1 anchor STOREI
    0 file-offset STOREI 0 total-size STOREI 0 orig-chunk-len STOREI
    0 hex-nibble STOREI 0 scroll-y STOREI
    rebuild-lines
    1 needs-redraw STOREI
;

@load-bytes ( p -- )
    1 frame! ( 0:p )
    file-fd LOADI 0 >= [ file-fd LOADI VFS::close drop ] ?
    0 local@ VFS_PATH_BUF VFS::sys-file 2 VFS::open-mode file-fd STOREI
    file-fd LOADI 0 >= [
        file-fd LOADI VFS::stat total-size STOREI
        0 file-offset STOREI
        file-fd LOADI FILE_BUF CHUNK_SIZE VFS::read
        dup file-len STOREI
        dup orig-chunk-len STOREI
        0 cursor STOREI 0 scroll-y STOREI -1 anchor STOREI 0 hex-nibble STOREI
        rebuild-lines
    ] [
        0 total-size STOREI 0 file-len STOREI 0 orig-chunk-len STOREI -1 file-fd STOREI
        rebuild-lines
    ] ?:
    1 needs-redraw STOREI
    1 unframe!
;

@refresh-text-pane ( -- )
    1 needs-redraw STOREI
;

@refresh ( -- )
    APP::draw-fd 0 0 WIN_W WIN_H CLR_BG DRAW::fill-rect
    APP::draw-fd MARGIN 1 - PANE_Y 1 - PANE_W 2 + PANE_H 2 + CLR_FRAME DRAW::draw-rect
    sync-bar
    APP::use-text-font
    draw-selection layout-and-render
    APP::draw-fd DRAW::CHICAGO DRAW::set-font
    draw-status-line
    UI::draw
    SF::open? [ SF::draw ] ?
    DIALOG::draw
    0 needs-redraw STOREI
;

@ensure-visible ( -- )
    cursor LOADI rc-from-idx drop ( r )
    dup scroll-y LOADI < [ scroll-y STOREI ] [
        dup scroll-y LOADI VISIBLE_LINES + >= [ VISIBLE_LINES - 1 + scroll-y STOREI ] [ drop ] ?:
    ] ?:
;

( --- Interaction --- )

@on-mouse ( mpkt -- )
    DIALOG::open? [
        DIALOG::mouse
    ] [
    SF::open? [
        SF::mouse
    ] [
        dup EVENT::mouse-type EVENT::MOUSE_DOWN = [
            1 mouse-held STOREI
        ] ?
        dup EVENT::mouse-type EVENT::MOUSE_UP = [
            0 mouse-held STOREI
        ] ?

        UI::menu-open?
        get-abs-scroll-y
        cursor LOADI
        3 frame! ( 0:old-c 1:old-abs-sy 2:old-open )

        dup UI::feed

        2 local@ UI::menu-open? OR 0 =
        UI::SBAR_DRAG LOADI 0 = AND [
            dup EVENT::mouse-x sb-x < [
                dup EVENT::mouse-y PANE_Y >=
                OVER EVENT::mouse-y PANE_Y PANE_H + < AND [
                    dup EVENT::mouse-type EVENT::MOUSE_DOWN = [
                        hex-mode LOADI [
                            dup EVENT::mouse-x OVER EVENT::mouse-y find-index-by-xy cursor STOREI
                            0 hex-nibble STOREI
                            check-lazy-load
                        ] [
                            dup EVENT::mouse-x OVER EVENT::mouse-y find-index-by-xy
                            dup cursor STOREI
                            anchor STOREI
                            check-lazy-load
                        ] ?:
                    ] ?
                    dup EVENT::mouse-type EVENT::MOUSE_MOVE = mouse-held LOADI 1 = AND hex-mode LOADI 0 = AND [
                        dup EVENT::mouse-x OVER EVENT::mouse-y find-index-by-xy cursor STOREI
                        check-lazy-load
                    ] ?
                ] ?
            ] ?
        ] ?

        ensure-visible

        cursor LOADI 0 local@ = 0 =
        get-abs-scroll-y 1 local@ = 0 = OR
        UI::menu-open? 2 local@ = 0 = OR
        UI::menu-open? OR
        [ 1 needs-redraw STOREI ] ?

        3 unframe!
        drop
    ] ?:
    ] ?:
;

@handle-cmd ( key mods -- )
    2 frame! ( 0:mods 1:key )
    1 local@ 32 OR
    dup 99 = [ drop snarf-selection ] [
    dup 120 = [ drop menu-cut ] [
    dup 118 = [ drop paste-snarf ] [
    dup 115 = [
        drop
        0 local@ EVENT::MOD_SHIFT AND [
            DOC::menu-save-as
        ] [
            DOC::menu-save
        ] ?:
    ] [
    dup 97 = [ drop select-all ] [
    drop
    ] ?: ] ?: ] ?: ] ?: ] ?:
    2 unframe!
;

@on-kbd ( kpkt -- )
    DIALOG::open? [
        DIALOG::kbd
    ] [
    SF::open? [
        SF::kbd
    ] [
        dup EVENT::kbd-type EVENT::KEY_DOWN = [
            1 needs-redraw STOREI
            cursor LOADI prev-cursor STOREI
            dup EVENT::kbd-key EVENT::KEY_ESC = [
                UI::escape drop
                drop
            ] [
            dup EVENT::kbd-mods
            over EVENT::kbd-key
            2 frame! ( 0:key 1:mods )
            1 local@ EVENT::MOD_CMD EVENT::MOD_CTRL OR AND 0 = 0 =
            0 local@ 32 OR dup 97 >= SWAP 122 <= AND AND [
                0 local@ 1 local@ handle-cmd
            ] [
                0 local@ EVENT::KEY_BACKSPACE = [
                    sel-or-delete
                ] [
                0 local@ EVENT::KEY_ENTER = [
                    10 type-char
                ] [
                0 local@ EVENT::KEY_TAB = [
                    T"    " 4 type-bytes
                ] [
                0 local@ EVENT::KEY_LEFT_ARROW = [
                    1 local@ go-left
                ] [
                0 local@ EVENT::KEY_RIGHT_ARROW = [
                    1 local@ go-right
                ] [
                0 local@ EVENT::KEY_UP_ARROW = [
                    1 local@ go-up
                ] [
                0 local@ EVENT::KEY_DOWN_ARROW = [
                    1 local@ go-down
                ] [
                0 local@ EVENT::KEY_PAGE_UP = [
                    1 local@ go-page-up
                ] [
                0 local@ EVENT::KEY_PAGE_DOWN = [
                    1 local@ go-page-down
                ] [
                0 local@ EVENT::KEY_HOME = [
                    1 local@ go-home
                ] [
                0 local@ EVENT::KEY_END = [
                    1 local@ go-end
                ] [
                0 local@ hex-digit-value dup 0 >= hex-mode LOADI AND [
                    cursor LOADI file-len LOADI < [
                        edit-hex-nibble
                    ] [ drop ] ?:
                ] [
                    drop
                    0 local@ STR::printable? [
                        0 local@ type-char
                    ] ?
                ] ?:
                ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
            ] ?:
            0 local@ EVENT::KEY_UP_ARROW =
            0 local@ EVENT::KEY_DOWN_ARROW = OR
            0 local@ EVENT::KEY_PAGE_UP = OR
            0 local@ EVENT::KEY_PAGE_DOWN = OR
            0 = [
                cursor LOADI rc-from-idx swap drop target-col STOREI
            ] ?
            2 unframe!
            cursor LOADI prev-cursor LOADI = 0 = [ 0 hex-nibble STOREI ] ?
            check-lazy-load
            ensure-visible
            sync-bar
            ] ?:
        ] ? drop
    ] ?:
    ] ?:
;

( --- Snarf & File I/O --- )

@snarf-selection ( -- )
    sel-active? [
        FILE_BUF sel-lo + sel-hi sel-lo - VFS::snarf-write drop
    ] ?
;

@paste-snarf ( -- )
    hex-mode LOADI [ ] [
        PASTE_BUF PASTE_MAX VFS::snarf-read
        dup 0 > [
            PASTE_BUF swap type-bytes
            1 needs-redraw STOREI
            ensure-visible
            cursor LOADI rc-from-idx swap drop target-col STOREI
        ] [ drop ] ?:
    ] ?:
;

( --- Menus --- )
@menu-cut ( -- )
    hex-mode LOADI [ ] [
        sel-active? [ snarf-selection delete-selection 1 needs-redraw STOREI ] ?
    ] ?:
;
@menu-copy ( -- )
    hex-mode LOADI [ ] [ snarf-selection ] ?:
;
@menu-select-all ( -- )
    hex-mode LOADI [ ] [ select-all 1 needs-redraw STOREI ] ?:
;

@toggle-hex ( val -- )
    hex-mode STOREI
    0 hex-nibble STOREI
    -1 anchor STOREI
    T"Toggle Hex" hex-mode LOADI UI::item-set
    1 needs-redraw STOREI
    cursor LOADI rc-from-idx swap drop target-col STOREI
;

@on-frame ( -- )
    UI::handle
    APP::dirty? [ 1 needs-redraw STOREI ] ?
    needs-redraw LOADI [
        refresh
        APP::dirty-off
    ] [
        UI::draw
        SF::open? [ SF::draw ] ?
        DIALOG::draw
    ] ?:
;

( --- Main --- )

@on-font ( id -- )
    drop
    APP::use-text-font
    T"/sys/font/widths" VFS::open dup 0 >= [
        dup FONT_DATA 256 VFS::read drop VFS::close drop
    ] [ drop ] ?:
    FONT_DATA 65 + load-byte FONT_SIZE * 16 / char-w-val STOREI
    rebuild-lines
    1 needs-redraw STOREI
;

@start
    T"Quill" APP::init
    APP::grayscale!
    APP::draw-fd FONT_SIZE DRAW::set-font-size
    PANE_H LINE_H / VISIBLE_LINES-VAL STOREI
    
    UI::new
    WIN_W UI::menubar
    T"Quill" T"new.quill" DOC::init
    $load-bytes DOC::on-load!
    $save-bytes DOC::on-save!
    $reset-doc  DOC::on-new!
    $menu-cut        DOC::on-cut!
    $menu-copy       DOC::on-copy!
    $paste-snarf     DOC::on-paste!
    $menu-select-all DOC::on-select-all!
    DOC::file-menu
    DOC::edit-menu
    T"View" UI::menu
    T"Toggle Hex" [ toggle-hex ] UI::check-item
    T"Toggle Hex" 0 UI::item-set
    [ on-font ] APP::font-hook!
    APP::font-menu
    T"V" sb-x PANE_Y SB_W PANE_H 0 0 0 [ on-scroll ] UI::vscroll
    T"V" UI::comp-find UI::C_PAY + LOADI sb-bar STOREI
    VISIBLE_LINES sb-bar LOADI UI::BAR_PAGE + STOREI

    T"manuscript.quill" DOC::pick
    0 cursor STOREI 0 scroll-y STOREI -1 anchor STOREI 0 drag STOREI 0 mouse-held STOREI 0 hex-nibble STOREI
    1 needs-redraw STOREI
    
    [ on-mouse ] APP::on-mouse!
    [ on-kbd ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    [ refresh ] APP::on-resume!
    APP::loop
;
MAIN::start
HALT
