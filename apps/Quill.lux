( --- Quill: minimal Plan9-style text editor (Refactored) --- )

INCLUDE "lib/app.lux"
INCLUDE "lib/core.lux"
INCLUDE "lib/time.lux"
INCLUDE "lib/file.lux"
INCLUDE "lib/str.lux"
INCLUDE "lib/ui.lux"
INCLUDE "lib/menu.lux"

MODULE MAIN

IMPORT APP
IMPORT VFS
IMPORT DRAW
IMPORT TIME
IMPORT FILE
IMPORT EVENT
IMPORT STR
IMPORT UI
IMPORT MENU

( --- Window geometry (matches Shell's 960x720 child window) --- )
@WIN_W      960 ;
@WIN_H      720 ;
@BAR_H      20 ;
@MARGIN     16 ;
@PANE_X     16 ;        ( MARGIN )
@PANE_Y     36 ;        ( BAR_H + MARGIN )
@PANE_H     668 ;       ( WIN_H - BAR_H - 2*MARGIN )
@PANE_BOT   704 ;       ( PANE_Y + PANE_H )
@LINE_H     26 ;
@FONT_SIZE  18 ;
@COLUMNS    80 ;

@CLR_BG     0xFFFFFF ;
@CLR_FRAME  0xAAAAAA ;
@CLR_TEXT   0x000000 ;
@CLR_CARET  0xCC0000 ;
@CLR_SEL    0xCCDDFF ;

( --- Memory layout --- )
@FILE_BUF       0x800000 ;
@FILE_BUF_MAX   0x100000 ;
@FONT_DATA      0x900000 ;
@FONT_BYTES     8448 ;
@MENU_DATA      0x920000 ;
@PASTE_BUF      0xA00000 ;
@PASTE_MAX      0x10000 ;

( --- State --- )
( NOTE: must live OUTSIDE the FONT_DATA range or CFF load clobbers state. )
@file-len   0x910010 ;
@dirty      0x910014 ;
@cursor     0x910018 ;   ( byte index into FILE_BUF )
@last-key   0x910024 ;   ( unix seconds, for autosave debounce )
@caret-x    0x910034 ;
@caret-y    0x910038 ;
@target-col 0x91003C ;
@anchor     0x910040 ;   ( selection anchor; -1 = no selection )
@drag       0x910044 ;   ( 1 if mouse-drag selection in progress )
@frame-count      0x910048 ;
@last-click-frame 0x91004C ;
@last-click-idx   0x910050 ;
@char-w-val       0x910054 ;

( --- Menu Structure --- )
@MB_ADDR        @MENU_DATA ;

@menu-new ( -- )
    0 file-len STOREI
    0 cursor STOREI
    0 dirty STOREI
    -1 anchor STOREI
    refresh
;

@menu-quit ( -- ) HALT ;

@menu-cut ( -- )
    sel-active? [
        snarf-selection
        delete-selection
        refresh
    ] ?
;

@MI_FILE ( i -- label shortcut callback )
    dup 0 = [ drop T"New"  0 [ menu-new ]  ] [
    dup 1 = [ drop T"Save" 0 [ save-file ] ] [
    dup 2 = [ drop T"Quit" 0 [ menu-quit ] ] [
    drop 0 0 0 ] ?: ] ?: ] ?:
;

@MN_FILE ( -- label items_quot count )
    T"File" [ MI_FILE ] 3
;

@MI_EDIT ( i -- label shortcut callback )
    dup 0 = [ drop T"Cut"   0 [ menu-cut ]        ] [
    dup 1 = [ drop T"Snarf" 0 [ snarf-selection ] ] [
    dup 2 = [ drop T"Paste" 0 [ paste-snarf ]     ] [
    drop 0 0 0 ] ?: ] ?: ] ?:
;

@MN_EDIT ( -- label items_quot count )
    T"Edit" [ MI_EDIT ] 3
;

@MENUS ( i -- menu_quot )
    dup 0 = [ drop [ MN_FILE ] ] [
    dup 1 = [ drop [ MN_EDIT ] ] [
    drop 0 ] ?: ] ?:
;

@init-menus ( -- )
    -1 MB_ADDR MENU::MB_ACTIVE + STOREI
    -1 MB_ADDR MENU::MB_HOVER  + STOREI
;

( --- Font width lookup --- )
( Using the fixed width of 'A' from /sys/font/widths after mono selection. )
@char-w ( -- w )
    char-w-val LOADI
;

@PANE_W ( -- w )
    char-w COLUMNS *
;

@PANE_RIGHT ( -- x )
    PANE_X PANE_W +
;

( --- Buffer manipulation --- )

@insert-char ( ch -- )
    cursor LOADI FILE_BUF +
    cursor LOADI FILE_BUF + 1 +
    file-len LOADI cursor LOADI -
    MEMORY::move-mem
    FILE_BUF cursor LOADI + store-byte
    file-len LOADI 1 + file-len STOREI
    cursor LOADI 1 + cursor STOREI
    1 dirty STOREI
;

@delete-char ( -- )
    cursor LOADI 0 > [
        cursor LOADI FILE_BUF +
        cursor LOADI FILE_BUF + 1 -
        file-len LOADI cursor LOADI -
        MEMORY::move-mem
        file-len LOADI 1 - file-len STOREI
        cursor LOADI 1 - cursor STOREI
        1 dirty STOREI
    ] ?
;

@cursor-left ( -- )
    cursor LOADI 0 > [ cursor LOADI 1 - cursor STOREI ] ?
    cursor LOADI rc-from-idx swap drop target-col STOREI
;

@cursor-right ( -- )
    cursor LOADI file-len LOADI < [ cursor LOADI 1 + cursor STOREI ] ?
    cursor LOADI rc-from-idx swap drop target-col STOREI
;

( --- Selection (Plan9-style snarf range) --- )

@sel-clear ( -- )
    -1 anchor STOREI
;

@sel-active? ( -- flag )
    anchor LOADI -1 = 0 =              ( anchor != -1 )
    anchor LOADI cursor LOADI = 0 =    ( anchor != cursor )
    AND
;

@sel-lo ( -- idx )
    cursor LOADI anchor LOADI MIN
;

@sel-hi ( -- idx )
    cursor LOADI anchor LOADI MAX
;

@delete-range ( lo hi -- )
    2 frame! ( 0:hi 1:lo )
    FILE_BUF 0 local@ +                     ( src = FILE_BUF+hi )
    FILE_BUF 1 local@ +                     ( dst = FILE_BUF+lo )
    file-len LOADI 0 local@ -               ( count = file-len - hi )
    MEMORY::move-mem
    file-len LOADI 0 local@ - 1 local@ + file-len STOREI
    1 local@ cursor STOREI
    sel-clear
    1 dirty STOREI
    2 unframe!
;

@delete-selection ( -- )
    sel-active? [ sel-lo sel-hi delete-range ] ?
;

@insert-bytes ( src n -- )
    2 frame! ( 0:n 1:src )
    ( shift FILE_BUF[cursor..file-len] right by n )
    FILE_BUF cursor LOADI +                 ( src )
    FILE_BUF cursor LOADI + 0 local@ +      ( dst )
    file-len LOADI cursor LOADI -           ( count )
    MEMORY::move-mem
    ( copy src bytes into FILE_BUF[cursor..] )
    1 local@                                 ( src )
    FILE_BUF cursor LOADI +                  ( dst )
    0 local@                                 ( count )
    MEMORY::move-mem
    file-len LOADI 0 local@ + file-len STOREI
    cursor LOADI 0 local@ + cursor STOREI
    1 dirty STOREI
    2 unframe!
;

( --- Rendering --- )

@draw-caret ( x y -- )
    APP::draw-fd rot rot 2 LINE_H CLR_CARET DRAW::fill-rect
;

( Emit a single DrawString for FILE_BUF chars in [start, end at pixel x, y.
  No-op when start >= end so trailing flushes on empty lines are safe. )
@flush-seg ( start end x y -- )
    4 frame!   ( 0:y 1:x 2:end 3:start )
    2 local@ 3 local@ -
    dup 0 > [
        APP::draw-fd
        1 local@
        0 local@
        FILE_BUF 3 local@ +
        4 PICK
        CLR_TEXT
        FONT_SIZE
        DRAW::draw-string
        drop
    ] [ drop ] ?:
    4 unframe!
;

@rc-from-idx ( idx -- r c )
    0 0 0 rot 4 frame! ( 0:i 1:r 2:c 3:target-idx )
    [ 0 local@ 3 local@ < ] [
        FILE_BUF 0 local@ + load-byte
        dup 10 = [
            drop
            1 local@ 1 + 1 local!
            0 2 local!
        ] [
            drop
            2 local@ 1 + 2 local!
            2 local@ COLUMNS >= [
                1 local@ 1 + 1 local!
                0 2 local!
            ] ?
        ] ?:
        0 local@ 1 + 0 local!
    ] |:
    1 local@ 2 local@
    4 unframe!
;

@idx-from-rc ( r c -- idx )
    swap 0 0 0 0 6 frame! ( 0:found 1:curr-c 2:curr-r 3:i 4:target-r 5:target-c )
    [ 0 local@ 0 = [ 3 local@ file-len LOADI < ] [ 0 ] ?: ] [
        ( Are we at the target row? )
        2 local@ 4 local@ = [
            ( Are we at or past the target col? )
            1 local@ 5 local@ >= [ 1 0 local! ] ?
            ( If the line ends here, we stop )
            FILE_BUF 3 local@ + load-byte 10 = [ 1 0 local! ] ?
        ] ?

        0 local@ 0 = [
            FILE_BUF 3 local@ + load-byte
            dup 10 = [
                drop
                2 local@ 1 + 2 local!
                0 1 local!
            ] [
                drop
                1 local@ 1 + 1 local!
                1 local@ COLUMNS >= [
                    2 local@ 1 + 2 local!
                    0 1 local!
                ] ?
            ] ?:
            3 local@ 1 + 3 local!
        ] ?
    ] |:
    3 local@
    6 unframe!
;

( Simulate layout to find the character at visual row/col )
@find-index-by-xy ( tx ty -- idx )
    PANE_Y - LINE_H / ( tr )
    swap PANE_X - char-w / ( tc )
    swap idx-from-rc
;

( Paint the selection highlight under the text. Walks the buffer
  using the same wrap/advance rules as layout-and-render. )
@draw-selection ( -- )
    sel-active? [
        sel-lo rc-from-idx ( r c )
        sel-lo 3 frame! ( 0:c 1:r 2:i )
        [ 2 local@ sel-hi < ] [
            FILE_BUF 2 local@ + load-byte
            dup 10 = [
                drop
                APP::draw-fd
                0 local@ char-w * PANE_X +
                1 local@ LINE_H * PANE_Y +
                char-w LINE_H CLR_SEL DRAW::fill-rect
                
                1 local@ 1 + 1 local!
                0 0 local!
            ] [
                drop
                APP::draw-fd
                0 local@ char-w * PANE_X +
                1 local@ LINE_H * PANE_Y +
                char-w LINE_H CLR_SEL DRAW::fill-rect
                
                0 local@ 1 + 0 local!
                0 local@ COLUMNS >= [
                    1 local@ 1 + 1 local!
                    0 0 local!
                ] ?
            ] ?:
            2 local@ 1 + 2 local!
        ] |:
        3 unframe!
    ] ?
;

( --- Snarf (system clipboard) --- )

@snarf-selection ( -- )
    sel-active? [
        T"/sys/snarf" VFS::open dup 0 >= [
            ( fd )
            dup FILE_BUF sel-lo + sel-hi sel-lo - VFS::write drop
            VFS::close drop
        ] [ drop ] ?:
    ] ?
;

@paste-snarf ( -- )
    delete-selection
    T"/sys/snarf" VFS::open dup 0 >= [
        ( fd )
        dup PASTE_BUF PASTE_MAX VFS::read     ( fd n )
        swap VFS::close drop                  ( n )
        dup 0 > [
            PASTE_BUF swap insert-bytes
        ] [ drop ] ?:
        refresh
        cursor LOADI rc-from-idx swap drop target-col STOREI
    ] [ drop ] ?:
;

@layout-and-render ( -- )
    0 0 0 0 4 frame! ( 0:i 1:r 2:c 3:seg-start )
    [ 0 local@ file-len LOADI <= ] [
        ( Capture caret position )
        0 local@ cursor LOADI = [
            2 local@ char-w * PANE_X + caret-x STOREI
            1 local@ LINE_H * PANE_Y + caret-y STOREI
        ] ?

        ( Advance )
        0 local@ file-len LOADI < [
            FILE_BUF 0 local@ + load-byte
            dup 10 = [
                drop
                3 local@ 0 local@
                PANE_X
                1 local@ LINE_H * PANE_Y +
                flush-seg
                1 local@ 1 + 1 local!
                0 2 local!
                0 local@ 1 + 3 local!
            ] [
                drop
                2 local@ 1 + 2 local!
                2 local@ COLUMNS >= [
                    3 local@ 0 local@ 1 +
                    PANE_X
                    1 local@ LINE_H * PANE_Y +
                    flush-seg
                    1 local@ 1 + 1 local!
                    0 2 local!
                    0 local@ 1 + 3 local!
                ] ?
            ] ?:
        ] ?
        0 local@ 1 + 0 local!
    ] |:

    ( Flush the final run, then draw the caret on top. )
    3 local@ file-len LOADI PANE_X 1 local@ LINE_H * PANE_Y + flush-seg
    caret-x LOADI caret-y LOADI draw-caret

    4 unframe!
;

@refresh ( -- )
    APP::draw-fd 0 0 WIN_W WIN_H CLR_BG DRAW::fill-rect

    ( 1px inner frame at margin - 1 )
    APP::draw-fd MARGIN 1 - PANE_Y 1 - PANE_W 2 + PANE_H 2 + CLR_FRAME DRAW::draw-rect
    draw-selection
    layout-and-render

    APP::draw-fd MB_ADDR WIN_W [ MENUS ] 2 MENU::menu-bar-draw
;

( --- File I/O --- )

@save-file ( -- )
    T"manuscript.quill" FILE::name!
    FILE_BUF FILE::buf!
    file-len LOADI FILE::write drop
    0 dirty STOREI
;

( --- Keyboard --- )

@handle-key-core ( keycode -- )
    dup EVENT::KEY_BACKSPACE = [
        drop delete-char refresh
        cursor LOADI rc-from-idx swap drop target-col STOREI
    ] [
        dup EVENT::KEY_TAB = [
            drop 32 insert-char 32 insert-char 32 insert-char 32 insert-char refresh
            cursor LOADI rc-from-idx swap drop target-col STOREI
        ] [
            dup EVENT::KEY_ENTER = [
                drop 10 insert-char refresh
                cursor LOADI rc-from-idx swap drop target-col STOREI
            ] [
                dup EVENT::KEY_UP_ARROW = [
                    drop 
                    cursor LOADI rc-from-idx ( r c )
                    drop 1 - ( r-1 )
                    dup 0 < [ drop 0 ] ?
                    target-col LOADI
                    idx-from-rc cursor STOREI refresh
                ] [
                    dup EVENT::KEY_DOWN_ARROW = [
                        drop 
                        cursor LOADI rc-from-idx ( r c )
                        drop 1 + ( r+1 )
                        target-col LOADI
                        idx-from-rc cursor STOREI refresh
                    ] [
                        dup EVENT::KEY_LEFT_ARROW = [
                            drop cursor-left refresh
                        ] [
                            dup EVENT::KEY_RIGHT_ARROW = [
                                drop cursor-right refresh
                            ] [
                                dup STR::printable? [
                                    insert-char refresh
                                    cursor LOADI rc-from-idx swap drop target-col STOREI
                                ] [
                                    drop
                                ] ?:
                            ] ?:
                        ] ?:
                    ] ?:
                ] ?:
            ] ?:
        ] ?:
    ] ?:
;

( Non-Cmd keyboard handling: Shift+arrow extension, selection-replace
  on edit keys, then dispatch to handle-key-core unless the key was
  fully handled here (e.g. backspace on a live selection). )
@handle-key-normal ( keycode mods -- )
    2 frame! ( 0:mods 1:keycode )
    0   ( handled flag: 0 = pass to core, 1 = consumed here )

    ( --- Arrow keys: shift extends selection, plain clears it --- )
    1 local@ EVENT::KEY_LEFT_ARROW =
    1 local@ EVENT::KEY_RIGHT_ARROW = OR
    1 local@ EVENT::KEY_UP_ARROW    = OR
    1 local@ EVENT::KEY_DOWN_ARROW  = OR [
        0 local@ EVENT::MOD_SHIFT AND 0 = 0 = [
            anchor LOADI -1 = [ cursor LOADI anchor STOREI ] ?
        ] [
            sel-clear
        ] ?:
    ] ?

    ( --- Edit keys on a live selection: replace the range --- )
    sel-active? [
        1 local@ EVENT::KEY_BACKSPACE = [
            delete-selection refresh
            cursor LOADI rc-from-idx swap drop target-col STOREI
            drop 1                          ( mark handled )
        ] [
            1 local@ EVENT::KEY_ENTER = [ delete-selection ] ?
            1 local@ EVENT::KEY_TAB   = [ delete-selection ] ?
            1 local@ STR::printable?    [ delete-selection ] ?
        ] ?:
    ] ?

    ( If not handled, dispatch to the per-key core )
    0 = [ 1 local@ handle-key-core ] ?

    2 unframe!
;

( Top-level keyboard entry. Cmd shortcuts are dispatched here, before
  any frame is opened, so quotation EXITs cannot leave dangling frame
  state in the rest of the word. )
@handle-key ( keycode mods -- )
    dup EVENT::MOD_CMD AND 0 = 0 = [
        drop                                 ( drop mods; keycode on top )
        dup 99 = [
            drop snarf-selection
        ] [
            dup 118 = [
                drop paste-snarf
            ] [
                dup 120 = [
                    drop snarf-selection delete-selection refresh
                    cursor LOADI rc-from-idx swap drop target-col STOREI
                ] [
                    drop                     ( unknown Cmd combo: ignore )
                ] ?:
            ] ?:
        ] ?:
    ] [
        handle-key-normal
    ] ?:
;

@on-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key
        OVER EVENT::kbd-mods
        TIME::unix@ last-key STOREI
        handle-key
    ] ?
    drop
;

( --- Word Boundary Helpers --- )

@is-space? ( ch -- bool )
    dup 32 = OVER 10 = OR OVER 9 = OR swap drop
;

@select-word ( -- )
    cursor LOADI dup 2 frame! ( 0:hi 1:lo )
    
    ( Walk left )
    [ 
        1 local@ 0 > [
            FILE_BUF 1 local@ 1 - + load-byte is-space? 0 =
        ] [ 0 ] ?:
    ] [
        1 local@ 1 - 1 local!
    ] |:
    
    ( Walk right )
    [ 
        0 local@ file-len LOADI < [
            FILE_BUF 0 local@ + load-byte is-space? 0 =
        ] [ 0 ] ?:
    ] [
        0 local@ 1 + 0 local!
    ] |:
    
    1 local@ anchor STOREI
    0 local@ cursor STOREI
    
    2 unframe!
;

( Drag-selection inside the text pane. Mouse down (button 1) sets cursor
  and anchor to the clicked character; mouse move while button is held
  extends by moving the cursor only. Mouse up ends the drag. The menu
  bar still gets first crack at the event. )
@on-mouse ( mpkt -- )
    ( Capture menu state before update )
    MB_ADDR MENU::MB_ACTIVE + LOADI -1 > 1 frame! ( 0:menu-was-open )

    ( Pass to menu bar first )
    MB_ADDR
    OVER EVENT::mouse-x
    2 PICK EVENT::mouse-y
    3 PICK EVENT::mouse-type EVENT::MOUSE_DOWN = [ 1 ] [ 0 ] ?:
    [ MENUS ] 2
    MENU::menu-bar-update

    ( Text-pane drag selection. Only honor events in the editable region. )
    0 local@ 0 = [
        dup EVENT::mouse-y PANE_Y >= [
            dup EVENT::mouse-type EVENT::MOUSE_DOWN = [
                dup EVENT::mouse-x OVER EVENT::mouse-y find-index-by-xy ( idx )
                
                ( Check for double-click )
                frame-count LOADI last-click-frame LOADI - 30 <=
                OVER last-click-idx LOADI = AND [
                    dup cursor STOREI
                    select-word
                    -1 last-click-idx STOREI ( Reset to prevent triple-click doing it again immediately )
                ] [
                    dup cursor STOREI
                    dup anchor STOREI
                    frame-count LOADI last-click-frame STOREI
                    dup last-click-idx STOREI
                    1 drag STOREI
                ] ?:
                drop
            ] ?
            dup EVENT::mouse-type EVENT::MOUSE_MOVE = drag LOADI 1 = AND [
                dup EVENT::mouse-x OVER EVENT::mouse-y find-index-by-xy
                cursor STOREI
            ] ?
            dup EVENT::mouse-type EVENT::MOUSE_UP = [
                0 drag STOREI
                cursor LOADI anchor LOADI = [
                    -1 anchor STOREI
                ] ?
            ] ?
        ] ?
    ] ?

    refresh
    cursor LOADI rc-from-idx swap drop target-col STOREI
    drop
    1 unframe!
;

@on-frame ( -- )
    frame-count LOADI 1 + frame-count STOREI
    ( Autosave after 2s of inactivity )
    dirty LOADI 1 = [
        TIME::unix@ last-key LOADI - 2 >= [
            save-file
        ] ?
    ] ?
;

( --- Main --- )

@start
    ( 0. Set Window Title & Open devices )
    T"Quill" APP::init

    ( 2. Initialize Menus )
    init-menus

    ( 3. Pick font + size on the draw device: 2 = GoMono )
    APP::draw-fd 2 DRAW::set-font
    APP::draw-fd FONT_SIZE DRAW::set-font-size

    ( 4. Load system font widths for the chosen size )
    T"/sys/font/widths" VFS::open dup 0 >= [
        dup FONT_DATA 256 VFS::read drop
        VFS::close drop
    ] [ drop ] ?:

    ( 5. Initialize char-w from 'A' width )
    FONT_DATA 65 + load-byte char-w-val STOREI

    ( 6. Load existing manuscript if present )
    T"manuscript.quill" FILE_BUF 65535 FILE::load
    dup 0 > [ file-len STOREI ] [ drop 0 file-len STOREI ] ?:

    0 cursor STOREI
    0 dirty STOREI
    -1 anchor STOREI
    0 drag STOREI
    0 frame-count STOREI
    -100 last-click-frame STOREI
    -1 last-click-idx STOREI
    TIME::unix@ last-key STOREI

    refresh
    cursor LOADI rc-from-idx swap drop target-col STOREI

    [ on-mouse ] APP::on-mouse!
    [ on-kbd   ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    APP::loop
;

MAIN::start
HALT
