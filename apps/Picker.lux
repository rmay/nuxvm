( Cloister home screen. Two group-box lists, both of SOURCES: Lux on the
  left, Fluxio on the right. Click or Enter writes the path to /sys/launch
  and HALTs; the host compiles it in-process and loads the result -- for a
  .fx that declares externs, linking the UI/SF library in on the way (see
  fx_build_image, src/fluxio_build.c). Quit HALTs with an empty launch
  path. ./bin/cloister )

INCLUDE "lib/app.lux"
INCLUDE "lib/ui.lux"

MODULE PICKER
VERSION 399000

IMPORT APP
IMPORT UI
IMPORT DRAW
IMPORT EVENT
IMPORT STR
IMPORT VFS

( MM_APP_SMALL_STATE / MM_APP_BULK_BUFFER )
RESERVE focus 4 ;
RESERVE raw 4096 ;
RESERVE tok 256 ;
RESERVE path 256 ;

@LUX T"Lux" ;
@FX  T"Fluxio" ;

@cat ( src dest -- )
    dup STR::strlen + STR::strcpy
;

@ends-with { str suf -- f }
    str STR::strlen suf STR::strlen { n sn }
        n sn < [
            0
        ] [
            str n sn - + suf STR::streq
        ] ?:
    UNGIRD
;

@skip-name? { name -- f }
    name T"Picker.lux" STR::streq
    name T"Picker.bin" STR::streq OR
    name T"Shell.lux" STR::streq OR
    name T"Shell.bin" STR::streq OR
;

@copy-tok ( src dest -- )
    2 frame! ( 0:dest 1:src )
    [ 1 local@ load-byte dup 10 <> SWAP 0 <> AND ] [
        1 local@ load-byte 0 local@ store-byte
        1 local@ 1 + 1 local!
        0 local@ 1 + 0 local!
    ] |:
    0 0 local@ store-byte
    2 unframe!
;

@next-tok ( src -- src' )
    [ dup load-byte dup 10 <> SWAP 0 <> AND ] [ 1 + ] |:
    dup load-byte 10 = [ 1 + ] ?
;

@read-dir ( dir -- )
    VFS::open
    dup 0 > [
        dup raw 4095 VFS::read
        0 raw 2 PICK + store-byte
        drop
        VFS::close drop
    ] [
        drop
        0 raw store-byte
    ] ?:
;

@fill-ext { list ext -- }
    raw { p }
        [ p load-byte 0 > ]
        [
            p tok copy-tok
            tok skip-name? [
            ] [
                tok ext ends-with [
                    list tok UI::list-add
                ] ?
            ] ?:
            p next-tok p!
        ] |:
    UNGIRD
;

@fill-lists ( -- )
    LUX UI::list-clear
    FX UI::list-clear
    T"/sys/dir/apps" read-dir
    LUX T".lux" fill-ext
    T"/sys/dir/apps/fluxio" read-dir
    FX T".fx" fill-ext
    LUX UI::list-count 0 > [ LUX 0 UI::list-sel! ] ?
    FX UI::list-count 0 > [ FX 0 UI::list-sel! ] ?
    0 focus STOREI
    LUX UI::list-active
;

@launch ( p -- )
    1 frame! ( 0:p )
    T"/sys/launch" VFS::open
    dup 0 > [
        dup 0 local@ 0 local@ STR::strlen VFS::write drop
        VFS::close drop
        HALT
    ] [
        drop
    ] ?:
    1 unframe!
;

@run-from { name prefix -- }
    name UI::list-sel@
    dup 0 < [
        drop
    ] [
        name SWAP UI::list-item@
        dup 0 = [
            drop
        ] [
            prefix path STR::strcpy
            path cat
            path launch
        ] ?:
    ] ?:
;

@pfx ( -- ptr )
    focus LOADI [ T"apps/fluxio/" ] [ T"apps/" ] ?:
;

@on-lux ( idx -- ) drop LUX T"apps/" run-from ;
@on-fx  ( idx -- ) drop FX T"apps/fluxio/" run-from ;
@on-quit ( val -- ) drop HALT ;

( --- About Cloister --- )

RESERVE about-open 4 ;

@ABOUT_W 340 ;
@ABOUT_H 260 ;
@OK_W     80 ;
@OK_H     20 ;
@TITLE_H  18 ;
@CLOSE_SZ 11 ;

@about-x ( -- x ) APP::width ABOUT_W - 2 / ;
@about-y ( -- y ) APP::height ABOUT_H - 2 / ;
@ok-x    ( -- x ) about-x ABOUT_W OK_W - 2 / + ;
@ok-y    ( -- y ) about-y ABOUT_H + 36 - ;
@close-x ( -- x ) about-x 8 + ;
@close-y ( -- y ) about-y 3 + ;

@about-close ( val -- )
    drop
    0 about-open STOREI
    0 APP::modal!
    UI::overlay-clear
;

@about-build ( -- )
    UI::overlay-clear
    T"OK" ok-x ok-y OK_W OK_H [ about-close ] UI::overlay-button
    T"OK" UI::overlay-default
;

@on-about ( val -- )
    drop
    1 about-open STOREI
    1 APP::modal!
    about-build
;

@about-hit-close ( mx my -- f )
    close-x close-y CLOSE_SZ CLOSE_SZ UI::in-rect?
;

@about-mouse ( mpkt -- )
    1 frame! ( 0:mpkt )
    0 local@ UI::overlay-feed
    UI::overlay-handle
    0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
        0 local@ EVENT::mouse-x 0 local@ EVENT::mouse-y about-hit-close [
            0 about-close
        ] ?
    ] ?
    1 unframe!
;

@about-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key
        dup EVENT::KEY_ESC = [
            drop 0 about-close
        ] [
            dup EVENT::KEY_ENTER = [
                drop 0 about-close
            ] [
                drop
            ] ?:
        ] ?:
    ] ?
    drop
;

@about-line ( ptr y -- )
    2 frame! ( 0:y 1:ptr )
    DRAW::fd about-x 24 + 0 local@ 1 local@ UI::CLR_TEXT 16 DRAW::draw-str
    2 unframe!
;

@about-title ( -- )
    0 1 frame! ( 0:x )
    T"About Cloister" DRAW::str-w ABOUT_W SWAP - 2 / about-x + 0 local!
    DRAW::fd 0 local@ about-y 3 + T"About Cloister" DRAW::str-w 12 UI::CLR_BG DRAW::paint-rect
    DRAW::fd 0 local@ 8 + about-y 3 + T"About Cloister" UI::CLR_TEXT 16 DRAW::draw-str
    1 unframe!
;

@about-draw ( -- )
    about-open LOADI [
        DRAW::fd DRAW::CHICAGO DRAW::set-font
        DRAW::fd 0 0 APP::width APP::height UI::CLR_BORDER 0 DRAW::fill-pat
        DRAW::fd about-x 2 + about-y 2 + ABOUT_W ABOUT_H UI::CLR_BORDER DRAW::paint-rect
        DRAW::fd about-x about-y ABOUT_W ABOUT_H UI::CLR_BORDER DRAW::paint-rect
        DRAW::fd about-x 1 + about-y 1 + ABOUT_W 2 - ABOUT_H 2 - UI::CLR_BG DRAW::paint-rect
        DRAW::fd about-x 1 + about-y 1 + ABOUT_W 2 - TITLE_H 2 - UI::CLR_BG DRAW::paint-rect
        DRAW::fd about-x 1 + about-y 1 + ABOUT_W 2 - TITLE_H 2 - UI::CLR_BORDER 1 DRAW::fill-pat
        DRAW::fd about-x about-y TITLE_H + 1 - ABOUT_W 1 UI::CLR_BORDER DRAW::paint-rect
        DRAW::fd close-x close-y CLOSE_SZ CLOSE_SZ UI::CLR_BG DRAW::paint-rect
        DRAW::fd close-x close-y CLOSE_SZ CLOSE_SZ UI::CLR_BORDER DRAW::frame-rect
        DRAW::fd close-x 2 + close-y 2 + 7 7 UI::CLR_BORDER DRAW::frame-rect
        about-title
        T"Cloister"                    about-y 40 + about-line
        T"A single-app fantasy machine" about-y 62 + about-line
        T"NUX virtual machine"         about-y 88 + about-line
        T"Lux and Fluxio guest programs" about-y 106 + about-line
        T"Plan 9 files, System 6 look" about-y 124 + about-line
        T"This isn't the future promised, but we persist." about-y 154 + about-line
        T"Authors: Russell May and AI Agents" about-y 172 + about-line
        UI::overlay-draw
    ] ?
;

@focused ( -- name )
    focus LOADI [ FX ] [ LUX ] ?:
;

@on-mouse ( mpkt -- )
    about-open LOADI [
        about-mouse
    ] [
        UI::feed
    ] ?:
;

@on-kbd ( kpkt -- )
    about-open LOADI [
        about-kbd
    ] [
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key
        dup EVENT::KEY_ESC = [
            drop drop
            UI::escape drop
        ] [
        dup EVENT::KEY_ENTER = [
            drop drop
            focused pfx run-from
        ] [
        dup EVENT::KEY_UP_ARROW = [
            drop drop
            focused { name }
                name UI::list-sel@
                dup 0 > [ 1 - ] [ drop 0 ] ?:
                name SWAP UI::list-sel!
            UNGIRD
        ] [
        dup EVENT::KEY_DOWN_ARROW = [
            drop drop
            focused { name }
                name UI::list-count { n }
                    n 0 = [
                    ] [
                        name UI::list-sel@ 1 +
                        dup n >= [ drop n 1 - ] ?
                        name SWAP UI::list-sel!
                    ] ?:
                UNGIRD
            UNGIRD
        ] [
        dup EVENT::KEY_LEFT_ARROW = [
            drop drop
            0 focus STOREI
            LUX UI::list-active
        ] [
        dup EVENT::KEY_RIGHT_ARROW = [
            drop drop
            1 focus STOREI
            FX UI::list-active
        ] [
            drop drop
        ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
    ] [
        drop
    ] ?:
    ] ?:
;

@on-frame ( -- )
    UI::handle
    DRAW::fd 0 0 APP::width APP::height UI::CLR_DESK DRAW::paint-rect
    UI::draw
    about-draw
;

@start
    T"Cloister" APP::init
    APP::grayscale!
    UI::new
    APP::width UI::menubar
    T"Cloister" UI::menu
    T"About Cloister" [ on-about ] UI::item
    UI::sep
    T"Quit" [ on-quit ] UI::item
    T"Select a program    Enter or click to run" 40 36 UI::label
    LUX 40 64 430 600 [ on-lux ] UI::list
    FX  490 64 430 600 [ on-fx ] UI::list
    fill-lists
    [ on-mouse ] APP::on-mouse!
    [ on-kbd ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    APP::loop
;

PICKER::start
HALT
