( Easel: a MacPaint clone in progress -- see easel_plan.md for the full plan.
  File > New/Open/Save/Save As | Quit, Edit > Undo / Cut / Copy / Paste /
  Invert / Clear / Fill / Trace Edges / Flip H / Flip V / Rotate 90,
  Goodies > Grid / FatBits / Edit Pattern / Brush Shape. 20-tool palette (14
  wired so far, including Marquee/Lasso selection), 38 pattern slots (all
  filled in), 32 preset brush shapes (double-click the Brush tool, or
  Goodies > Brush Shape...), pen-width strip driving line/rect/roundrect/
  oval outline thickness. Canvas is 480x416, 1-bit, in a 560x492 window
  (geometry sized to the tools, not a
  fixed window size). Save is EAS1.
  ./bin/cloister apps/Easel.bin )

INCLUDE "lib/app.lux"
INCLUDE "lib/core.lux"
INCLUDE "lib/str.lux"
INCLUDE "lib/ui.lux"
INCLUDE "lib/sf.lux"
INCLUDE "lib/geom.lux"
INCLUDE "lib/bitmap.lux"
INCLUDE "lib/time.lux"

MODULE MAIN
VERSION 500000

IMPORT APP
IMPORT VFS
IMPORT DRAW
IMPORT EVENT
IMPORT STR
IMPORT UI
IMPORT SF
IMPORT GEOM
IMPORT BITMAP
IMPORT TIME

( --- Geometry: sized for the full 20-tool / 38-pattern layout to be
  comfortable at its own natural size, then the window fits that -- not the
  other way around (the 512x342 authentic-MacPaint size was tried first and
  came out cramped, so it's gone; see easel_plan.md for the tool/pattern
  content this still follows). All the *_CELL_* sizes below are the actual
  free variables; WIN_W/WIN_H/PAT_Y/etc. are derived from them. )
@BAR_H          20 ; ( menu bar height )
@PAL_X           0 ;
@PAL_CELL_W     40 ;
@PAL_CELL_H     32 ;
@PAL_W          PAL_CELL_W 2 * ; ( 2 cols )
@PAL_Y          BAR_H ;
@TOOLS          20 ; ( 2 cols x 10 rows )
@LW_ROWS         6 ;
@LW_ROW_H       16 ;
@LW_Y          PAL_Y PAL_CELL_H 10 * + ; ( below the 10-row tool palette )
@CANVAS_X       PAL_W ;
@CANVAS_Y       BAR_H ;
@CANVAS_W      480 ; ( a multiple of 32 -- see draw-canvas-1x's word scan )
@CANVAS_H      LW_Y LW_ROW_H LW_ROWS * + BAR_H - ; ( level with the tool palette + line-width strip )
@CANVAS_WORDS   15 ; ( CANVAS_W / 32, exact )
@FONT_SIZE      16 ;
@GRID            8 ;
@PAT_Y         CANVAS_Y CANVAS_H + ;
@PAT_COLS       19 ;
@PAT_CELL_W     26 ;
@PAT_CELL_H     28 ;
@PAT_CUR_W      CANVAS_X CANVAS_W + PAT_COLS PAT_CELL_W * - ; ( remaining width, current-pattern preview box )
@PAT_ROWS        2 ;
@PAT_N          38 ; ( PAT_COLS * PAT_ROWS )
@FAT_Z           8 ;
@FAT_VW         60 ; ( CANVAS_W / FAT_Z, exact -- Step 8's FatBits zoom window )
@FAT_VH         52 ; ( CANVAS_H / FAT_Z, exact )
@STK_MAX      4096 ;
@ROW_BYTES      60 ; ( CANVAS_W / 8, for the EAS1 pack )
@PACK_BYTES  24968 ; ( 8-byte header + ROW_BYTES * CANVAS_H )
@WIN_W         CANVAS_X CANVAS_W + ;
@WIN_H         PAT_Y PAT_CELL_H PAT_ROWS * + ;

( Authentic MacPaint tool order, row-major in the 2x10 palette (see
  easel_plan.md's target layout list). LASSO/MARQUEE/PENCIL/ERASER/BRUSH/
  FILL/LINE/SPRAY/RECT/RECT_FILLED/OVAL/OVAL_FILLED/ROUNDRECT/
  ROUNDRECT_FILLED have real behavior so far -- the rest (HAND/TEXT/
  FREEFORM*/POLYGON*) are visible, correctly positioned, and inert, pending
  Steps 5 (clipboard)/7/8. RECT_FILLED/OVAL_FILLED/ROUNDRECT_FILLED are
  their own tool slots, not a filled-f toggle -- see shape-filled? below --
  since MacPaint puts filled variants on their own palette buttons rather
  than a Goodies checkbox. )
@TOOL_LASSO             0 ;
@TOOL_MARQUEE            1 ;
@TOOL_HAND               2 ;
@TOOL_TEXT               3 ;
@TOOL_FILL               4 ;
@TOOL_SPRAY              5 ;
@TOOL_BRUSH              6 ;
@TOOL_PENCIL             7 ;
@TOOL_LINE               8 ;
@TOOL_ERASER             9 ;
@TOOL_RECT              10 ;
@TOOL_RECT_FILLED       11 ;
@TOOL_ROUNDRECT         12 ;
@TOOL_ROUNDRECT_FILLED  13 ;
@TOOL_OVAL              14 ;
@TOOL_OVAL_FILLED       15 ;
@TOOL_FREEFORM          16 ;
@TOOL_FREEFORM_FILLED   17 ;
@TOOL_POLYGON           18 ;
@TOOL_POLYGON_FILLED    19 ;

@DRAG_NONE       0 ;
@DRAG_PAINT      1 ;
@DRAG_SHAPE      2 ;
@DRAG_MARQUEE    3 ; ( rubber-banding out a new marquee selection )
@DRAG_MOVE       4 ; ( dragging an already-lifted selection to a new spot )
@DRAG_LASSO      5 ; ( freehand-tracing a lasso path )

@MODE_BLACK      0 ;
@MODE_WHITE      1 ;
@MODE_PAT        2 ;
@MODE_BRUSH      3 ;
@MODE_ERASE      4 ;
@MODE_SPRAY      5 ;

@CLR_BG        0xFFFFFF ;
@CLR_FG        0x000000 ;
@CLR_PAGE      0xFFFFFF ;
@CLR_PAL       0xDDDDDD ;
@CLR_GRID      0xCCCCCC ;
@CLR_HDR       0xEEEEEE ;
@CLR_FRAME     0x000000 ;
@CLR_HINT      0x444444 ;
@CLR_WHITE     0xFFFFFF ;

@CONFIRM_PANEL_W 260 ;
@CONFIRM_PANEL_H 170 ;
@CONFIRM_BTN_W   180 ;
@CONFIRM_BTN_H    30 ;
@CONFIRM_BTN_GAP  10 ;
@CLR_CONFIRM_DIM    0x000000 ;
@CLR_CONFIRM_PANEL  0x303030 ;
@CLR_CONFIRM_BORDER 0xAAAAAA ;
@CLR_CONFIRM_TEXT   0xFFFFFF ;
@CLR_CONFIRM_BTN    0x505050 ;

( Edit Pattern modal: an 8x8 grid of clickable cells, reusing the confirm
  dialog's dim/panel/border/text/btn palette. )
@EPAT_CELL        20 ;
@EPAT_GRID        EPAT_CELL 8 * ;
@EPAT_PANEL_W     EPAT_GRID 40 + ;
@EPAT_PANEL_H     EPAT_GRID 74 + ;
@EPAT_PANEL_X     WIN_W EPAT_PANEL_W - 2 / ;
@EPAT_PANEL_Y     WIN_H EPAT_PANEL_H - 2 / ;
@EPAT_GRID_X      EPAT_PANEL_X 20 + ;
@EPAT_GRID_Y      EPAT_PANEL_Y 34 + ;
@EPAT_BTN_W        70 ;
@EPAT_BTN_H        20 ;
@EPAT_BTN_Y       EPAT_GRID_Y EPAT_GRID + 14 + ;
@EPAT_OK_X        EPAT_PANEL_X EPAT_PANEL_W + 20 - EPAT_BTN_W - ;
@EPAT_CANCEL_X    EPAT_PANEL_X 20 + ;

( Brush Shape modal: 32 preset 16x16 masks in an 8x4 grid, one cell per
  brush, click to select and close (no OK/Cancel -- picking IS committing,
  matching MacPaint's brush shape palette). )
@BR_SIZE          16 ;
@BR_ROW_BYTES      2 ;
@BR_BYTES         BR_SIZE BR_ROW_BYTES * ;
@BR_COUNT         32 ;
@BR_COLS           8 ;
@BR_ROWS           4 ;
@BR_CELL          24 ;
@BR_PANEL_W       BR_CELL BR_COLS * 20 + ;
@BR_PANEL_H       BR_CELL BR_ROWS * 44 + ;
@BR_PANEL_X       WIN_W BR_PANEL_W - 2 / ;
@BR_PANEL_Y       WIN_H BR_PANEL_H - 2 / ;
@BR_GRID_X        BR_PANEL_X 10 + ;
@BR_GRID_Y        BR_PANEL_Y 30 + ;

( --- Bulk buffers (MM_APP_BULK_BUFFER 0x900000..0xA00000) ---
  CANVAS/UNDO/TMP are now packed 1bpp BITMAP::PAGE_BYTES (51840) pages, not
  one-byte-per-pixel CANVAS_BYTES (175104) -- see lib/bitmap.lux. TMP sits at
  the address the rewrite plan reserves for a general page-sized SCRATCH
  buffer (Step 5/6 will reuse it for selection transforms, never concurrently
  with do-undo's swap use here). )
@CANVAS        0x900000 ;
@UNDO          0x90D000 ;
@TMP           0x934000 ;
@PACK          0x981000 ;
@STK           0x987000 ;
@PATH          0x990000 ;
@VFS_PATH      0x990100 ;
@PATTERNS      0x990300 ; ( 38 * 8 bytes, one row per byte -- see init-pats )
@BRUSHES       0x990500 ; ( 32 * 32 bytes, 16x16 1bpp masks, 2 bytes/row -- see init-brushes )
@SEL_MASK      0x991000 ; ( BITMAP::PAGE_BYTES page: lasso's filled-interior selection mask )
@SNARF_BUF     0x9A0000 ; ( EASS clipboard payload; max real selection is ~24968 bytes, well
                            under SYS_SNARF_MAX (include/system.h) for the current canvas size )
@SNARF_CAP     0x8000 ;

( --- Small state (MM_APP_SMALL_STATE) --- )
@tool              0x8A0000 ;
@pat-id            0x8A0004 ;
@drag              0x8A0008 ;
@mouse-held        0x8A000C ;
@file-dirty        0x8A0010 ;
@confirm-new-open  0x8A0014 ;
@grid-f            0x8A0018 ;
@fat-f             0x8A001C ;
( 0x8A0020 formerly filled-f -- removed, see shape-filled? )
@undo-ok           0x8A0024 ;
@plot-mode         0x8A0028 ;
@last-cx           0x8A002C ;
@last-cy           0x8A0030 ;
@shape-x0          0x8A0034 ;
@shape-y0          0x8A0038 ;
@shape-x1          0x8A003C ;
@shape-y1          0x8A0040 ;
@fat-ox            0x8A0044 ;
@fat-oy            0x8A0048 ;
@shift-mod         0x8A004C ;
@stk-n             0x8A0050 ;
@rng               0x8A0054 ;
@erase-btn         0x8A0058 ;
@save-as           0x8A005C ;
@last-pat-id       0x8A0060 ; ( previously drawn pattern selection, -1 = none yet )
@damage            0x8A0064 ; ( bitmask of DIRTY_* below: what changed since the last draw )
@pen-width         0x8A0068 ; ( index into LW_VALUES; drives line/rect/oval outline thickness )
@epat-last-idx     0x8A006C ; ( pattern-strip double-click tracking: last clicked swatch index )
@epat-last-time    0x8A0070 ;
@edit-pat-open     0x8A0074 ; ( 0/1: Edit Pattern modal open )
@edit-pat-id       0x8A0078 ; ( which PATTERNS slot the editor is modifying )
@brush-index       0x8A007C ; ( selected brush, 0..31, index into BRUSHES )
@brush-pick-open   0x8A0080 ; ( 0/1: Brush Shape modal open )
@br-last-idx       0x8A0084 ; ( tool-palette double-click tracking, separate from epat-last-* )
@br-last-time      0x8A0088 ;
@sel-active        0x8A008C ; ( 0/1: a marquee selection is currently marked )
@sel-x0            0x8A0090 ; ( canonical canvas-space rect, min<=max always once committed )
@sel-y0            0x8A0094 ;
@sel-x1            0x8A0098 ;
@sel-y1            0x8A009C ;
@move-dx           0x8A00A0 ; ( live translation while DRAG_MOVE, canvas px )
@move-dy           0x8A00A4 ;
@sel-mask-active   0x8A00A8 ; ( 0/1: selection is SEL_MASK-gated (lasso) vs full-rect (marquee) )
@lasso-minx        0x8A00AC ; ( running bbox of the traced path, while DRAG_LASSO )
@lasso-miny        0x8A00B0 ;
@lasso-maxx        0x8A00B4 ;
@lasso-maxy        0x8A00B8 ;
@lasso-start-cx    0x8A00BC ; ( first point of the path, to close the loop on mouse-up )
@lasso-start-cy    0x8A00C0 ;

( Explicit damage bits, replacing the old single pat-full flag (whose narrow
  meaning -- "must draw-patterns redraw all swatches" -- was the exact bug: a
  full-window wipe ran every dirty frame regardless, erasing the pattern strip
  whenever pat-full was 0, i.e. every frame except @start/resume-draw-all).
  DIRTY_TOOLS/WIDTHS are not yet consumed by any call site -- reserved for
  finer-grained repaint in later rewrite steps -- but the rule that fixes the
  reported bug already holds: any region draw-damaged clears must be redrawn
  under that same bit, never assumed clear from a blanket wipe. )
@DIRTY_CANVAS   1 ;
@DIRTY_TOOLS    2 ;
@DIRTY_WIDTHS   4 ;
@DIRTY_PATS     8 ;
@DIRTY_CHROME  16 ;
@DIRTY_ALL     31 ;

@damage! ( bits -- )
    damage LOADI OR damage STOREI
;

( --- Path / dirty --- )

@make-vfs-path ( path-ptr -- vfs-path-ptr )
    dup load-byte 47 = [ 1 + ] ?
    T"/sys/file/" VFS_PATH STR::strcpy
    VFS_PATH T"/sys/file/" STR::strlen + STR::strcpy
    VFS_PATH
;

@mark-dirty ( -- )
    1 file-dirty STOREI
    APP::dirty!
    sync-title
;

@path-basename ( -- ptr )
    PATH dup
    [ dup load-byte ]
    [
        dup load-byte 47 = [
            1 + swap drop dup
        ] [ 1 + ] ?:
    ] |:
    drop
;

@sync-title ( -- )
    file-dirty LOADI [ T"Easel *" ] [ T"Easel" ] ?:
    VFS::set-window-title
;

( --- Canvas --- )

@copy-buf { src dest -- }
    src dest BITMAP::copy
;

@clear-buf { dest -- }
    dest BITMAP::clear
;

@in-can? { x y -- f }
    x 0 >= y 0 >= AND x CANVAS_W < AND y CANVAS_H < AND
;

@pix@ { x y -- v }
    x y in-can? [
        CANVAS x y BITMAP::get
    ] [ 0 ] ?:
;

( The old false branch here was `[ drop ]` -- a latent stack-underflow bug:
  v/x/y are already popped into named locals by the frame declaration above,
  so there was nothing left on the stack for that drop to consume. An
  out-of-bounds pix! (e.g. a brush stamp clipped at the canvas edge) would
  have faulted the VM. `?` -- no else branch -- just skips the write. )
@pix! { v x y -- }
    x y in-can? [
        CANVAS x y v BITMAP::set
    ] ?
;

@pat-bit { x y -- b }
    PATTERNS pat-id LOADI 8 * + y 7 AND + load-byte
    128 x 7 AND RSHIFT AND
    0 = [ 0 ] [ 1 ] ?:
;

@plot-pat { x y -- }
    x y x y pat-bit pix!
;

@plot-black { x y -- } 1 x y pix! ;
@plot-white { x y -- } 0 x y pix! ;

@hspan-bit { bit x y n -- }
    0 { k }
        [ k n < ]
        [
            bit x k + y pix!
            k 1 + k!
        ] |:
    UNGIRD
;

( Delegates to BITMAP::hspan-pat (word-at-a-time, no per-pixel pix! bounds
  check) instead of looping plot-pat one column at a time. Safe without extra
  clipping here: both callers (fill-rect-pat, fill-oval-pat, via
  commit-shape) only ever pass spans whose endpoints came from mouse
  positions already clamped into canvas bounds by clip-can. )
@hspan-pat { x y n -- }
    CANVAS x y n PATTERNS pat-id LOADI 8 * + y BITMAP::hspan-pat
;

( --- Brush shapes: 32 preset 16x16 1bpp masks, generated once at startup
  (see init-brushes) rather than hand-authored as literal byte tables. --- )

@brush-addr { bi row -- addr }
    BRUSHES bi BR_BYTES * + row BR_ROW_BYTES * +
;

@brush-get-bit { bi col row -- b }
    bi row brush-addr { a }
        col 8 < [ a load-byte ] [ a 1 + load-byte ] ?: { byte }
            byte 128 col 8 MOD RSHIFT AND
            0 = [ 0 ] [ 1 ] ?:
        UNGIRD
    UNGIRD
;

@brush-set-bit { bi col row v -- }
    bi row brush-addr { a }
        col 8 < [ a ] [ a 1 + ] ?: { ba }
            ba load-byte { byte }
                v 0 = [
                    byte 128 col 8 MOD RSHIFT NOT AND
                ] [
                    byte 128 col 8 MOD RSHIFT OR
                ] ?:
                ba store-byte
            UNGIRD
        UNGIRD
    UNGIRD
;

@brush-clear { bi -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            bi row brush-addr 0 store-byte
            bi row brush-addr 1 + 0 store-byte
            row 1 + row!
        ] |:
    UNGIRD
;

@circle-mask { bi r -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            0 { col }
                [ col BR_SIZE < ]
                [
                    col 7 - { dx }
                        row 7 - { dy }
                            dx dx * dy dy * + r r * <= [
                                bi col row 1 brush-set-bit
                            ] ?
                        UNGIRD
                    UNGIRD
                    col 1 + col!
                ] |:
            UNGIRD
            row 1 + row!
        ] |:
    UNGIRD
;

@ring-mask { bi r -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            0 { col }
                [ col BR_SIZE < ]
                [
                    col 7 - { dx }
                        row 7 - { dy }
                            dx dx * dy dy * + { d2 }
                                d2 r r * <= d2 r 1 - r 1 - * > AND [
                                    bi col row 1 brush-set-bit
                                ] ?
                            UNGIRD
                        UNGIRD
                    UNGIRD
                    col 1 + col!
                ] |:
            UNGIRD
            row 1 + row!
        ] |:
    UNGIRD
;

@square-mask { bi half -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            0 { col }
                [ col BR_SIZE < ]
                [
                    col 7 - ABS half <= row 7 - ABS half <= AND [
                        bi col row 1 brush-set-bit
                    ] ?
                    col 1 + col!
                ] |:
            UNGIRD
            row 1 + row!
        ] |:
    UNGIRD
;

@cross-mask { bi half thick -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            0 { col }
                [ col BR_SIZE < ]
                [
                    col 7 - ABS { adx }
                        row 7 - ABS { ady }
                            adx half <= ady thick <= AND
                            ady half <= adx thick <= AND OR [
                                bi col row 1 brush-set-bit
                            ] ?
                        UNGIRD
                    UNGIRD
                    col 1 + col!
                ] |:
            UNGIRD
            row 1 + row!
        ] |:
    UNGIRD
;

@diag-mask { bi w -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            0 { col }
                [ col BR_SIZE < ]
                [
                    col row - ABS w <= [
                        bi col row 1 brush-set-bit
                    ] ?
                    col 1 + col!
                ] |:
            UNGIRD
            row 1 + row!
        ] |:
    UNGIRD
;

@adiag-mask { bi w -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            0 { col }
                [ col BR_SIZE < ]
                [
                    col row + 15 - ABS w <= [
                        bi col row 1 brush-set-bit
                    ] ?
                    col 1 + col!
                ] |:
            UNGIRD
            row 1 + row!
        ] |:
    UNGIRD
;

( 0-7 circles growing r=1..8, 8-15 squares growing half=0..7, 16-19 NW-SE
  diagonal bands, 20-23 NE-SW diagonal bands, 24-27 hollow rings, 28-31
  crosses -- 32 distinct presets spanning MacPaint's usual round/square/
  calligraphy/ring brush families. )
@init-brushes ( -- )
    0 { bi }
        [ bi BR_COUNT < ]
        [
            bi brush-clear
            bi 1 + bi!
        ] |:
    UNGIRD
    0  1 circle-mask   1  2 circle-mask   2  3 circle-mask   3  4 circle-mask
    4  5 circle-mask   5  6 circle-mask   6  7 circle-mask   7  8 circle-mask
    8  0 square-mask   9  1 square-mask  10  2 square-mask  11  3 square-mask
    12 4 square-mask  13  5 square-mask  14  6 square-mask  15  7 square-mask
    16 0 diag-mask     17 1 diag-mask     18 2 diag-mask     19 3 diag-mask
    20 0 adiag-mask    21 1 adiag-mask    22 2 adiag-mask    23 3 adiag-mask
    24 3 ring-mask     25 5 ring-mask     26 7 ring-mask     27 8 ring-mask
    28 3 1 cross-mask  29 5 1 cross-mask  30 7 2 cross-mask  31 8 2 cross-mask
;

@brush-at { cx cy -- }
    0 { row }
        [ row BR_SIZE < ]
        [
            0 { col }
                [ col BR_SIZE < ]
                [
                    brush-index LOADI col row brush-get-bit 0 > [
                        cx col 7 - + cy row 7 - + plot-pat
                    ] ?
                    col 1 + col!
                ] |:
            UNGIRD
            row 1 + row!
        ] |:
    UNGIRD
;

@erase-at { cx cy -- }
    -4 { dy }
        [ dy 4 < ]
        [
            -4 { dx }
                [ dx 4 < ]
                [
                    0 cx dx + cy dy + pix!
                    dx 1 + dx!
                ] |:
            UNGIRD
            dy 1 + dy!
        ] |:
    UNGIRD
;

@rnd ( -- n )
    rng LOADI 1103515245 * 12345 + dup rng STOREI
    16 RSHIFT 32767 AND
;

@spray-at { cx cy -- }
    0 { i }
        [ i 18 < ]
        [
            rnd 24 MOD 12 - { dx }
                rnd 24 MOD 12 - { dy }
                    dx dx * dy dy * + 144 < [
                        cx dx + cy dy + plot-pat
                    ] ?
                UNGIRD
            UNGIRD
            i 1 + i!
        ] |:
    UNGIRD
;

@plot-at { x y -- }
    plot-mode LOADI
    dup MODE_BLACK = [ drop x y plot-black ] [
    dup MODE_WHITE = [ drop x y plot-white ] [
    dup MODE_PAT = [ drop x y plot-pat ] [
    dup MODE_BRUSH = [ drop x y brush-at ] [
    dup MODE_ERASE = [ drop x y erase-at ] [
        drop x y spray-at
    ] ?: ] ?: ] ?: ] ?: ] ?:
;

( 1px Bresenham onto the bitmap. )
@stroke-to { x0 y0 x1 y1 -- }
    x1 x0 - ABS
    y1 y0 - ABS NEGATE
    x0 x1 < [ 1 ] [ -1 ] ?:
    y0 y1 < [ 1 ] [ -1 ] ?:
    { adx ady sx sy }
        adx ady + { err }
            x0 y0 plot-at
            [ x0 x1 = y0 y1 = AND 0 = ]
            [
                err 2 * { e2 }
                    e2 ady >= [
                        err ady + err!
                        x0 sx + x0!
                    ] ?
                    e2 adx <= [
                        err adx + err!
                        y0 sy + y0!
                    ] ?
                UNGIRD
                x0 y0 plot-at
            ] |:
        UNGIRD
    UNGIRD
;

@canon-xy { x0 y0 x1 y1 -- minx miny maxx maxy }
    x0 x1 MIN y0 y1 MIN x0 x1 MAX y0 y1 MAX
;

@frame-rect-pix { x0 y0 x1 y1 -- }
    x0 y0 x1 y1 canon-xy { minx miny maxx maxy }
        minx { x }
            [ x maxx <= ]
            [
                1 x miny pix!
                1 x maxy pix!
                x 1 + x!
            ] |:
        UNGIRD
        miny { y }
            [ y maxy <= ]
            [
                1 minx y pix!
                1 maxx y pix!
                y 1 + y!
            ] |:
        UNGIRD
    UNGIRD
;

@fill-rect-pat { x0 y0 x1 y1 -- }
    x0 y0 x1 y1 canon-xy { minx miny maxx maxy }
        miny { y }
            [ y maxy <= ]
            [
                minx y maxx minx - 1 + hspan-pat
                y 1 + y!
            ] |:
        UNGIRD
    UNGIRD
;

@fill-oval-pat { x y w h -- }
    w 1 < h 1 < OR [
    ] [
        0 { py }
            [ py h < ]
            [
                w h py DRAW::oval-span
                dup 0 > [
                    { xoff spanw }
                        x xoff + y py + spanw hspan-pat
                    UNGIRD
                ] [ drop drop ] ?:
                py 1 + py!
            ] |:
        UNGIRD
    ] ?:
;

@hspan-black { x y n -- }
    1 x y n hspan-bit
;

@frame-oval-pix { x y w h -- }
    w 3 < h 3 < OR [
        0 { py }
            [ py h < ]
            [
                w h py DRAW::oval-span
                dup 0 > [
                    { xoff spanw }
                        x xoff + y py + spanw hspan-black
                    UNGIRD
                ] [ drop drop ] ?:
                py 1 + py!
            ] |:
        UNGIRD
    ] [
        0 { py }
            [ py h < ]
            [
                w h py DRAW::oval-span { ox osw }
                    osw 0 = [
                    ] [
                        w 2 - h 2 - py 1 - DRAW::oval-span { ix iw }
                            iw 0 = [
                                x ox + y py + osw hspan-black
                            ] [
                                1 ix + ox - { lw }
                                    lw 0 > [
                                        x ox + y py + lw hspan-black
                                    ] ?
                                UNGIRD
                                ox osw + 1 ix + iw + - { rw }
                                    rw 0 > [
                                        x 1 + ix + iw + y py + rw hspan-black
                                    ] ?
                                UNGIRD
                            ] ?:
                        UNGIRD
                    ] ?:
                UNGIRD
                py 1 + py!
            ] |:
        UNGIRD
    ] ?:
;

( --- pen-width-aware line/outline stroking (rest of Step 4) --- )

@vspan-black { x y n -- }
    0 { k }
        [ k n < ]
        [
            1 x y k + pix!
            k 1 + k!
        ] |:
    UNGIRD
;

( Thickens a 1px black horizontal span into w rows, growing downward from y. )
@hspan-black-w { x y n w -- }
    0 { r }
        [ r w < ]
        [
            x y r + n hspan-black
            r 1 + r!
        ] |:
    UNGIRD
;

( Thickens a 1px black vertical span into w columns, growing rightward from x. )
@vspan-black-w { x y n w -- }
    0 { r }
        [ r w < ]
        [
            x r + y n vspan-black
            r 1 + r!
        ] |:
    UNGIRD
;

( w x w black square centered at (x,y); w<=1 is a single pixel. )
@plot-black-w { x y w -- }
    w 1 <= [
        1 x y pix!
    ] [
        w 2 / { half }
            x half - { sx }
                y half - { sy }
                    0 { dy }
                        [ dy w < ]
                        [
                            sx sy dy + w hspan-black
                            dy 1 + dy!
                        ] |:
                    UNGIRD
                UNGIRD
            UNGIRD
        UNGIRD
    ] ?:
;

( Bresenham line stamped with a w x w square per step instead of stroke-to's
  single pixel. w<=1 falls back to stroke-to (via plot-at, so it still
  respects the pencil/eraser mode split there is none for TOOL_LINE -- always
  black). )
@stroke-to-w { x0 y0 x1 y1 w -- }
    w 1 <= [
        MODE_BLACK plot-mode STOREI
        x0 y0 x1 y1 stroke-to
    ] [
        x1 x0 - ABS
        y1 y0 - ABS NEGATE
        x0 x1 < [ 1 ] [ -1 ] ?:
        y0 y1 < [ 1 ] [ -1 ] ?:
        { adx ady sx sy }
            adx ady + { err }
                x0 y0 w plot-black-w
                [ x0 x1 = y0 y1 = AND 0 = ]
                [
                    err 2 * { e2 }
                        e2 ady >= [
                            err ady + err!
                            x0 sx + x0!
                        ] ?
                        e2 adx <= [
                            err adx + err!
                            y0 sy + y0!
                        ] ?
                    UNGIRD
                    x0 y0 w plot-black-w
                ] |:
            UNGIRD
        UNGIRD
    ] ?:
;

( Thick rectangle outline: w bands centered on the canonical border, growing
  from a bounding box inset by w/2 on each side. w<=1 falls back to the
  original 1px frame-rect-pix. )
@frame-rect-pix-w { x0 y0 x1 y1 w -- }
    w 1 <= [
        x0 y0 x1 y1 frame-rect-pix
    ] [
        x0 y0 x1 y1 canon-xy { minx miny maxx maxy }
            w 2 / { half }
                maxx minx - 1 + half 2 * + { fullw }
                    maxy miny - 1 + half 2 * + { fullh }
                        minx half - miny half - fullw w hspan-black-w
                        minx half - maxy half - fullw w hspan-black-w
                        minx half - miny half - fullh w vspan-black-w
                        maxx half - miny half - fullh w vspan-black-w
                    UNGIRD
                UNGIRD
            UNGIRD
        UNGIRD
    ] ?:
;

( Thick oval outline built from `w` nested single-pixel oval outlines grown
  outward from a bounding box inset by w/2, approximating a centered ring.
  w<=1 falls back to the original frame-oval-pix. )
@frame-oval-pix-w { x y w h pw -- }
    pw 1 <= [
        x y w h frame-oval-pix
    ] [
        pw 2 / { half }
            0 { i }
                [ i pw < ]
                [
                    x half - i + { ox }
                        y half - i + { oy }
                            w half 2 * + i 2 * - { ow }
                                h half 2 * + i 2 * - { oh }
                                    ow 1 >= oh 1 >= AND [
                                        ox oy ow oh frame-oval-pix
                                    ] ?
                                UNGIRD
                            UNGIRD
                        UNGIRD
                    UNGIRD
                    i 1 + i!
                ] |:
            UNGIRD
        UNGIRD
    ] ?:
;

( --- Roundrect: fixed corner radius (capped by half the shorter side),
  corners built from DRAW::oval-span against a 2r x 2r bounding circle. --- )

@roundrect-r { w h -- r }
    8 w 2 / MIN h 2 / MIN
;

@fill-roundrect-pat { x0 y0 x1 y1 -- }
    x0 y0 x1 y1 canon-xy { minx miny maxx maxy }
        maxx minx - 1 +
        maxy miny - 1 +
        over over roundrect-r
        { w h r }
            r 2 * { d }
                0 { py }
                    [ py h < ]
                    [
                        py r < [
                            d d py DRAW::oval-span { xoff spanw }
                                spanw 0 > [
                                    minx xoff + miny py + w xoff 2 * - hspan-pat
                                ] ?
                            UNGIRD
                        ] [
                            py h r - >= [
                                d d py d + h - DRAW::oval-span { xoff spanw }
                                    spanw 0 > [
                                        minx xoff + miny py + w xoff 2 * - hspan-pat
                                    ] ?
                                UNGIRD
                            ] [
                                minx miny py + w hspan-pat
                            ] ?:
                        ] ?:
                        py 1 + py!
                    ] |:
                UNGIRD
            UNGIRD
        UNGIRD
    UNGIRD
;

@frame-roundrect-pix { x0 y0 x1 y1 -- }
    x0 y0 x1 y1 canon-xy { minx miny maxx maxy }
        maxx minx - 1 +
        maxy miny - 1 +
        over over roundrect-r
        { w h r }
            r 2 * { d }
                minx r + miny w r 2 * - hspan-black
                minx r + maxy w r 2 * - hspan-black
                minx miny r + h r 2 * - vspan-black
                maxx miny r + h r 2 * - vspan-black
                0 { py }
                    [ py r < ]
                    [
                        d d py DRAW::oval-span { xoff spanw }
                            spanw 0 > [
                                1 minx xoff + miny py + pix!
                                1 maxx xoff - miny py + pix!
                                1 minx xoff + maxy py - pix!
                                1 maxx xoff - maxy py - pix!
                            ] ?
                        UNGIRD
                        py 1 + py!
                    ] |:
                UNGIRD
            UNGIRD
        UNGIRD
    UNGIRD
;

( Thick roundrect outline: same nested-ring approach as frame-oval-pix-w,
  growing/shrinking the corner box symmetrically around the original edge. )
@frame-roundrect-pix-w { x0 y0 x1 y1 pw -- }
    pw 1 <= [
        x0 y0 x1 y1 frame-roundrect-pix
    ] [
        pw 2 / { half }
            0 { i }
                [ i pw < ]
                [
                    x0 half - i + { nx0 }
                        y0 half - i + { ny0 }
                            x1 half + i - { nx1 }
                                y1 half + i - { ny1 }
                                    nx1 nx0 > ny1 ny0 > AND [
                                        nx0 ny0 nx1 ny1 frame-roundrect-pix
                                    ] ?
                                UNGIRD
                            UNGIRD
                        UNGIRD
                    UNGIRD
                    i 1 + i!
                ] |:
            UNGIRD
        UNGIRD
    ] ?:
;

( --- Flood fill: connected seed-color -> 2, then 2 -> pattern. --- )

@stk-push { x y -- }
    stk-n LOADI STK_MAX < [
        STK stk-n LOADI 8 * + { a }
            x a STOREI
            y a 4 + STOREI
        UNGIRD
        stk-n LOADI 1 + stk-n STOREI
    ] [
        drop drop
    ] ?:
;

@stk-pop ( -- x y )
    stk-n LOADI 1 - dup stk-n STOREI
    8 * STK +
    dup LOADI swap 4 + LOADI
;

@seed-span { y x0 x1 old -- }
    y 0 < y CANVAS_H >= OR [
    ] [
        0 { inside }
            x0 { i }
                [ i x1 <= ]
                [
                    i y pix@ old = [
                        inside 0 = [
                            i y stk-push
                            1 inside!
                        ] ?
                    ] [
                        0 inside!
                    ] ?:
                    i 1 + i!
                ] |:
            UNGIRD
        UNGIRD
    ] ?:
;

@apply-pat-over-twos ( -- )
    0 { y }
        [ y CANVAS_H < ]
        [
            0 { x }
                [ x CANVAS_W < ]
                [
                    x y pix@ 2 = [
                        x y plot-pat
                    ] ?
                    x 1 + x!
                ] |:
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
;

@flood-from { sx sy -- }
    sx sy in-can? 0 = [
    ] [
        sx sy pix@ 0 0 0 0 0 { old x y x0 x1 i }
            old 2 = [
            ] [
                0 stk-n STOREI
                sx sy stk-push
                [ stk-n LOADI 0 > ]
                [
                    stk-pop y! x!
                    y 0 < y CANVAS_H >= OR [
                    ] [
                        x x0!
                        [ x0 0 > x0 1 - y pix@ old = AND ]
                        [ x0 1 - x0! ] |:
                        x x1!
                        [ x1 CANVAS_W 1 - < x1 1 + y pix@ old = AND ]
                        [ x1 1 + x1! ] |:
                        x0 i!
                        [ i x1 <= ]
                        [
                            2 i y pix!
                            i 1 + i!
                        ] |:
                        y 1 - x0 x1 old seed-span
                        y 1 + x0 x1 old seed-span
                    ] ?:
                ] |:
                apply-pat-over-twos
            ] ?:
        UNGIRD
    ] ?:
;

( --- Undo / invert / clear --- )

@snapshot ( -- )
    CANVAS UNDO copy-buf
    1 undo-ok STOREI
;

@do-undo ( -- )
    undo-ok LOADI [
        CANVAS TMP copy-buf
        UNDO CANVAS copy-buf
        TMP UNDO copy-buf
        mark-dirty
    ] ?
;

( Whole-page invert stays the fast word-wise XOR; a selection needs
  per-pixel since it's not page-aligned. )
@do-invert ( -- )
    snapshot
    sel-active LOADI [
        sel-y0 LOADI { y }
            [ y sel-y1 LOADI <= ]
            [
                sel-x0 LOADI { x }
                    [ x sel-x1 LOADI <= ]
                    [
                        x y pix@ 0 = [ 1 ] [ 0 ] ?: x y pix!
                        x 1 + x!
                    ] |:
                UNGIRD
                y 1 + y!
            ] |:
        UNGIRD
    ] [
        CANVAS BITMAP::invert
    ] ?:
    mark-dirty
;

@fill-rect-white { x0 y0 x1 y1 -- }
    x0 y0 x1 y1 canon-xy { minx miny maxx maxy }
        miny { y }
            [ y maxy <= ]
            [
                0 minx y maxx minx - 1 + hspan-bit
                y 1 + y!
            ] |:
        UNGIRD
    UNGIRD
;

( Edit > Clear only wipes the marquee selection's rect (and drops it) when
  one is active, matching MacPaint -- otherwise it's the old whole-canvas
  clear. )
@do-clear ( -- )
    snapshot
    sel-active LOADI [
        sel-x0 LOADI sel-y0 LOADI sel-x1 LOADI sel-y1 LOADI fill-rect-white
        0 sel-active STOREI
    ] [
        CANVAS clear-buf
    ] ?:
    mark-dirty
;

( --- Step 6: Fill / Trace Edges / Flip / Rotate, on the selection rect
  when active, else the whole page. Unlike sel-lift/sel-drop these ignore
  sel-mask-active -- a lasso's transform target is its bounding box, not
  just the traced shape, matching MacPaint's own behavior. )

@op-x0 ( -- x ) sel-active LOADI [ sel-x0 LOADI ] [ 0 ] ?: ;
@op-y0 ( -- y ) sel-active LOADI [ sel-y0 LOADI ] [ 0 ] ?: ;
@op-x1 ( -- x ) sel-active LOADI [ sel-x1 LOADI ] [ CANVAS_W 1 - ] ?: ;
@op-y1 ( -- y ) sel-active LOADI [ sel-y1 LOADI ] [ CANVAS_H 1 - ] ?: ;

@do-fill ( -- )
    snapshot
    op-y0 { y }
        [ y op-y1 <= ]
        [
            op-x0 { x }
                [ x op-x1 <= ]
                [
                    x y pat-bit x y pix!
                    x 1 + x!
                ] |:
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
    mark-dirty
;

( A black pixel survives only if one of its 4-neighbors is white or off
  the target rect (off-rect/off-canvas both read as blank -- TMP's page is
  calloc-zeroed and wider/taller than CANVAS, so an out-of-rect BITMAP::get
  either lands on real blank canvas margin or harmlessly stale-but-still-
  OR-dominated page memory; never a fault, see the addr arithmetic in
  BITMAP::addr). Everything else turns white. )
@do-trace-edges ( -- )
    snapshot
    op-x0 { x0 }
        op-x1 { x1 }
            op-y0 { y0 }
                op-y1 { y1 }
                    y0 { y }
                        [ y y1 <= ]
                        [
                            x0 { x }
                                [ x x1 <= ]
                                [
                                    CANVAS x y BITMAP::get { bit }
                                        TMP x y bit BITMAP::set
                                    UNGIRD
                                    x 1 + x!
                                ] |:
                            UNGIRD
                            y 1 + y!
                        ] |:
                    UNGIRD
                    y0 { y }
                        [ y y1 <= ]
                        [
                            x0 { x }
                                [ x x1 <= ]
                                [
                                    TMP x y BITMAP::get 0 > [
                                        x 1 - x0 < TMP x 1 - y BITMAP::get 0 = OR
                                        x 1 + x1 > TMP x 1 + y BITMAP::get 0 = OR OR
                                        y 1 - y0 < TMP x y 1 - BITMAP::get 0 = OR OR
                                        y 1 + y1 > TMP x y 1 + BITMAP::get 0 = OR OR
                                        [ 1 x y pix! ] [ 0 x y pix! ] ?:
                                    ] [
                                        0 x y pix!
                                    ] ?:
                                    x 1 + x!
                                ] |:
                            UNGIRD
                            y 1 + y!
                        ] |:
                    UNGIRD
                UNGIRD
            UNGIRD
        UNGIRD
    UNGIRD
    mark-dirty
;

@do-flip-h ( -- )
    snapshot
    op-x0 { x0 }
        op-x1 { x1 }
            op-y0 { y }
                [ y op-y1 <= ]
                [
                    x0 { x }
                        [ x x1 <= ]
                        [
                            CANVAS x y BITMAP::get { bit }
                                TMP x y bit BITMAP::set
                            UNGIRD
                            x 1 + x!
                        ] |:
                    UNGIRD
                    x0 { x }
                        [ x x1 <= ]
                        [
                            TMP x0 x1 + x - y BITMAP::get x y pix!
                            x 1 + x!
                        ] |:
                    UNGIRD
                    y 1 + y!
                ] |:
            UNGIRD
        UNGIRD
    UNGIRD
    mark-dirty
;

@do-flip-v ( -- )
    snapshot
    op-x0 { x0 }
        op-x1 { x1 }
            op-y0 { y0 }
                op-y1 { y1 }
                    y0 { y }
                        [ y y1 <= ]
                        [
                            x0 { x }
                                [ x x1 <= ]
                                [
                                    CANVAS x y BITMAP::get { bit }
                                        TMP x y bit BITMAP::set
                                    UNGIRD
                                    x 1 + x!
                                ] |:
                            UNGIRD
                            y 1 + y!
                        ] |:
                    UNGIRD
                    y0 { y }
                        [ y y1 <= ]
                        [
                            x0 { x }
                                [ x x1 <= ]
                                [
                                    TMP x y0 y1 + y - BITMAP::get x y pix!
                                    x 1 + x!
                                ] |:
                            UNGIRD
                            y 1 + y!
                        ] |:
                    UNGIRD
                UNGIRD
            UNGIRD
        UNGIRD
    UNGIRD
    mark-dirty
;

( Rotate needs a selection (a whole-canvas rotate can't fit CANVAS_W and
  CANVAS_H swapped into this app's fixed-size canvas) -- a no-op otherwise.
  Keeps the rect's top-left corner fixed and swaps w/h; old (x,y) maps to
  new (ox0+oy1-y, oy0+x-ox0). The old rect is blanked first (not just
  overwritten) since a non-square rect leaves leftover cells the rotated
  content never touches. )
@do-rotate90 ( -- )
    sel-active LOADI [
        snapshot
        sel-x0 LOADI sel-y0 LOADI sel-x1 LOADI sel-y1 LOADI { ox0 oy0 ox1 oy1 }
            oy0 { y }
                [ y oy1 <= ]
                [
                    ox0 { x }
                        [ x ox1 <= ]
                        [
                            CANVAS x y BITMAP::get { bit }
                                TMP x y bit BITMAP::set
                            UNGIRD
                            x 1 + x!
                        ] |:
                    UNGIRD
                    y 1 + y!
                ] |:
            UNGIRD
            ox0 oy0 ox1 oy1 fill-rect-white
            oy0 { y }
                [ y oy1 <= ]
                [
                    ox0 { x }
                        [ x ox1 <= ]
                        [
                            TMP x y BITMAP::get
                            ox0 oy1 y - +
                            oy0 x ox0 - +
                            { bit dx dy }
                                dx 0 >= dx CANVAS_W < AND dy 0 >= AND dy CANVAS_H < AND [
                                    bit dx dy pix!
                                ] ?
                            UNGIRD
                            x 1 + x!
                        ] |:
                    UNGIRD
                    y 1 + y!
                ] |:
            UNGIRD
            ox0 sel-x0 STOREI
            oy0 sel-y0 STOREI
            ox0 oy1 oy0 - + CANVAS_W 1 - MIN sel-x1 STOREI
            oy0 ox1 ox0 - + CANVAS_H 1 - MIN sel-y1 STOREI
        UNGIRD
        0 sel-mask-active STOREI
        mark-dirty
    ] ?
;

( --- Patterns --- )

@pat-row { pid row val -- }
    val PATTERNS pid 8 * + row + store-byte
;

@set-pat { pid b0 b1 b2 b3 b4 b5 b6 b7 -- }
    pid 0 b0 pat-row
    pid 1 b1 pat-row
    pid 2 b2 pat-row
    pid 3 b3 pat-row
    pid 4 b4 pat-row
    pid 5 b5 pat-row
    pid 6 b6 pat-row
    pid 7 b7 pat-row
;

@epat-byte@ { pid row -- byte } PATTERNS pid 8 * + row + load-byte ;

@epat-bit { pid col row -- b }
    pid row epat-byte@
    128 col 7 AND RSHIFT AND
    0 = [ 0 ] [ 1 ] ?:
;

@epat-toggle { pid col row -- }
    pid row epat-byte@
    128 col 7 AND RSHIFT XOR
    PATTERNS pid 8 * + row + store-byte
;

@init-pats ( -- )
    0 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 set-pat
    1 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF 0xFF set-pat
    2 0xAA 0x55 0xAA 0x55 0xAA 0x55 0xAA 0x55 set-pat
    3 0x88 0x22 0x88 0x22 0x88 0x22 0x88 0x22 set-pat
    4 0xEE 0xBB 0xEE 0xBB 0xEE 0xBB 0xEE 0xBB set-pat
    5 0xFF 0x00 0xFF 0x00 0xFF 0x00 0xFF 0x00 set-pat
    6 0xAA 0xAA 0xAA 0xAA 0xAA 0xAA 0xAA 0xAA set-pat
    7 0x88 0x44 0x22 0x11 0x88 0x44 0x22 0x11 set-pat
    8 0x11 0x22 0x44 0x88 0x11 0x22 0x44 0x88 set-pat
    9 0x80 0x00 0x08 0x00 0x80 0x00 0x08 0x00 set-pat
    10 0xFF 0x80 0x80 0x80 0xFF 0x08 0x08 0x08 set-pat
    11 0x10 0x38 0x7C 0xFE 0x7C 0x38 0x10 0x00 set-pat
    12 0x11 0x11 0xFF 0x11 0x11 0x11 0xFF 0x11 set-pat
    13 0x81 0x42 0x24 0x18 0x18 0x24 0x42 0x81 set-pat
    14 0x02 0x04 0x08 0x10 0x20 0x40 0x80 0x00 set-pat
    15 0xAA 0x00 0x55 0x00 0xAA 0x00 0x55 0x00 set-pat
    16 0x88 0x00 0x22 0x00 0x88 0x00 0x22 0x00 set-pat
    17 0x80 0x00 0x00 0x00 0x08 0x00 0x00 0x00 set-pat
    18 0xFF 0x08 0x08 0x08 0xFF 0x80 0x80 0x80 set-pat
    19 0xF0 0xF0 0xF0 0xF0 0x0F 0x0F 0x0F 0x0F set-pat
    20 0xFF 0xFF 0x00 0x00 0xFF 0xFF 0x00 0x00 set-pat
    21 0xCC 0xCC 0x33 0x33 0xCC 0xCC 0x33 0x33 set-pat
    22 0x99 0x66 0x99 0x66 0x99 0x66 0x99 0x66 set-pat
    23 0xF1 0xE3 0xC7 0x8F 0x1F 0x3E 0x7C 0xF8 set-pat
    24 0x44 0x00 0x11 0x00 0x44 0x00 0x11 0x00 set-pat
    25 0xBB 0xFF 0xEE 0xFF 0xBB 0xFF 0xEE 0xFF set-pat
    26 0x00 0x38 0x7C 0x7C 0x7C 0x38 0x00 0x00 set-pat
    27 0xC3 0x66 0x3C 0x18 0x18 0x3C 0x66 0xC3 set-pat
    28 0x08 0x08 0x08 0xFF 0x08 0x08 0x08 0x00 set-pat
    29 0x00 0x66 0x99 0x00 0x00 0x66 0x99 0x00 set-pat
    30 0x88 0x44 0x22 0x11 0x11 0x22 0x44 0x88 set-pat
    31 0x00 0x00 0x18 0x18 0x00 0x00 0x81 0x81 set-pat
    32 0x11 0xAA 0x44 0xAA 0x11 0xAA 0x44 0xAA set-pat
    33 0x10 0x00 0x00 0x00 0x01 0x00 0x00 0x00 set-pat
    34 0xAA 0xAA 0xAA 0xAA 0x55 0x55 0x55 0x55 set-pat
    35 0x0F 0x0F 0x0F 0xFF 0xF0 0xF0 0xF0 0xFF set-pat
    36 0x3C 0x42 0x81 0x81 0x81 0x81 0x42 0x3C set-pat
    37 0x55 0xAA 0x55 0xAA 0xAA 0x55 0xAA 0x55 set-pat
    1 pat-id STOREI
;

( --- Snap / constrain --- )

@constrain-line { x0 y0 x1 y1 -- x1 y1 }
    x1 x0 - { dx }
        y1 y0 - { dy }
            dx ABS { adx }
                dy ABS { ady }
                    adx ady 2 * > [
                        x1 y0
                    ] [
                        ady adx 2 * > [
                            x0 y1
                        ] [
                            adx ady MAX { m }
                                dx 0 < [ x0 m - ] [ x0 m + ] ?:
                                dy 0 < [ y0 m - ] [ y0 m + ] ?:
                            UNGIRD
                        ] ?:
                    ] ?:
                UNGIRD
            UNGIRD
        UNGIRD
    UNGIRD
;

@constrain-square { x0 y0 x1 y1 -- x1 y1 }
    x1 x0 - ABS y1 y0 - ABS MAX { s }
        x1 x0 < [ x0 s - ] [ x0 s + ] ?:
        y1 y0 < [ y0 s - ] [ y0 s + ] ?:
    UNGIRD
;

@apply-shift { x0 y0 x1 y1 ty -- x1 y1 }
    shift-mod LOADI [
        ty TOOL_LINE = [
            x0 y0 x1 y1 constrain-line
        ] [
            x0 y0 x1 y1 constrain-square
        ] ?:
    ] [
        x1 y1
    ] ?:
;

@clamp-fat ( -- )
    fat-ox LOADI 0 MAX CANVAS_W FAT_VW - MIN fat-ox STOREI
    fat-oy LOADI 0 MAX CANVAS_H FAT_VH - MIN fat-oy STOREI
;

@pan-fat { dx dy -- }
    fat-ox LOADI dx + fat-ox STOREI
    fat-oy LOADI dy + fat-oy STOREI
    clamp-fat
    APP::dirty!
;

( --- Screen mapping --- )

@in-page? { mx my -- f }
    mx CANVAS_X >= my CANVAS_Y >= AND
    mx CANVAS_X CANVAS_W + < AND
    my CANVAS_Y CANVAS_H + < AND
;

( Pattern strip is now the full window width (current-pattern box + the
  19x2 swatch grid), not just the column above the tool palette. )
@in-pat? { mx my -- f }
    mx PAL_X >= my PAT_Y >= AND
    mx WIN_W < AND
    my WIN_H < AND
;

@tool-xy { i -- x y }
    PAL_X i 2 MOD PAL_CELL_W * +
    PAL_Y i 2 / PAL_CELL_H * +
;

@in-tool? { mx my i -- f }
    i tool-xy { x y }
        mx x >= mx x PAL_CELL_W + < AND
        my y >= AND
        my y PAL_CELL_H + < AND
    UNGIRD
;

@hit-tool { mx my -- idx }
    -1 { found }
        0 { i }
            [ i TOOLS < found 0 < AND ]
            [
                mx my i in-tool? [ i found! ] ?
                i 1 + i!
            ] |:
        UNGIRD
        found
    UNGIRD
;

@scr>can { mx my -- cx cy }
    fat-f LOADI [
        mx CANVAS_X - FAT_Z / fat-ox LOADI +
        my CANVAS_Y - FAT_Z / fat-oy LOADI +
    ] [
        mx CANVAS_X -
        my CANVAS_Y -
    ] ?:
;

@can>scr { cx cy -- mx my }
    fat-f LOADI [
        cx fat-ox LOADI - FAT_Z * CANVAS_X +
        cy fat-oy LOADI - FAT_Z * CANVAS_Y +
    ] [
        cx CANVAS_X +
        cy CANVAS_Y +
    ] ?:
;

( --- Selection: marquee (Step 5) --- )

@in-sel? { cx cy -- f }
    sel-active LOADI 0 = [ 0 ] [
        cx sel-x0 LOADI >= cx sel-x1 LOADI <= AND
        cy sel-y0 LOADI >= AND cy sel-y1 LOADI <= AND
    ] ?:
;

( Marquee has no mask (every pixel in the rect participates); lasso gates
  each pixel through SEL_MASK so a move only carries the traced shape, not
  its whole bounding box. )
@sel-px-active? { x y -- f }
    sel-mask-active LOADI 0 = [ 1 ] [ SEL_MASK x y BITMAP::get ] ?:
;

( Copies the selection rect out of CANVAS into TMP at the same coordinates
  (never concurrent with do-undo's own transient TMP use -- see the TMP
  buffer comment), then blanks the vacated rect to white. Only the pixels
  sel-px-active? says are part of the selection are touched. )
@sel-lift ( -- )
    sel-y0 LOADI { y }
        [ y sel-y1 LOADI <= ]
        [
            sel-x0 LOADI { x }
                [ x sel-x1 LOADI <= ]
                [
                    x y sel-px-active? [
                        CANVAS x y BITMAP::get { bit }
                            TMP x y bit BITMAP::set
                        UNGIRD
                        0 x y pix!
                    ] ?
                    x 1 + x!
                ] |:
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
;

( Writes TMP's lifted rect back into CANVAS translated by move-dx/move-dy
  (clipped to canvas bounds, gated by sel-px-active?), then slides
  sel-x0..y1 to the new location. Every selected pixel is written, not just
  the set ones, so a move over existing ink correctly overwrites it (a
  1bpp selection has no separate "transparent" value). SEL_MASK itself is
  NOT relocated -- a lasso selection keeps its exact shape for one move,
  then MOUSE_UP drops sel-mask-active back to a plain bounding-box
  selection for any further moves (see the MOUSE_UP handler). )
@sel-drop ( -- )
    sel-y0 LOADI { y }
        [ y sel-y1 LOADI <= ]
        [
            sel-x0 LOADI { x }
                [ x sel-x1 LOADI <= ]
                [
                    x y sel-px-active? [
                        TMP x y BITMAP::get { bit }
                            x move-dx LOADI + { nx }
                                y move-dy LOADI + { ny }
                                    nx 0 >= nx CANVAS_W < AND ny 0 >= AND ny CANVAS_H < AND [
                                        bit nx ny pix!
                                    ] ?
                                UNGIRD
                            UNGIRD
                        UNGIRD
                    ] ?
                    x 1 + x!
                ] |:
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
    sel-x0 LOADI move-dx LOADI + sel-x0 STOREI
    sel-x1 LOADI move-dx LOADI + sel-x1 STOREI
    sel-y0 LOADI move-dy LOADI + sel-y0 STOREI
    sel-y1 LOADI move-dy LOADI + sel-y1 STOREI
    0 move-dx STOREI
    0 move-dy STOREI
;

@commit-marquee ( -- )
    sel-x0 LOADI sel-y0 LOADI sel-x1 LOADI sel-y1 LOADI canon-xy
    sel-y1 STOREI
    sel-x1 STOREI
    sel-y0 STOREI
    sel-x0 STOREI
    1 sel-active STOREI
;

@draw-sel-border { x0 y0 x1 y1 -- }
    x0 y0 can>scr { sx0 sy0 }
        x1 y1 can>scr { sx1 sy1 }
            sx0 { x }
                [ x sx1 <= ]
                [
                    x sx0 - 2 MOD 0 = [
                        APP::draw-fd x sy0 CLR_FG DRAW::pix
                        APP::draw-fd x sy1 CLR_FG DRAW::pix
                    ] ?
                    x 1 + x!
                ] |:
            UNGIRD
            sy0 { y }
                [ y sy1 <= ]
                [
                    y sy0 - 2 MOD 0 = [
                        APP::draw-fd sx0 y CLR_FG DRAW::pix
                        APP::draw-fd sx1 y CLR_FG DRAW::pix
                    ] ?
                    y 1 + y!
                ] |:
            UNGIRD
        UNGIRD
    UNGIRD
;

( Purely a screen-space overlay -- CANVAS keeps the vacated rect blank for
  the whole drag, so nothing here touches CANVAS until sel-drop on mouse-up.
  O(w*h) DRAW::pix calls per frame while actively moving; fine for the
  modest selections a marquee tool typically makes, batched through
  DRAW::batch-begin like every other draw call in this app. )
@draw-sel-float ( -- )
    sel-y0 LOADI { y }
        [ y sel-y1 LOADI <= ]
        [
            sel-x0 LOADI { x }
                [ x sel-x1 LOADI <= ]
                [
                    x y sel-px-active? [
                        TMP x y BITMAP::get { bit }
                            x move-dx LOADI + { nx }
                                y move-dy LOADI + { ny }
                                    nx 0 >= nx CANVAS_W < AND ny 0 >= AND ny CANVAS_H < AND [
                                        APP::draw-fd
                                        CANVAS_X nx +
                                        CANVAS_Y ny +
                                        bit 0 = [ CLR_WHITE ] [ CLR_FG ] ?:
                                        DRAW::pix
                                    ] ?
                                UNGIRD
                            UNGIRD
                        UNGIRD
                    ] ?
                    x 1 + x!
                ] |:
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
;

( --- Selection: lasso (Step 5) --- )

@sel-mask-clear ( -- ) SEL_MASK BITMAP::clear ;

@lasso-plot { x y -- } SEL_MASK x y 1 BITMAP::set ;

( 1px Bresenham into SEL_MASK, mirroring stroke-to but plotting into the
  selection mask instead of CANVAS. clip-can already clamps every mouse
  position to canvas bounds before this is called, and SEL_MASK's page
  (576x720) is larger than the canvas (480x416), so no bounds check is
  needed here. )
@lasso-line { x0 y0 x1 y1 -- }
    x1 x0 - ABS
    y1 y0 - ABS NEGATE
    x0 x1 < [ 1 ] [ -1 ] ?:
    y0 y1 < [ 1 ] [ -1 ] ?:
    { adx ady sx sy }
        adx ady + { err }
            x0 y0 lasso-plot
            [ x0 x1 = y0 y1 = AND 0 = ]
            [
                err 2 * { e2 }
                    e2 ady >= [
                        err ady + err!
                        x0 sx + x0!
                    ] ?
                    e2 adx <= [
                        err adx + err!
                        y0 sy + y0!
                    ] ?
                UNGIRD
                x0 y0 lasso-plot
            ] |:
        UNGIRD
    UNGIRD
;

( On mouse-up: scanline-fill the traced outline's interior (even-odd rule,
  one toggle per contiguous run of outline pixels on a row rather than per
  pixel, so a 1px-thick traced line doesn't double-toggle), then shrink the
  selection to the tight bbox of actual CANVAS ink inside the filled mask
  -- falling back to the full lasso bbox if the loop enclosed no ink, so a
  selection is never silently dropped. )
@lasso-finish ( -- )
    lasso-miny LOADI { y }
        [ y lasso-maxy LOADI <= ]
        [
            0 { inside }
                0 { prev }
                    lasso-minx LOADI { x }
                        [ x lasso-maxx LOADI <= ]
                        [
                            SEL_MASK x y BITMAP::get { cur }
                                cur 1 = prev 0 = AND [
                                    inside 0 = [ 1 inside! ] [ 0 inside! ] ?:
                                ] ?
                                inside 1 = cur 0 = AND [
                                    SEL_MASK x y 1 BITMAP::set
                                ] ?
                                cur prev!
                            UNGIRD
                            x 1 + x!
                        ] |:
                    UNGIRD
                UNGIRD
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
    0 { found }
        CANVAS_W { minx }
            -1 { maxx }
                CANVAS_H { miny }
                    -1 { maxy }
                        lasso-miny LOADI { y2 }
                            [ y2 lasso-maxy LOADI <= ]
                            [
                                lasso-minx LOADI { x2 }
                                    [ x2 lasso-maxx LOADI <= ]
                                    [
                                        SEL_MASK x2 y2 BITMAP::get CANVAS x2 y2 BITMAP::get AND [
                                            1 found!
                                            x2 minx MIN minx!
                                            x2 maxx MAX maxx!
                                            y2 miny MIN miny!
                                            y2 maxy MAX maxy!
                                        ] ?
                                        x2 1 + x2!
                                    ] |:
                                UNGIRD
                                y2 1 + y2!
                            ] |:
                        UNGIRD
                        found 0 = [
                            lasso-minx LOADI sel-x0 STOREI
                            lasso-miny LOADI sel-y0 STOREI
                            lasso-maxx LOADI sel-x1 STOREI
                            lasso-maxy LOADI sel-y1 STOREI
                        ] [
                            minx sel-x0 STOREI
                            miny sel-y0 STOREI
                            maxx sel-x1 STOREI
                            maxy sel-y1 STOREI
                        ] ?:
                    UNGIRD
                UNGIRD
            UNGIRD
        UNGIRD
    UNGIRD
    1 sel-active STOREI
    1 sel-mask-active STOREI
;

@draw-lasso-path ( -- )
    lasso-miny LOADI { y }
        [ y lasso-maxy LOADI <= ]
        [
            lasso-minx LOADI { x }
                [ x lasso-maxx LOADI <= ]
                [
                    SEL_MASK x y BITMAP::get 0 > [
                        x y can>scr { sx sy }
                            APP::draw-fd sx sy CLR_FG DRAW::pix
                        UNGIRD
                    ] ?
                    x 1 + x!
                ] |:
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
;

( FatBits isn't wired up to selection coordinates yet, so the overlay is
  1x-view only for now. )
@draw-selection ( -- )
    fat-f LOADI 0 = [
        drag LOADI DRAG_MOVE = [
            draw-sel-float
            sel-x0 LOADI move-dx LOADI + sel-y0 LOADI move-dy LOADI +
            sel-x1 LOADI move-dx LOADI + sel-y1 LOADI move-dy LOADI +
            draw-sel-border
        ] [
        drag LOADI DRAG_LASSO = [
            draw-lasso-path
        ] [
            sel-active LOADI [
                sel-x0 LOADI sel-y0 LOADI sel-x1 LOADI sel-y1 LOADI draw-sel-border
            ] ?
        ] ?: ] ?:
    ] ?
;

( --- Selection: clipboard via /sys/snarf (Step 5, part 3) --- )

@snarf-w ( -- w ) sel-x1 LOADI sel-x0 LOADI - 1 + ;
@snarf-h ( -- h ) sel-y1 LOADI sel-y0 LOADI - 1 + ;
@snarf-rb ( -- rb ) snarf-w 7 + 8 / ;

@write-snarf-magic { d w h -- }
    69 d store-byte
    65 d 1 + store-byte
    83 d 2 + store-byte
    83 d 3 + store-byte
    w d 4 + DRAW::store-word-le
    h d 6 + DRAW::store-word-le
;

( Packs the active selection's rect out of CANVAS into SNARF_BUF as "EASS"
  (magic, w/h u16 LE, then packed rows -- mirrors the EAS1 file format's
  layout). Pixels sel-px-active? says aren't part of the selection (only
  possible for a lasso) pack as 0, so a paste reproduces the traced shape,
  not its whole bounding box. )
@snarf-pack ( -- len )
    SNARF_BUF snarf-w snarf-h write-snarf-magic
    SNARF_BUF 8 + { d }
        0 { ry }
            [ ry snarf-h < ]
            [
                0 { bx }
                    [ bx snarf-rb < ]
                    [
                        0 { b }
                            0 { bit }
                                [ bit 8 < ]
                                [
                                    bx 8 * bit + { cx }
                                        cx snarf-w < [
                                            sel-x0 LOADI cx + sel-y0 LOADI ry + sel-px-active?
                                            sel-x0 LOADI cx + sel-y0 LOADI ry + pix@ AND [
                                                b 128 bit RSHIFT OR b!
                                            ] ?
                                        ] ?
                                    UNGIRD
                                    bit 1 + bit!
                                ] |:
                            UNGIRD
                            b d store-byte
                            d 1 + d!
                        UNGIRD
                        bx 1 + bx!
                    ] |:
                UNGIRD
                ry 1 + ry!
            ] |:
        UNGIRD
    UNGIRD
    8 snarf-rb snarf-h * +
;

@snarf-copy ( -- )
    sel-active LOADI [
        snarf-pack { len }
            T"/sys/snarf" VFS::open dup 0 >= [
                dup SNARF_BUF len VFS::write drop
                VFS::close drop
            ] [ drop ] ?:
        UNGIRD
    ] ?
;

@menu-copy ( val -- ) drop snarf-copy ;

@do-cut ( -- )
    sel-active LOADI [
        snapshot
        snarf-copy
        sel-x0 LOADI sel-y0 LOADI sel-x1 LOADI sel-y1 LOADI fill-rect-white
        0 sel-active STOREI
        0 sel-mask-active STOREI
        mark-dirty
    ] ?
;

@menu-cut ( val -- ) drop do-cut ;

@snarf-magic-ok? ( -- f )
    SNARF_BUF load-byte 69 =
    SNARF_BUF 1 + load-byte 65 = AND
    SNARF_BUF 2 + load-byte 83 = AND
    SNARF_BUF 3 + load-byte 83 = AND
;

@snarf-in-w ( -- w ) SNARF_BUF 4 + DRAW::load-word-le ;
@snarf-in-h ( -- h ) SNARF_BUF 6 + DRAW::load-word-le ;
@snarf-in-cw ( -- cw ) snarf-in-w CANVAS_W MIN ;
@snarf-in-ch ( -- ch ) snarf-in-h CANVAS_H MIN ;
@snarf-in-ox ( -- ox ) CANVAS_W snarf-in-cw - 2 / ;
@snarf-in-oy ( -- oy ) CANVAS_H snarf-in-ch - 2 / ;
@snarf-in-rb ( -- rb ) snarf-in-w 7 + 8 / ;

@snarf-in-bit { cx ry -- bit }
    SNARF_BUF 8 + ry snarf-in-rb * + cx 8 / + load-byte
    128 cx 8 MOD RSHIFT AND 0 = [ 0 ] [ 1 ] ?:
;

( Unpacks SNARF_BUF's EASS payload into CANVAS centered in the canvas
  (clamped to canvas bounds if the pasted content is larger), and marks the
  pasted rect as a fresh mask-gated selection so it can be dragged into
  place immediately, same as a just-finished lasso. )
@snarf-unpack ( -- )
    snapshot
    sel-mask-clear
    0 { ry }
        [ ry snarf-in-ch < ]
        [
            0 { cx }
                [ cx snarf-in-cw < ]
                [
                    cx ry snarf-in-bit snarf-in-ox cx + snarf-in-oy ry + pix!
                    SEL_MASK snarf-in-ox cx + snarf-in-oy ry + 1 BITMAP::set
                    cx 1 + cx!
                ] |:
            UNGIRD
            ry 1 + ry!
        ] |:
    UNGIRD
    snarf-in-ox sel-x0 STOREI
    snarf-in-oy sel-y0 STOREI
    snarf-in-ox snarf-in-cw + 1 - sel-x1 STOREI
    snarf-in-oy snarf-in-ch + 1 - sel-y1 STOREI
    1 sel-active STOREI
    1 sel-mask-active STOREI
    mark-dirty
;

@snarf-paste ( -- )
    T"/sys/snarf" VFS::open dup 0 >= [
        dup SNARF_BUF SNARF_CAP VFS::read { n }
            VFS::close drop
            n 8 >= snarf-magic-ok? AND [
                snarf-unpack
            ] ?
        UNGIRD
    ] [ drop ] ?:
;

@menu-paste ( val -- ) drop snarf-paste ;

@clip-can { x y -- x' y' }
    x 0 MAX CANVAS_W 1 - MIN
    y 0 MAX CANVAS_H 1 - MIN
;

( --- File format EAS1 --- )

@write-magic { d -- }
    69 d store-byte
    65 d 1 + store-byte
    83 d 2 + store-byte
    49 d 3 + store-byte
    CANVAS_W d 4 + DRAW::store-word-le
    CANVAS_H d 6 + DRAW::store-word-le
;

@pack-bits ( -- )
    PACK write-magic
    PACK 8 + { d }
        0 { y }
            [ y CANVAS_H < ]
            [
                0 { bx }
                    [ bx ROW_BYTES < ]
                    [
                        0 { b }
                            0 { bit }
                                [ bit 8 < ]
                                [
                                    bx 8 * bit + y pix@ [
                                        b 128 bit RSHIFT OR b!
                                    ] ?
                                    bit 1 + bit!
                                ] |:
                            UNGIRD
                            b d store-byte
                            d 1 + d!
                        UNGIRD
                        bx 1 + bx!
                    ] |:
                UNGIRD
                y 1 + y!
            ] |:
        UNGIRD
    UNGIRD
;

@unpack-bits ( -- )
    CANVAS clear-buf
    PACK 8 + { s }
        0 { y }
            [ y CANVAS_H < ]
            [
                0 { bx }
                    [ bx ROW_BYTES < ]
                    [
                        s load-byte { b }
                            0 { bit }
                                [ bit 8 < ]
                                [
                                    b 128 bit RSHIFT AND [
                                        1 bx 8 * bit + y pix!
                                    ] ?
                                    bit 1 + bit!
                                ] |:
                            UNGIRD
                            s 1 + s!
                        UNGIRD
                        bx 1 + bx!
                    ] |:
                UNGIRD
                y 1 + y!
            ] |:
        UNGIRD
    UNGIRD
;

@magic-ok? ( -- f )
    PACK load-byte 69 =
    PACK 1 + load-byte 65 = AND
    PACK 2 + load-byte 83 = AND
    PACK 3 + load-byte 49 = AND
    PACK 4 + DRAW::load-word-le CANVAS_W = AND
    PACK 6 + DRAW::load-word-le CANVAS_H = AND
;

@save-file ( -- )
    pack-bits
    PATH make-vfs-path 6 VFS::open-mode
    dup 0 >= [
        dup PACK PACK_BYTES VFS::write drop
        VFS::close drop
        0 file-dirty STOREI
        sync-title
        APP::dirty!
    ] [ drop ] ?:
;

@load-path ( path -- )
    dup load-byte 47 = [ 1 + ] ?
    PATH STR::strcpy
    PATH make-vfs-path 0 VFS::open-mode
    dup 0 >= [
        dup PACK PACK_BYTES VFS::read { n }
            VFS::close drop
            n PACK_BYTES < [
            ] [
                magic-ok? [
                    unpack-bits
                    0 file-dirty STOREI
                    0 undo-ok STOREI
                    0 fat-ox STOREI
                    0 fat-oy STOREI
                    0 sel-active STOREI
                    0 sel-mask-active STOREI
                    0 move-dx STOREI
                    0 move-dy STOREI
                ] ?
            ] ?:
        UNGIRD
        sync-title
    ] [ drop ] ?:
    APP::dirty!
;

@new-document ( -- )
    CANVAS clear-buf
    T"untitled.eas" PATH STR::strcpy
    0 file-dirty STOREI
    0 confirm-new-open STOREI
    0 APP::modal!
    0 undo-ok STOREI
    DRAG_NONE drag STOREI
    0 fat-ox STOREI
    0 fat-oy STOREI
    TOOL_PENCIL tool STOREI
    1 pat-id STOREI
    1 rng STOREI
    0 sel-active STOREI
    0 sel-mask-active STOREI
    0 move-dx STOREI
    0 move-dy STOREI
    sync-title
    APP::dirty!
;

( --- Confirm / menus --- )

@confirm-panel-x ( -- x ) WIN_W CONFIRM_PANEL_W - 2 / ;
@confirm-panel-y ( -- y ) WIN_H CONFIRM_PANEL_H - 2 / ;
@confirm-btn-x ( -- x ) confirm-panel-x CONFIRM_PANEL_W CONFIRM_BTN_W - 2 / + ;
@confirm-btn-y ( i -- y ) confirm-panel-y 46 + swap CONFIRM_BTN_H CONFIRM_BTN_GAP + * + ;

@confirm-hit-btn ( i px py -- flag )
    3 frame! ( 0:py 1:px 2:i )
    1 local@ confirm-btn-x < [ 0 ] [
    1 local@ confirm-btn-x CONFIRM_BTN_W + >= [ 0 ] [
    0 local@ 2 local@ confirm-btn-y < [ 0 ] [
    0 local@ 2 local@ confirm-btn-y CONFIRM_BTN_H + >= [ 0 ] [
    1
    ] ?: ] ?: ] ?: ] ?:
    3 unframe!
;

@confirm-new-draw ( -- )
    confirm-new-open LOADI [
        APP::draw-fd 0 0 WIN_W WIN_H CLR_CONFIRM_DIM DRAW::fill-rect
        confirm-panel-x confirm-panel-y confirm-btn-x 3 frame! ( 0:bx 1:py 2:px )
        APP::draw-fd 2 local@ 1 local@ CONFIRM_PANEL_W CONFIRM_PANEL_H CLR_CONFIRM_PANEL DRAW::fill-rect
        APP::draw-fd 2 local@ 1 local@ CONFIRM_PANEL_W 1 CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd 2 local@ 1 local@ CONFIRM_PANEL_H + 1 - CONFIRM_PANEL_W 1 CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd 2 local@ 1 local@ 1 CONFIRM_PANEL_H CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd 2 local@ CONFIRM_PANEL_W + 1 - 1 local@ 1 CONFIRM_PANEL_H CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd 2 local@ 26 + 1 local@ 16 + T"Save changes?" CLR_CONFIRM_TEXT 16 DRAW::draw-str
        APP::draw-fd 0 local@ 0 confirm-btn-y CONFIRM_BTN_W CONFIRM_BTN_H CLR_CONFIRM_BTN DRAW::fill-rect
        APP::draw-fd 0 local@ 68 + 0 confirm-btn-y 9 + T"Save" CLR_CONFIRM_TEXT 16 DRAW::draw-str
        APP::draw-fd 0 local@ 1 confirm-btn-y CONFIRM_BTN_W CONFIRM_BTN_H CLR_CONFIRM_BTN DRAW::fill-rect
        APP::draw-fd 0 local@ 34 + 1 confirm-btn-y 9 + T"Don't Save" CLR_CONFIRM_TEXT 16 DRAW::draw-str
        APP::draw-fd 0 local@ 2 confirm-btn-y CONFIRM_BTN_W CONFIRM_BTN_H CLR_CONFIRM_BTN DRAW::fill-rect
        APP::draw-fd 0 local@ 52 + 2 confirm-btn-y 9 + T"Cancel" CLR_CONFIRM_TEXT 16 DRAW::draw-str
        3 unframe!
    ] ?
;

@confirm-new-mouse ( mpkt -- )
    1 frame! ( 0:mpkt )
    0 local@ EVENT::mouse-type EVENT::MOUSE_DOWN = [
        0 0 local@ EVENT::mouse-x 0 local@ EVENT::mouse-y confirm-hit-btn [
            save-file
            0 confirm-new-open STOREI
            0 APP::modal!
            new-document
        ] [
            1 0 local@ EVENT::mouse-x 0 local@ EVENT::mouse-y confirm-hit-btn [
                0 confirm-new-open STOREI
                0 APP::modal!
                new-document
            ] [
                2 0 local@ EVENT::mouse-x 0 local@ EVENT::mouse-y confirm-hit-btn [
                    0 confirm-new-open STOREI
                    0 APP::modal!
                    APP::dirty!
                ] ?
            ] ?:
        ] ?:
    ] ?
    1 unframe!
;

@confirm-new-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key EVENT::KEY_ESC = [
            0 confirm-new-open STOREI
            0 APP::modal!
            APP::dirty!
        ] ?
    ] ?
    drop
;

@edit-pat-draw ( -- )
    edit-pat-open LOADI [
        APP::draw-fd 0 0 WIN_W WIN_H CLR_CONFIRM_DIM DRAW::fill-rect
        APP::draw-fd EPAT_PANEL_X EPAT_PANEL_Y EPAT_PANEL_W EPAT_PANEL_H CLR_CONFIRM_PANEL DRAW::fill-rect
        APP::draw-fd EPAT_PANEL_X EPAT_PANEL_Y EPAT_PANEL_W 1 CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd EPAT_PANEL_X EPAT_PANEL_Y EPAT_PANEL_H + 1 - EPAT_PANEL_W 1 CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd EPAT_PANEL_X EPAT_PANEL_Y 1 EPAT_PANEL_H CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd EPAT_PANEL_X EPAT_PANEL_W + 1 - EPAT_PANEL_Y 1 EPAT_PANEL_H CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd EPAT_PANEL_X 12 + EPAT_PANEL_Y 8 + T"Edit Pattern" CLR_CONFIRM_TEXT 16 DRAW::draw-str
        0 { row }
            [ row 8 < ]
            [
                0 { col }
                    [ col 8 < ]
                    [
                        edit-pat-id LOADI col row epat-bit 0 = [ CLR_WHITE ] [ CLR_FG ] ?: { cc }
                            APP::draw-fd
                                EPAT_GRID_X col EPAT_CELL * +
                                EPAT_GRID_Y row EPAT_CELL * +
                                EPAT_CELL 1 - EPAT_CELL 1 - cc DRAW::fill-rect
                        UNGIRD
                        col 1 + col!
                    ] |:
                UNGIRD
                row 1 + row!
            ] |:
        UNGIRD
        APP::draw-fd EPAT_GRID_X EPAT_GRID_Y EPAT_GRID EPAT_GRID CLR_CONFIRM_BORDER DRAW::frame-rect
        APP::draw-fd EPAT_OK_X EPAT_BTN_Y EPAT_BTN_W EPAT_BTN_H CLR_CONFIRM_BTN DRAW::fill-rect
        APP::draw-fd EPAT_OK_X 24 + EPAT_BTN_Y 6 + T"OK" CLR_CONFIRM_TEXT 16 DRAW::draw-str
        APP::draw-fd EPAT_CANCEL_X EPAT_BTN_Y EPAT_BTN_W EPAT_BTN_H CLR_CONFIRM_BTN DRAW::fill-rect
        APP::draw-fd EPAT_CANCEL_X 10 + EPAT_BTN_Y 6 + T"Cancel" CLR_CONFIRM_TEXT 16 DRAW::draw-str
    ] ?
;

@epat-in-btn? { bx by mx my -- f }
    mx bx >= mx bx EPAT_BTN_W + < AND
    my by >= AND my by EPAT_BTN_H + < AND
;

( OK and Cancel both just close the modal -- every toggle already wrote
  straight into PATTERNS, so there is nothing to commit/discard. )
@edit-pat-mouse { mpkt -- }
    mpkt EVENT::mouse-type EVENT::MOUSE_DOWN = [
        mpkt EVENT::mouse-x { mx }
            mpkt EVENT::mouse-y { my }
                EPAT_OK_X EPAT_BTN_Y mx my epat-in-btn?
                EPAT_CANCEL_X EPAT_BTN_Y mx my epat-in-btn? OR [
                    0 edit-pat-open STOREI
                    0 APP::modal!
                    APP::dirty!
                ] [
                    mx EPAT_GRID_X >= mx EPAT_GRID_X EPAT_GRID + < AND
                    my EPAT_GRID_Y >= AND my EPAT_GRID_Y EPAT_GRID + < AND [
                        edit-pat-id LOADI
                        mx EPAT_GRID_X - EPAT_CELL /
                        my EPAT_GRID_Y - EPAT_CELL /
                        epat-toggle
                        APP::dirty!
                    ] ?
                ] ?:
            UNGIRD
        UNGIRD
    ] ?
;

@edit-pat-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key EVENT::KEY_ESC = [
            0 edit-pat-open STOREI
            0 APP::modal!
            APP::dirty!
        ] ?
    ] ?
    drop
;

@menu-edit-pat ( val -- )
    drop
    pat-id LOADI edit-pat-id STOREI
    1 edit-pat-open STOREI
    1 APP::modal!
    APP::dirty!
;

@br-cell-xy { bi -- x y }
    BR_GRID_X bi BR_COLS MOD BR_CELL * +
    BR_GRID_Y bi BR_COLS / BR_CELL * +
;

@brush-pick-draw ( -- )
    brush-pick-open LOADI [
        APP::draw-fd 0 0 WIN_W WIN_H CLR_CONFIRM_DIM DRAW::fill-rect
        APP::draw-fd BR_PANEL_X BR_PANEL_Y BR_PANEL_W BR_PANEL_H CLR_CONFIRM_PANEL DRAW::fill-rect
        APP::draw-fd BR_PANEL_X BR_PANEL_Y BR_PANEL_W 1 CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd BR_PANEL_X BR_PANEL_Y BR_PANEL_H + 1 - BR_PANEL_W 1 CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd BR_PANEL_X BR_PANEL_Y 1 BR_PANEL_H CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd BR_PANEL_X BR_PANEL_W + 1 - BR_PANEL_Y 1 BR_PANEL_H CLR_CONFIRM_BORDER DRAW::fill-rect
        APP::draw-fd BR_PANEL_X 12 + BR_PANEL_Y 8 + T"Brush Shape" CLR_CONFIRM_TEXT 16 DRAW::draw-str
        0 { bi }
            [ bi BR_COUNT < ]
            [
                bi br-cell-xy { cx cy }
                    bi brush-index LOADI = [
                        APP::draw-fd cx cy BR_CELL 1 - BR_CELL 1 - CLR_CONFIRM_BTN DRAW::fill-rect
                    ] ?
                    APP::draw-fd cx cy BR_CELL 2 - BR_CELL 2 - CLR_CONFIRM_BORDER DRAW::frame-rect
                    0 { row }
                        [ row BR_SIZE < ]
                        [
                            0 { col }
                                [ col BR_SIZE < ]
                                [
                                    bi col row brush-get-bit 0 > [
                                        APP::draw-fd cx 4 + col + cy 4 + row + CLR_CONFIRM_TEXT DRAW::pix
                                    ] ?
                                    col 1 + col!
                                ] |:
                            UNGIRD
                            row 1 + row!
                        ] |:
                    UNGIRD
                UNGIRD
                bi 1 + bi!
            ] |:
        UNGIRD
    ] ?
;

@brush-pick-mouse { mpkt -- }
    mpkt EVENT::mouse-type EVENT::MOUSE_DOWN = [
        mpkt EVENT::mouse-x { mx }
            mpkt EVENT::mouse-y { my }
                mx BR_GRID_X >= mx BR_GRID_X BR_CELL BR_COLS * + < AND
                my BR_GRID_Y >= AND my BR_GRID_Y BR_CELL BR_ROWS * + < AND [
                    mx BR_GRID_X - BR_CELL /
                    my BR_GRID_Y - BR_CELL / BR_COLS * +
                    dup BR_COUNT < [
                        brush-index STOREI
                        0 brush-pick-open STOREI
                        0 APP::modal!
                    ] [ drop ] ?:
                    APP::dirty!
                ] ?
            UNGIRD
        UNGIRD
    ] ?
;

@brush-pick-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key EVENT::KEY_ESC = [
            0 brush-pick-open STOREI
            0 APP::modal!
            APP::dirty!
        ] ?
    ] ?
    drop
;

@menu-brush-pick ( val -- )
    drop
    1 brush-pick-open STOREI
    1 APP::modal!
    APP::dirty!
;

@on-pick ( path -- )
    save-as LOADI [
        0 save-as STOREI
        dup load-byte 47 = [ 1 + ] ?
        PATH STR::strcpy
        save-file
    ] [
        load-path
    ] ?:
;
@on-cancel ( -- )
    0 save-as STOREI
    APP::dirty!
;

@menu-new ( -- )
    file-dirty LOADI [
        1 confirm-new-open STOREI
        1 APP::modal!
        APP::dirty!
    ] [
        new-document
    ] ?:
;

@menu-open ( -- ) SF::show ;
@menu-save-as ( -- )
    1 save-as STOREI
    PATH SF::show-save
;
@menu-quit ( -- ) HALT ;
@menu-undo ( val -- ) drop do-undo ;
@menu-invert ( val -- ) drop do-invert ;
@menu-clear ( val -- ) drop do-clear ;
@menu-fill ( val -- ) drop do-fill ;
@menu-trace-edges ( val -- ) drop do-trace-edges ;
@menu-flip-h ( val -- ) drop do-flip-h ;
@menu-flip-v ( val -- ) drop do-flip-v ;
@menu-rotate90 ( val -- ) drop do-rotate90 ;
@menu-grid ( val -- ) grid-f STOREI APP::dirty! ;
@menu-fat ( val -- )
    fat-f STOREI
    clamp-fat
    APP::dirty!
;

( --- Draw --- )

( Tools with real behavior get a proper icon; the ten not yet implemented
  (Steps 5/7/8 and the rest of Step 4) get their index number so the
  palette is legible without pretending they work. )
@draw-tool-icon { i x y color -- }
    i TOOL_LASSO = [
        APP::draw-fd x 6 + y 6 + 12 8 color DRAW::frame-oval
    ] [
    i TOOL_MARQUEE = [
        APP::draw-fd x 6 + y 5 + 13 11 color DRAW::frame-rect
    ] [
    i TOOL_PENCIL = [
        APP::draw-fd x 7 + y 17 + x 18 + y 6 + color DRAW::line
        APP::draw-fd x 16 + y 4 + 4 4 color DRAW::fill-rect
    ] [
    i TOOL_ERASER = [
        APP::draw-fd x 7 + y 6 + 14 10 color DRAW::fill-rect
        APP::draw-fd x 7 + y 6 + 14 10 CLR_FG DRAW::frame-rect
    ] [
    i TOOL_BRUSH = [
        APP::draw-fd x 6 + y 5 + 12 12 color DRAW::paint-oval
        APP::draw-fd x 11 + y 14 + 3 4 color DRAW::fill-rect
    ] [
    i TOOL_FILL = [
        APP::draw-fd x 6 + y 5 + x 18 + y 5 + x 12 + y 16 + color DRAW::paint-tri
    ] [
    i TOOL_LINE = [
        APP::draw-fd x 6 + y 16 + x 18 + y 5 + color DRAW::line
    ] [
    i TOOL_RECT = [
        APP::draw-fd x 5 + y 4 + 15 13 color DRAW::frame-rect
    ] [
    i TOOL_RECT_FILLED = [
        APP::draw-fd x 5 + y 4 + 15 13 color DRAW::paint-rect
    ] [
    i TOOL_OVAL = [
        APP::draw-fd x 5 + y 4 + 15 13 color DRAW::frame-oval
    ] [
    i TOOL_OVAL_FILLED = [
        APP::draw-fd x 5 + y 4 + 15 13 color DRAW::paint-oval
    ] [
    i TOOL_ROUNDRECT = [
        APP::draw-fd x 6 + y 5 + 13 11 color DRAW::frame-rect
    ] [
    i TOOL_ROUNDRECT_FILLED = [
        APP::draw-fd x 6 + y 5 + 13 11 color DRAW::paint-rect
    ] [
    i TOOL_SPRAY = [
        APP::draw-fd x 8 + y 6 + color DRAW::pix
        APP::draw-fd x 13 + y 4 + color DRAW::pix
        APP::draw-fd x 11 + y 10 + color DRAW::pix
        APP::draw-fd x 16 + y 8 + color DRAW::pix
        APP::draw-fd x 9 + y 14 + color DRAW::pix
        APP::draw-fd x 14 + y 15 + color DRAW::pix
        APP::draw-fd x 17 + y 12 + color DRAW::pix
    ] [
        APP::draw-fd x 12 + y 5 + i color 0 DRAW::draw-int
    ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
;

@draw-palette ( -- )
    APP::draw-fd PAL_X PAL_Y PAL_W LW_Y PAL_Y - CLR_PAL DRAW::fill-rect
    APP::draw-fd PAL_W 1 - PAL_Y 1 LW_Y PAL_Y - CLR_FRAME DRAW::fill-rect
    0 { i }
        [ i TOOLS < ]
        [
            i tool-xy { x y }
                i tool LOADI = [
                    APP::draw-fd x y PAL_CELL_W PAL_CELL_H CLR_FG DRAW::fill-rect
                    i x y CLR_WHITE draw-tool-icon
                ] [
                    APP::draw-fd x y PAL_CELL_W PAL_CELL_H CLR_WHITE DRAW::fill-rect
                    APP::draw-fd x y PAL_CELL_W PAL_CELL_H CLR_FG DRAW::frame-rect
                    i x y CLR_FG draw-tool-icon
                ] ?:
            UNGIRD
            i 1 + i!
        ] |:
    UNGIRD
;

( 19x2 swatch grid; the always-visible current-pattern preview at x 0..35 is
  drawn separately by draw-current-pat. )
@draw-pat-cell { i -- }
    PAT_CUR_W i PAT_COLS MOD PAT_CELL_W * + { x }
        PAT_Y i PAT_COLS / PAT_CELL_H * + { y }
            i pat-id LOADI = [
                APP::draw-fd x y PAT_CELL_W PAT_CELL_H CLR_FG DRAW::fill-rect
                APP::draw-fd x 2 + y 2 + PAT_CELL_W 4 - PAT_CELL_H 4 - CLR_WHITE DRAW::fill-rect
            ] [
                APP::draw-fd x y PAT_CELL_W PAT_CELL_H CLR_FG DRAW::frame-rect
                APP::draw-fd x 1 + y 1 + PAT_CELL_W 2 - PAT_CELL_H 2 - CLR_WHITE DRAW::fill-rect
            ] ?:
            0 { py }
                [ py 16 < ]
                [
                    0 { px }
                        [ px 16 < ]
                        [
                            PATTERNS i 8 * + py 7 AND + load-byte
                            128 px 7 AND RSHIFT AND [
                                APP::draw-fd x 2 + px + y 2 + py + CLR_FG DRAW::pix
                            ] ?
                            px 1 + px!
                        ] |:
                    UNGIRD
                    py 1 + py!
                ] |:
            UNGIRD
        UNGIRD
    UNGIRD
;

( Always-visible preview of the selected pattern, at the pattern strip's
  left edge (x 0..PAT_CUR_W-1) -- separate from the 19x2 swatch grid, which
  only shows a selection outline on its own cell. )
@draw-current-pat ( -- )
    APP::draw-fd 0 PAT_Y PAT_CUR_W WIN_H PAT_Y - CLR_WHITE DRAW::fill-rect
    APP::draw-fd 0 PAT_Y PAT_CUR_W WIN_H PAT_Y - CLR_FG DRAW::frame-rect
    0 { py }
        [ py 32 < ]
        [
            0 { px }
                [ px 32 < ]
                [
                    PATTERNS pat-id LOADI 8 * + py 7 AND + load-byte
                    128 px 7 AND RSHIFT AND [
                        APP::draw-fd 2 px + PAT_Y 2 + py + CLR_FG DRAW::pix
                    ] ?
                    px 1 + px!
                ] |:
            UNGIRD
            py 1 + py!
        ] |:
    UNGIRD
;

( PATTERNS is static once loaded -- the pixel content of every swatch never
  changes, only which one is selected. Redrawing all PAT_N swatches (each up
  to 256 per-pixel DRAW::pix calls) every dirty frame was a needless cost
  comparable to the Illumos glyph-collection bug, so draw-patterns now does
  that full pass once and, after that, only the 1-2 swatches whose selection
  state actually changed. )
@draw-patterns ( -- )
    damage LOADI DIRTY_PATS AND 0 > [
        0 { i }
            [ i PAT_N < ]
            [
                i draw-pat-cell
                i 1 + i!
            ] |:
        UNGIRD
    ] [
        last-pat-id LOADI dup -1 > [ draw-pat-cell ] [ drop ] ?:
        pat-id LOADI draw-pat-cell
    ] ?:
    draw-current-pat
    pat-id LOADI last-pat-id STOREI
;

( No in-window status bar (Step 9): filename/dirty state lives in the window
  title via sync-title, already wired to every file-dirty change. )

( LW_VALUES: 0 (hairline, 1px -- authentic MacPaint's dotted-line style for
  this slot is not implemented), then 1/2/3/4/8 px. Consumed by
  stroke-to-w/frame-rect-pix-w/frame-oval-pix-w for TOOL_LINE and the
  rect/oval outline in commit-shape. )
@lw-value { i -- w }
    i 0 = [ 0 ] [
    i 1 = [ 1 ] [
    i 2 = [ 2 ] [
    i 3 = [ 3 ] [
    i 4 = [ 4 ] [
        8
    ] ?: ] ?: ] ?: ] ?: ] ?:
;

@draw-linewidths ( -- )
    APP::draw-fd PAL_X LW_Y PAL_W LW_ROWS LW_ROW_H * CLR_PAL DRAW::fill-rect
    0 { i }
        [ i LW_ROWS < ]
        [
            LW_Y i LW_ROW_H * + { y }
                i pen-width LOADI = { sel }
                    sel [
                        APP::draw-fd PAL_X y PAL_W LW_ROW_H CLR_FG DRAW::fill-rect
                    ] ?
                    sel [ CLR_WHITE ] [ CLR_FG ] ?: { lc }
                        i lw-value { w }
                            w 0 = [
                                APP::draw-fd 10 y LW_ROW_H 2 / + PAL_W 20 - 1 lc DRAW::fill-rect
                            ] [
                                APP::draw-fd 10 y LW_ROW_H w - 2 / + PAL_W 20 - w lc DRAW::fill-rect
                            ] ?:
                        UNGIRD
                    UNGIRD
                UNGIRD
            UNGIRD
            i 1 + i!
        ] |:
    UNGIRD
;

@hit-lw { mx my -- idx }
    mx PAL_X >= mx PAL_W < AND my LW_Y >= AND my PAT_Y < AND [
        my LW_Y - LW_ROW_H / 0 MAX LW_ROWS 1 - MIN
    ] [ -1 ] ?:
;

@draw-grid-dots ( -- )
    grid-f LOADI fat-f LOADI 0 = AND [
        0 { x }
            [ x CANVAS_W < ]
            [
                0 { y }
                    [ y CANVAS_H < ]
                    [
                        APP::draw-fd CANVAS_X x + CANVAS_Y y + CLR_GRID DRAW::pix
                        y GRID + y!
                    ] |:
                UNGIRD
                x GRID + x!
            ] |:
        UNGIRD
    ] ?
;

@draw-fat-grid ( -- )
    0 { vx }
        [ vx FAT_VW < ]
        [
            APP::draw-fd CANVAS_X vx FAT_Z * + CANVAS_Y 1 FAT_VH FAT_Z * CLR_GRID DRAW::fill-rect
            vx 1 + vx!
        ] |:
    UNGIRD
    0 { vy }
        [ vy FAT_VH < ]
        [
            APP::draw-fd CANVAS_X CANVAS_Y vy FAT_Z * + FAT_VW FAT_Z * 1 CLR_GRID DRAW::fill-rect
            vy 1 + vy!
        ] |:
    UNGIRD
;

( Word-at-a-time: an all-white 32-pixel word is skipped in one word@ + compare
  instead of 32 pixel tests. CANVAS_W is exactly CANVAS_WORDS*32 for now, so
  every word is fully in-bounds -- no edge masking needed here (unlike
  BITMAP::hspan, which does need it for arbitrary spans). )
( CANVAS_W is a multiple of 32 (word width), so every word in a row is fully
  in-bounds -- no edge masking needed, unlike BITMAP::hspan's general case. )
@draw-canvas-1x ( -- )
    0 { y }
        [ y CANVAS_H < ]
        [
            0 { wx }
                [ wx CANVAS_WORDS < ]
                [
                    CANVAS wx y BITMAP::word@ { w }
                        w 0 = [
                        ] [
                            0 { bit }
                                [ bit 32 < ]
                                [
                                    w 31 bit - RSHIFT 1 AND [
                                        bit { rstart }
                                            [ bit 32 < w 31 bit - RSHIFT 1 AND AND ]
                                            [ bit 1 + bit! ] |:
                                            APP::draw-fd CANVAS_X wx 32 * rstart + +
                                                CANVAS_Y y + bit rstart - 1 CLR_FG DRAW::fill-rect
                                        UNGIRD
                                    ] [
                                        bit 1 + bit!
                                    ] ?:
                                ] |:
                            UNGIRD
                        ] ?:
                    UNGIRD
                    wx 1 + wx!
                ] |:
            UNGIRD
            y 1 + y!
        ] |:
    UNGIRD
;

( FAT_VW x FAT_VH (64x42) is small and fat-ox is not generally word-aligned,
  so this stays a plain per-pixel scan through pix@ -- correct and cheap
  enough at this size; the word-skip optimization above is what matters for
  the full CANVAS_W x CANVAS_H repaint. )
@draw-canvas-fat ( -- )
    0 0 0 0 { vy cy vx vx0 }
        [ vy FAT_VH < ]
        [
            fat-oy LOADI vy + cy!
            0 vx!
                [ vx FAT_VW < ]
                [
                    fat-ox LOADI vx + cy pix@ [
                        vx vx0!
                        [ vx FAT_VW < fat-ox LOADI vx + cy pix@ AND ]
                        [ vx 1 + vx! ] |:
                        APP::draw-fd CANVAS_X vx0 FAT_Z * + CANVAS_Y vy FAT_Z * +
                            vx vx0 - FAT_Z * FAT_Z CLR_FG DRAW::fill-rect
                    ] [
                        vx 1 + vx!
                    ] ?:
                ] |:
            vy 1 + vy!
        ] |:
    UNGIRD
;

@draw-canvas ( -- )
    APP::draw-fd CANVAS_X CANVAS_Y CANVAS_W CANVAS_H CLR_PAGE DRAW::fill-rect
    APP::draw-fd CANVAS_X 1 - CANVAS_Y 1 - CANVAS_W 2 + CANVAS_H 2 + CLR_FRAME DRAW::frame-rect
    fat-f LOADI [
        draw-canvas-fat
        draw-fat-grid
    ] [
        draw-canvas-1x
        draw-grid-dots
    ] ?:
;

@draw-rubber ( -- )
    drag LOADI DRAG_SHAPE = [
        shape-x0 LOADI shape-y0 LOADI can>scr { x0 y0 }
            shape-x1 LOADI shape-y1 LOADI can>scr { x1 y1 }
                tool LOADI TOOL_LINE = [
                    APP::draw-fd x0 y0 x1 y1 CLR_FG DRAW::line
                ] [
                    x0 y0 x1 y1 GEOM::rect-canon GEOM::rect>xywh { x y w h }
                        w 1 < [ 1 w! ] ?
                        h 1 < [ 1 h! ] ?
                        tool LOADI TOOL_OVAL = [
                            APP::draw-fd x y w h CLR_FG DRAW::frame-oval
                        ] [
                            APP::draw-fd x y w h CLR_FG DRAW::frame-rect
                        ] ?:
                    UNGIRD
                ] ?:
            UNGIRD
        UNGIRD
    ] ?
;

( The rule that fixes bug 1 (swatches vanishing): the blanket background wipe
  only runs when DIRTY_CHROME is set, and draw-patterns' own full-vs-partial
  choice is driven by the same damage word -- so a region is never cleared
  without also being the thing that gets redrawn on top of it this frame. )
@draw-damaged ( -- )
    damage LOADI DIRTY_CHROME AND 0 > [
        APP::draw-fd 0 0 WIN_W WIN_H CLR_BG DRAW::fill-rect
    ] ?
    draw-canvas
    draw-rubber
    draw-selection
    draw-palette
    draw-linewidths
    draw-patterns
    UI::draw
    SF::open? [ SF::draw ] ?
    confirm-new-draw
    edit-pat-draw
    brush-pick-draw
    0 damage STOREI
;

( draw-damaged skips most of draw-patterns' work and the background wipe once
  steady-state (see draw-patterns / DIRTY_CHROME above); a resume needs the
  full repaint since the whole window was just cleared/hidden underneath us. )
@resume-draw-all ( -- )
    DIRTY_ALL damage!
    draw-damaged
;

( --- Paint a finished shape into the bitmap --- )

( RECT_FILLED/OVAL_FILLED are their own palette buttons (see the TOOL_*
  block at the top) rather than a separate filled-f toggle -- `tool` alone
  says both the shape and whether it's filled. )
@shape-is-oval? ( -- f )
    tool LOADI TOOL_OVAL =
    tool LOADI TOOL_OVAL_FILLED = OR
;

@shape-is-roundrect? ( -- f )
    tool LOADI TOOL_ROUNDRECT =
    tool LOADI TOOL_ROUNDRECT_FILLED = OR
;

@shape-filled? ( -- f )
    tool LOADI TOOL_RECT_FILLED =
    tool LOADI TOOL_OVAL_FILLED = OR
    tool LOADI TOOL_ROUNDRECT_FILLED = OR
;

@commit-shape ( -- )
    shape-x0 LOADI shape-y0 LOADI shape-x1 LOADI shape-y1 LOADI
    tool LOADI apply-shift { x1 y1 }
        shape-x0 LOADI { x0 }
            shape-y0 LOADI { y0 }
                tool LOADI TOOL_LINE = [
                    x0 y0 x1 y1 pen-width LOADI lw-value stroke-to-w
                ] [
                    x0 y0 x1 y1 canon-xy { minx miny maxx maxy }
                        maxx minx - 1 + { w }
                            maxy miny - 1 + { h }
                                shape-is-oval? [
                                    shape-filled? [ minx miny w h fill-oval-pat ] ?
                                    minx miny w h pen-width LOADI lw-value frame-oval-pix-w
                                ] [
                                shape-is-roundrect? [
                                    shape-filled? [ minx miny maxx maxy fill-roundrect-pat ] ?
                                    minx miny maxx maxy pen-width LOADI lw-value frame-roundrect-pix-w
                                ] [
                                    shape-filled? [ minx miny maxx maxy fill-rect-pat ] ?
                                    minx miny maxx maxy pen-width LOADI lw-value frame-rect-pix-w
                                ] ?: ] ?:
                            UNGIRD
                        UNGIRD
                    UNGIRD
                ] ?:
            UNGIRD
        UNGIRD
    UNGIRD
    mark-dirty
;

@set-plot-mode ( -- )
    tool LOADI
    dup TOOL_PENCIL = [
        drop
        erase-btn LOADI [ MODE_WHITE ] [ MODE_BLACK ] ?:
        plot-mode STOREI
    ] [
    dup TOOL_ERASER = [ drop MODE_ERASE plot-mode STOREI ] [
    dup TOOL_BRUSH = [ drop MODE_BRUSH plot-mode STOREI ] [
        drop MODE_SPRAY plot-mode STOREI
    ] ?: ] ?: ] ?:
;

@paint-tool? ( -- f )
    tool LOADI TOOL_PENCIL =
    tool LOADI TOOL_ERASER = OR
    tool LOADI TOOL_BRUSH = OR
    tool LOADI TOOL_SPRAY = OR
;

@shape-tool? ( -- f )
    tool LOADI TOOL_LINE =
    tool LOADI TOOL_RECT = OR
    tool LOADI TOOL_RECT_FILLED = OR
    tool LOADI TOOL_OVAL = OR
    tool LOADI TOOL_OVAL_FILLED = OR
    tool LOADI TOOL_ROUNDRECT = OR
    tool LOADI TOOL_ROUNDRECT_FILLED = OR
;

( Gates hit-tool's palette clicks: HAND/TEXT/FREEFORM*/POLYGON* are
  visible in the palette but not wired to anything yet, so clicking them
  is a no-op rather than leaving `tool` pointing at a slot
  nothing else recognizes. )
@tool-implemented? { t -- f }
    t TOOL_FILL = t TOOL_SPRAY = OR t TOOL_BRUSH = OR t TOOL_PENCIL = OR
    t TOOL_LINE = OR t TOOL_ERASER = OR
    t TOOL_RECT = OR t TOOL_RECT_FILLED = OR
    t TOOL_OVAL = OR t TOOL_OVAL_FILLED = OR
    t TOOL_ROUNDRECT = OR t TOOL_ROUNDRECT_FILLED = OR
    t TOOL_MARQUEE = OR t TOOL_LASSO = OR
;

@page-down { mx my -- }
    mx my scr>can clip-can { cx cy }
        tool LOADI TOOL_FILL = [
            snapshot
            cx cy flood-from
            mark-dirty
        ] [
        tool LOADI TOOL_MARQUEE = [
            cx cy in-sel? [
                cx last-cx STOREI
                cy last-cy STOREI
                0 move-dx STOREI
                0 move-dy STOREI
                sel-lift
                DRAG_MOVE drag STOREI
            ] [
                cx sel-x0 STOREI
                cy sel-y0 STOREI
                cx sel-x1 STOREI
                cy sel-y1 STOREI
                0 sel-active STOREI
                0 sel-mask-active STOREI
                DRAG_MARQUEE drag STOREI
            ] ?:
            APP::dirty!
        ] [
        tool LOADI TOOL_LASSO = [
            cx cy in-sel? [
                cx last-cx STOREI
                cy last-cy STOREI
                0 move-dx STOREI
                0 move-dy STOREI
                sel-lift
                DRAG_MOVE drag STOREI
            ] [
                sel-mask-clear
                cx lasso-start-cx STOREI
                cy lasso-start-cy STOREI
                cx lasso-minx STOREI
                cx lasso-maxx STOREI
                cy lasso-miny STOREI
                cy lasso-maxy STOREI
                cx last-cx STOREI
                cy last-cy STOREI
                cx cy lasso-plot
                0 sel-active STOREI
                DRAG_LASSO drag STOREI
            ] ?:
            APP::dirty!
        ] [
        paint-tool? [
            snapshot
            set-plot-mode
            cx last-cx STOREI
            cy last-cy STOREI
            cx cy plot-at
            DRAG_PAINT drag STOREI
            mark-dirty
        ] [
        shape-tool? [
            snapshot
            cx shape-x0 STOREI
            cy shape-y0 STOREI
            cx shape-x1 STOREI
            cy shape-y1 STOREI
            DRAG_SHAPE drag STOREI
            APP::dirty!
        ] ? ] ?: ] ?: ] ?: ] ?:
    UNGIRD
;

@page-drag { mx my -- }
    mx my scr>can clip-can { cx cy }
        drag LOADI DRAG_PAINT = [
            last-cx LOADI last-cy LOADI cx cy stroke-to
            cx last-cx STOREI
            cy last-cy STOREI
            mark-dirty
        ] ?
        drag LOADI DRAG_SHAPE = [
            shape-x0 LOADI shape-y0 LOADI cx cy tool LOADI apply-shift
            shape-y1 STOREI
            shape-x1 STOREI
            APP::dirty!
        ] ?
        drag LOADI DRAG_MARQUEE = [
            cx sel-x1 STOREI
            cy sel-y1 STOREI
            APP::dirty!
        ] ?
        drag LOADI DRAG_MOVE = [
            cx last-cx LOADI - move-dx STOREI
            cy last-cy LOADI - move-dy STOREI
            APP::dirty!
        ] ?
        drag LOADI DRAG_LASSO = [
            last-cx LOADI last-cy LOADI cx cy lasso-line
            cx last-cx STOREI
            cy last-cy STOREI
            cx lasso-minx LOADI MIN lasso-minx STOREI
            cx lasso-maxx LOADI MAX lasso-maxx STOREI
            cy lasso-miny LOADI MIN lasso-miny STOREI
            cy lasso-maxy LOADI MAX lasso-maxy STOREI
            APP::dirty!
        ] ?
    UNGIRD
;

( -1 for a click inside the current-pattern preview box (x < PAT_CUR_W) --
  that box doesn't pick a swatch; a future Edit Pattern double-click will
  live there instead (Step 4). )
@hit-pat { mx my -- idx }
    mx PAT_CUR_W < [
        -1
    ] [
        mx PAT_CUR_W - PAT_CELL_W / 0 MAX PAT_COLS 1 - MIN { col }
            my PAT_Y - PAT_CELL_H / 0 MAX PAT_ROWS 1 - MIN { row }
                row PAT_COLS * col +
            UNGIRD
        UNGIRD
    ] ?:
;

@handle-page-mouse { mpkt -- }
    mpkt EVENT::mouse-x { mx }
    mpkt EVENT::mouse-y { my }
    mpkt EVENT::mouse-type EVENT::MOUSE_DOWN = [
        ( Read the erase-button latch only here: the host hardcodes btn=0 for
          MOUSE_MOVE packets (src/cloister.c), so sampling it on every packet
          made a move after a right-button down silently look left-button. )
        mpkt EVENT::mouse-btn 1 = 0 = erase-btn STOREI
        1 mouse-held STOREI
        mx my hit-tool { t }
            t 0 >= [
                t tool-implemented? [
                    t TOOL_MARQUEE = t TOOL_LASSO = OR 0 = sel-active LOADI AND [
                        0 sel-active STOREI
                    ] ?
                    t tool STOREI
                    DRAG_NONE drag STOREI
                    t TOOL_BRUSH = [
                        TIME::milli@ { now }
                            t br-last-idx LOADI =
                            now br-last-time LOADI - 400 < AND [
                                1 brush-pick-open STOREI
                                1 APP::modal!
                            ] ?
                            now br-last-time STOREI
                        UNGIRD
                    ] ?
                    t br-last-idx STOREI
                    APP::dirty!
                ] ?
            ] [
                mx my in-pat? [
                    mx my hit-pat { pi }
                        pi 0 >= [
                            TIME::milli@ { now }
                                pi epat-last-idx LOADI =
                                now epat-last-time LOADI - 400 < AND [
                                    pi edit-pat-id STOREI
                                    1 edit-pat-open STOREI
                                    1 APP::modal!
                                ] ?
                                now epat-last-time STOREI
                            UNGIRD
                            pi epat-last-idx STOREI
                            pi pat-id STOREI
                            APP::dirty!
                        ] ?
                    UNGIRD
                ] [
                    mx my hit-lw { li }
                        li 0 >= [
                            li pen-width STOREI
                            APP::dirty!
                        ] [
                            mx my in-page? [
                                mx my page-down
                            ] ?
                        ] ?:
                    UNGIRD
                ] ?:
            ] ?:
        UNGIRD
    ] ?
    mpkt EVENT::mouse-type EVENT::MOUSE_MOVE = mouse-held LOADI AND [
        mx my page-drag
    ] ?
    mpkt EVENT::mouse-type EVENT::MOUSE_UP = [
        0 mouse-held STOREI
        drag LOADI DRAG_SHAPE = [ commit-shape ] ?
        drag LOADI DRAG_MARQUEE = [ commit-marquee ] ?
        ( sel-mask-active drops back to plain-bbox after one move -- see
          sel-drop's comment; a lasso selection keeps its exact shape only
          for its first move. )
        drag LOADI DRAG_MOVE = [ sel-drop 0 sel-mask-active STOREI mark-dirty ] ?
        drag LOADI DRAG_LASSO = [
            last-cx LOADI last-cy LOADI lasso-start-cx LOADI lasso-start-cy LOADI lasso-line
            lasso-finish
            mark-dirty
        ] ?
        DRAG_NONE drag STOREI
        APP::dirty!
    ] ?
;

@on-mouse ( mpkt -- )
    confirm-new-open LOADI [
        confirm-new-mouse
    ] [
    edit-pat-open LOADI [
        edit-pat-mouse
    ] [
    brush-pick-open LOADI [
        brush-pick-mouse
    ] [
    SF::open? [
        SF::mouse
    ] [
        UI::menu-open? { was }
            dup UI::feed
            was UI::menu-open? OR [
                drop
                APP::dirty!
            ] [
                handle-page-mouse
            ] ?:
        UNGIRD
    ] ?:
    ] ?:
    ] ?:
    ] ?:
;

( --- Keyboard --- )

@cycle-pat { d -- }
    pat-id LOADI d +
    dup 0 < [ drop PAT_N 1 - ] ?
    dup PAT_N >= [ drop 0 ] ?
    pat-id STOREI
    APP::dirty!
;

@handle-cmd ( key mods -- )
    2 frame! ( 0:mods 1:key )
    1 local@ 32 OR
    dup 110 = [ drop menu-new ] [
    dup 111 = [ drop menu-open ] [
    dup 115 = [
        drop
        0 local@ EVENT::MOD_SHIFT AND [
            menu-save-as
        ] [
            save-file
        ] ?:
    ] [
    dup 122 = [ drop do-undo ] [
    dup 120 = [ drop do-cut ] [
    dup 99 = [ drop snarf-copy ] [
    dup 118 = [ drop snarf-paste ] [
    dup 102 = [ drop do-fill ] [
    dup 103 = [ drop do-trace-edges ] [
    dup 104 = [ drop do-flip-h ] [
    dup 106 = [ drop do-flip-v ] [
    dup 114 = [ drop do-rotate90 ] [
        drop
    ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
    2 unframe!
;

@on-kbd ( kpkt -- )
    confirm-new-open LOADI [
        confirm-new-kbd
    ] [
    edit-pat-open LOADI [
        edit-pat-kbd
    ] [
    brush-pick-open LOADI [
        brush-pick-kbd
    ] [
    SF::open? [
        SF::kbd
    ] [
        dup EVENT::kbd-mods EVENT::MOD_SHIFT AND shift-mod STOREI
        dup EVENT::kbd-type EVENT::KEY_DOWN = [
            dup EVENT::kbd-key EVENT::KEY_ESC = [
                sel-active LOADI [
                    0 sel-active STOREI
                    APP::dirty!
                ] ?
                UI::escape drop
            ] [
                dup EVENT::kbd-mods
                over EVENT::kbd-key
                2 frame! ( 0:key 1:mods )
                1 local@ EVENT::MOD_CMD AND 1 local@ EVENT::MOD_CTRL AND OR [
                    0 local@ 1 local@ handle-cmd
                ] [
                    0 local@ EVENT::KEY_LEFT_ARROW = [
                        fat-f LOADI [ -1 0 pan-fat ] ?
                    ] [
                    0 local@ EVENT::KEY_RIGHT_ARROW = [
                        fat-f LOADI [ 1 0 pan-fat ] ?
                    ] [
                    0 local@ EVENT::KEY_UP_ARROW = [
                        fat-f LOADI [ 0 -1 pan-fat ] ?
                    ] [
                    0 local@ EVENT::KEY_DOWN_ARROW = [
                        fat-f LOADI [ 0 1 pan-fat ] ?
                    ] [
                    0 local@ 91 = [
                        -1 cycle-pat
                    ] [
                    0 local@ 93 = [
                        1 cycle-pat
                    ] [
                    ] ?: ] ?: ] ?: ] ?: ] ?: ] ?:
                ] ?:
                2 unframe!
            ] ?:
            APP::dirty!
        ] ?
        drop
    ] ?:
    ] ?:
    ] ?:
    ] ?:
;

@on-frame ( -- )
    UI::handle
    APP::dirty? SF::open? OR confirm-new-open LOADI OR edit-pat-open LOADI OR
    brush-pick-open LOADI OR [
        draw-damaged
        APP::dirty-off
    ] [
        UI::draw
        SF::open? [ SF::draw ] ?
        confirm-new-draw
        edit-pat-draw
        brush-pick-draw
    ] ?:
;

@start
    T"Easel" APP::init
    APP::draw-fd DRAW::batch-begin
    APP::draw-fd FONT_SIZE DRAW::set-font-size
    UI::new
    WIN_W UI::menubar
    T"File" UI::menu
    T"New"  [ drop menu-new ]  UI::item
    T"Open" [ drop menu-open ] UI::item
    T"Save" [ drop save-file ] UI::item
    T"Save As" [ drop menu-save-as ] UI::item
    UI::sep
    T"Quit" [ drop menu-quit ] UI::item
    T"Edit" UI::menu
    T"Undo"   [ menu-undo ]   UI::item
    UI::sep
    T"Cut"    [ menu-cut ]    UI::item
    T"Copy"   [ menu-copy ]   UI::item
    T"Paste"  [ menu-paste ]  UI::item
    UI::sep
    T"Invert" [ menu-invert ] UI::item
    T"Clear"  [ menu-clear ]  UI::item
    UI::sep
    T"Fill"         [ menu-fill ]        UI::item
    T"Trace Edges"  [ menu-trace-edges ] UI::item
    T"Flip Horizontal" [ menu-flip-h ]   UI::item
    T"Flip Vertical"   [ menu-flip-v ]   UI::item
    T"Rotate 90"    [ menu-rotate90 ]    UI::item
    T"Goodies" UI::menu
    T"Grid"    [ menu-grid ]    UI::check-item
    T"FatBits" [ menu-fat ]     UI::check-item
    UI::sep
    T"Edit Pattern..." [ menu-edit-pat ] UI::item
    T"Brush Shape..." [ menu-brush-pick ] UI::item
    T"Grid" 0 UI::item-set
    T"FatBits" 0 UI::item-set
    [ on-pick ] SF::on-ok!
    [ on-cancel ] SF::on-cancel!
    init-pats
    init-brushes
    0 grid-f STOREI
    0 fat-f STOREI
    0 pen-width STOREI
    -1 last-pat-id STOREI
    0 edit-pat-open STOREI
    -1 epat-last-idx STOREI
    0 epat-last-time STOREI
    0 brush-index STOREI
    0 brush-pick-open STOREI
    -1 br-last-idx STOREI
    0 br-last-time STOREI
    0 sel-active STOREI
    0 sel-mask-active STOREI
    0 move-dx STOREI
    0 move-dy STOREI
    0 lasso-minx STOREI
    0 lasso-miny STOREI
    0 lasso-maxx STOREI
    0 lasso-maxy STOREI
    DIRTY_ALL damage!
    new-document
    [ on-mouse ] APP::on-mouse!
    [ on-kbd ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    [ resume-draw-all ] APP::on-resume!
    APP::dirty!
    APP::loop
;

MAIN::start
HALT
