( --- Calculator App (Modernized with APP framework) --- )

INCLUDE "lib/app.lux"
INCLUDE "lib/ui.lux"
INCLUDE "lib/draw.lux"
INCLUDE "lib/event.lux"

MODULE CALC

IMPORT APP
IMPORT UI
IMPORT VFS
IMPORT DRAW
IMPORT EVENT

( --- Calculator State --- )
@CALC_X   0x8D000C ;
@CALC_Y   0x8D0010 ;
@CUR_VAL  0x8D0020 ; ( Current input being typed )
@ACC_VAL  0x8D0024 ; ( Accumulator for operations )
@PEND_OP  0x8D0028 ; ( 0=None, 1=Add, 2=Sub, 3=Mul, 4=Div )
@DIRTY    0x8D002C ; ( 1 if needs redraw )
@NEW_NUM  0x8D0030 ; ( 1 if next digit should clear CUR_VAL )

@k7 55 process-key ; @k8 56 process-key ; @k9 57 process-key ; @kdiv 47 process-key ;
@k4 52 process-key ; @k5 53 process-key ; @k6 54 process-key ; @kmul 42 process-key ;
@k1 49 process-key ; @k2 50 process-key ; @k3 51 process-key ; @ksub 45 process-key ;
@kc 67 process-key ; @k0 48 process-key ; @keq 61 process-key ; @kadd 43 process-key ;

@place-key { name label cb x y -- }
    name UI::button
    CALC_X LOADI x +  CALC_Y LOADI y +
    CALC_X LOADI x + 48 +  CALC_Y LOADI y + 48 +
    UI::rect!
    label UI::text!
    cb UI::on-press!
    drop
;

@build-keys ( -- )
    T"7" T"7" $k7 10 65 place-key
    T"8" T"8" $k8 62 65 place-key
    T"9" T"9" $k9 114 65 place-key
    T"/" T"/" $kdiv 166 65 place-key
    T"4" T"4" $k4 10 117 place-key
    T"5" T"5" $k5 62 117 place-key
    T"6" T"6" $k6 114 117 place-key
    T"*" T"*" $kmul 166 117 place-key
    T"1" T"1" $k1 10 169 place-key
    T"2" T"2" $k2 62 169 place-key
    T"3" T"3" $k3 114 169 place-key
    T"-" T"-" $ksub 166 169 place-key
    T"C" T"C" $kc 10 221 place-key
    T"0" T"0" $k0 62 221 place-key
    T"=" T"=" $keq 114 221 place-key
    T"+" T"+" $kadd 166 221 place-key
;

@draw-ui
    CALC_X LOADI CALC_Y LOADI 2 frame! ( 0:by, 1:bx )
    APP::draw-fd 1 local@ 0 local@ 220 280 0x000000 DRAW::fill-rect
    APP::draw-fd 1 local@ 1 + 0 local@ 1 + 218 278 0xFFFFFF DRAW::fill-rect
    APP::draw-fd 1 local@ 10 + 0 local@ 10 + 200 45 0x000000 DRAW::fill-rect
    APP::draw-fd 1 local@ 11 + 0 local@ 11 + 198 43 0xFFFFFF DRAW::fill-rect
    APP::draw-fd 1 local@ 10 + 0 local@ 16 + CUR_VAL LOADI 0x000000 3 DRAW::draw-int
    2 unframe!
    UI::draw
;

@clear
    0 CUR_VAL STOREI
    0 ACC_VAL STOREI
    0 PEND_OP STOREI
    0 NEW_NUM STOREI
    1 DIRTY STOREI
;

@append-digit ( n -- )
    NEW_NUM LOADI [
        0 CUR_VAL STOREI
        0 NEW_NUM STOREI
    ] ?
    CUR_VAL LOADI 99999999 > [ drop ] [
        CUR_VAL LOADI 10 * + CUR_VAL STOREI
        1 DIRTY STOREI
    ] ?:
;

@backspace
    CUR_VAL LOADI 10 / CUR_VAL STOREI
    0 NEW_NUM STOREI
    1 DIRTY STOREI
;

@calculate
    PEND_OP LOADI 0 = [ ] [
        PEND_OP LOADI 1 = [ ACC_VAL LOADI CUR_VAL LOADI + ACC_VAL STOREI ] ?
        PEND_OP LOADI 2 = [ ACC_VAL LOADI CUR_VAL LOADI - ACC_VAL STOREI ] ?
        PEND_OP LOADI 3 = [ ACC_VAL LOADI CUR_VAL LOADI * ACC_VAL STOREI ] ?
        PEND_OP LOADI 4 = [ CUR_VAL LOADI 0 = [ 0 ] [ ACC_VAL LOADI CUR_VAL LOADI / ] ?: ACC_VAL STOREI ] ?
        
        ACC_VAL LOADI CUR_VAL STOREI
        0 PEND_OP STOREI
        1 NEW_NUM STOREI
        1 DIRTY STOREI
    ] ?:
;

@set-op ( op -- )
    PEND_OP LOADI 0 <> [ calculate ] ?
    PEND_OP STOREI
    CUR_VAL LOADI ACC_VAL STOREI
    1 NEW_NUM STOREI
    1 DIRTY STOREI
;

@process-key ( char -- )
    dup 48 >= [ dup 57 <= ] [ 0 ] ?: [ 48 - append-digit ] [
        dup 43 = [ 1 set-op ] ? ( + )
        dup 45 = [ 2 set-op ] ? ( - )
        dup 42 = [ 3 set-op ] ? ( * )
        dup 47 = [ 4 set-op ] ? ( / )
        dup 61 = [ calculate ] ? ( = )
        dup 13 = [ calculate ] ? ( Enter )
        dup 67 = [ clear ] ?     ( C )
        dup 99 = [ clear ] ?     ( c )
        dup 8 = [ backspace ] ?  ( Backspace )
        drop
    ] ?:
;

@on-mouse { mpkt -- }
    mpkt UI::mouse
;

@on-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key process-key
    ] ?
    drop
;

@on-frame ( -- )
    DIRTY LOADI [
        draw-ui
        0 DIRTY STOREI
    ] ?
;

@start
    T"Calculator" APP::init
    UI::ctlnew
    
    APP::width 220 - 2 / CALC_X STOREI
    APP::height 280 - 2 / CALC_Y STOREI
    build-keys
    
    1 DIRTY STOREI
    
    $on-mouse APP::on-mouse!
    [ on-kbd   ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    APP::loop
;

CALC::start
HALT
