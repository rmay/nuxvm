( --- Calculator App (Modernized with APP framework) --- )

INCLUDE "lib/app.lux"
INCLUDE "lib/ui.lux"
INCLUDE "lib/draw.lux"
INCLUDE "lib/event.lux"

MODULE CALC
VERSION 400000

IMPORT APP
IMPORT UI
IMPORT VFS
IMPORT DRAW
IMPORT EVENT

( --- Calculator State --- )
@CALC_X   0x8D000C ;
@CALC_Y   0x8D0010 ;
@CUR_VAL  0x8D0020 ; ( Current input being typed )
@ACC_VAL  0x8D0024 ; ( Accumulator for operations )
@PEND_OP  0x8D0028 ; ( 0=None, 1=Add, 2=Sub, 3=Mul, 4=Div )
@DIRTY    0x8D002C ; ( 1 if needs redraw )
@NEW_NUM  0x8D0030 ; ( 1 if next digit should clear CUR_VAL )

@k7 ( val -- ) drop 55 process-key ;
@k8 ( val -- ) drop 56 process-key ;
@k9 ( val -- ) drop 57 process-key ;
@kdiv ( val -- ) drop 47 process-key ;
@k4 ( val -- ) drop 52 process-key ;
@k5 ( val -- ) drop 53 process-key ;
@k6 ( val -- ) drop 54 process-key ;
@kmul ( val -- ) drop 42 process-key ;
@k1 ( val -- ) drop 49 process-key ;
@k2 ( val -- ) drop 50 process-key ;
@k3 ( val -- ) drop 51 process-key ;
@ksub ( val -- ) drop 45 process-key ;
@kc ( val -- ) drop 67 process-key ;
@k0 ( val -- ) drop 48 process-key ;
@keq ( val -- ) drop 61 process-key ;
@kadd ( val -- ) drop 43 process-key ;

@place-key ( label dx dy handler -- )
    4 frame! ( 0:handler 1:dy 2:dx 3:label )
    3 local@
    CALC_X LOADI 2 local@ +
    CALC_Y LOADI 1 local@ +
    48 48
    0 local@
    UI::button
    4 unframe!
;

@build-keys ( -- )
    T"7" 10 65 [ k7 ] place-key
    T"8" 62 65 [ k8 ] place-key
    T"9" 114 65 [ k9 ] place-key
    T"/" 166 65 [ kdiv ] place-key
    T"4" 10 117 [ k4 ] place-key
    T"5" 62 117 [ k5 ] place-key
    T"6" 114 117 [ k6 ] place-key
    T"*" 166 117 [ kmul ] place-key
    T"1" 10 169 [ k1 ] place-key
    T"2" 62 169 [ k2 ] place-key
    T"3" 114 169 [ k3 ] place-key
    T"-" 166 169 [ ksub ] place-key
    T"C" 10 221 [ kc ] place-key
    T"0" 62 221 [ k0 ] place-key
    T"=" 114 221 [ keq ] place-key
    T"+" 166 221 [ kadd ] place-key
;

@draw-ui
    CALC_X LOADI CALC_Y LOADI 2 frame! ( 0:by, 1:bx )
    APP::draw-fd 1 local@ 0 local@ 220 280 0x000000 DRAW::fill-rect
    APP::draw-fd 1 local@ 1 + 0 local@ 1 + 218 278 0xFFFFFF DRAW::fill-rect
    APP::draw-fd 1 local@ 10 + 0 local@ 10 + 200 45 0x000000 DRAW::fill-rect
    APP::draw-fd 1 local@ 11 + 0 local@ 11 + 198 43 0xFFFFFF DRAW::fill-rect
    APP::draw-fd 1 local@ 10 + 0 local@ 16 + CUR_VAL LOADI 0x000000 3 DRAW::draw-int
    2 unframe!
    UI::draw
;

@clear
    0 CUR_VAL STOREI
    0 ACC_VAL STOREI
    0 PEND_OP STOREI
    0 NEW_NUM STOREI
    1 DIRTY STOREI
;

@append-digit ( n -- )
    NEW_NUM LOADI [
        0 CUR_VAL STOREI
        0 NEW_NUM STOREI
    ] ?
    CUR_VAL LOADI 99999999 > [ drop ] [
        CUR_VAL LOADI 10 * + CUR_VAL STOREI
        1 DIRTY STOREI
    ] ?:
;

@backspace
    CUR_VAL LOADI 10 / CUR_VAL STOREI
    0 NEW_NUM STOREI
    1 DIRTY STOREI
;

@calculate
    PEND_OP LOADI 0 = [ ] [
        PEND_OP LOADI 1 = [ ACC_VAL LOADI CUR_VAL LOADI + ACC_VAL STOREI ] ?
        PEND_OP LOADI 2 = [ ACC_VAL LOADI CUR_VAL LOADI - ACC_VAL STOREI ] ?
        PEND_OP LOADI 3 = [ ACC_VAL LOADI CUR_VAL LOADI * ACC_VAL STOREI ] ?
        PEND_OP LOADI 4 = [ CUR_VAL LOADI 0 = [ 0 ] [ ACC_VAL LOADI CUR_VAL LOADI / ] ?: ACC_VAL STOREI ] ?
        
        ACC_VAL LOADI CUR_VAL STOREI
        0 PEND_OP STOREI
        1 NEW_NUM STOREI
        1 DIRTY STOREI
    ] ?:
;

@set-op ( op -- )
    PEND_OP LOADI 0 <> [ calculate ] ?
    PEND_OP STOREI
    CUR_VAL LOADI ACC_VAL STOREI
    1 NEW_NUM STOREI
    1 DIRTY STOREI
;

@process-key ( char -- )
    dup 48 >= [ dup 57 <= ] [ 0 ] ?: [ 48 - append-digit ] [
        dup 43 = [ 1 set-op ] ? ( + )
        dup 45 = [ 2 set-op ] ? ( - )
        dup 42 = [ 3 set-op ] ? ( * )
        dup 47 = [ 4 set-op ] ? ( / )
        dup 61 = [ calculate ] ? ( = )
        dup 13 = [ calculate ] ? ( Enter )
        dup 67 = [ clear ] ?     ( C )
        dup 99 = [ clear ] ?     ( c )
        dup 8 = [ backspace ] ?  ( Backspace )
        drop
    ] ?:
;

@on-mouse ( mpkt -- ) UI::feed ;

@on-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        dup EVENT::kbd-key process-key
    ] ?
    drop
;

@on-frame ( -- )
    UI::handle
    DIRTY LOADI [
        draw-ui
        0 DIRTY STOREI
    ] [
        UI::draw
    ] ?:
;

@start
    T"Calculator" APP::init
    UI::new
    
    APP::width 220 - 2 / CALC_X STOREI
    APP::height 280 - 2 / CALC_Y STOREI
    build-keys
    
    1 DIRTY STOREI
    
    $on-mouse APP::on-mouse!
    [ on-kbd   ] APP::on-kbd!
    [ on-frame ] APP::on-frame!
    APP::loop
;

CALC::start
HALT
