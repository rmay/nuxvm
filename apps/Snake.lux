( Snake — APP framework, overlay Start/Play Again, system ESC menu. )

INCLUDE "lib/app.lux"
INCLUDE "lib/ui.lux"
INCLUDE "lib/tilemap.lux"

MODULE SNAKE
VERSION 399000

IMPORT APP
IMPORT UI
IMPORT DRAW
IMPORT EVENT
IMPORT STR
IMPORT VFS
IMPORT TILEMAP

@GRID   20 ;
@SEGS   400 ;
@BAR_H  28 ;

RESERVE head   4 ;
RESERVE len    4 ;
RESERVE dir    4 ;
RESERVE want   4 ;
RESERVE foodx  4 ;
RESERVE foody  4 ;
RESERVE state  4 ;
RESERVE tick   4 ;
RESERVE speed  4 ;
RESERVE score  4 ;
RESERVE best   4 ;
RESERVE seed   4 ;
RESERVE nx     4 ;
RESERVE ny     4 ;
RESERVE nbuf  32 ; ( score/best as decimal text )
RESERVE btitle 4 ; ( pointer to the current banner string )
RESERVE body 3200 ; ( SEGS * 8 -- the segment ring, see TILEMAP::ent-get/set )

@get-seg ( i -- x y ) SEGS body TILEMAP::ent-get ;
@set-seg ( x y i -- ) SEGS body TILEMAP::ent-set ;

@random ( max -- n )
    seed LOADI 1103515245 * 12345 +
    dup seed STOREI
    0x7FFFFFFF AND
    SWAP MOD
;

@on-snake? ( x y -- f )
    0 3 frame! ( 0:hit 1:y 2:x )
    0
    [ dup len LOADI < ] [
        head LOADI OVER - get-seg
        1 local@ = [
            2 local@ =
        ] [
            drop 0
        ] ?: [
            1 0 local!
            len LOADI
        ] [
            1 +
        ] ?:
    ] |:
    drop
    0 local@
    3 unframe!
;

@spawn
    40
    [ dup 0 > ] [
        GRID random foodx STOREI
        GRID random foody STOREI
        foodx LOADI foody LOADI on-snake? [
            1 -
        ] [
            drop 0
        ] ?:
    ] |:
    drop
;

@beep ( id -- ) APP::beep ;

@load-best
    T"/sys/file/.snake_hi" best VFS::load-i32 drop
;

@save-best
    T"/sys/file/.snake_hi" best VFS::save-i32 drop
;

@layout
    GRID GRID APP::width APP::height BAR_H - TILEMAP::layout
    0 BAR_H TILEMAP::nudge
;

@reset
    10 head STOREI
    3 len STOREI
    1 dir STOREI
    1 want STOREI
    0 tick STOREI
    10 speed STOREI
    0 score STOREI
    10 10 10 set-seg
    9 10 9 set-seg
    8 10 8 set-seg
    spawn
;

@die
    2 state STOREI
    score LOADI best LOADI > [
        score LOADI best STOREI
        save-best
    ] ?
    110 beep
    place-again
;

@step
    want LOADI dir STOREI
    head LOADI get-seg
    dir LOADI 0 = [ 1 - ] ?
    dir LOADI 2 = [ 1 + ] ?
    SWAP
    dir LOADI 3 = [ 1 - ] ?
    dir LOADI 1 = [ 1 + ] ?
    SWAP
    ny STOREI
    nx STOREI

    nx LOADI 0 < [ 1 ] [ nx LOADI GRID >= ] ?:
    ny LOADI 0 < [ 1 ] [ ny LOADI GRID >= ] ?:
    OR [
        die
    ] [
        nx LOADI ny LOADI on-snake? [
            die
        ] [
            head LOADI 1 + SEGS TILEMAP::ent-wrap head STOREI
            nx LOADI ny LOADI head LOADI set-seg
            foodx LOADI nx LOADI =
            foody LOADI ny LOADI = AND [
                len LOADI 1 + len STOREI
                score LOADI 1 + score STOREI
                score LOADI 5 MOD 0 = [
                    speed LOADI 1 - 3 MAX speed STOREI
                ] ?
                spawn
                440 beep
            ] ?
        ] ?:
    ] ?:
;

@steer ( d -- )
    dir LOADI OVER - ABS 2 = [
        drop
    ] [
        want STOREI
    ] ?:
;

@cell-solid ( gx gy -- )
    APP::draw-fd ROT ROT TILEMAP::cell-box 0x000000 DRAW::fill-rect
;

@cell-pat ( gx gy pat -- )
    3 frame! ( 0:pat 1:gy 2:gx )
    APP::draw-fd 2 local@ 1 local@ TILEMAP::cell-box 0x000000 0 local@ DRAW::fill-pat
    3 unframe!
;

@paint-bar
    APP::draw-fd 0 0 APP::width BAR_H 0xFFFFFF DRAW::fill-rect
    APP::draw-fd 0 BAR_H 1 - APP::width 1 0x000000 DRAW::fill-rect
    APP::draw-fd 8 8 T"Score" 0x000000 1 DRAW::draw-str
    score LOADI nbuf STR::int-to-str
    APP::draw-fd 56 8 nbuf 0x000000 1 DRAW::draw-str
    APP::draw-fd APP::width 140 - 8 T"Best" 0x000000 1 DRAW::draw-str
    best LOADI nbuf STR::int-to-str
    APP::draw-fd APP::width 100 - 8 nbuf 0x000000 1 DRAW::draw-str
;

@paint-field
    APP::draw-fd
    TILEMAP::offx 2 -
    TILEMAP::offy 2 -
    TILEMAP::tile-px GRID * 4 +
    TILEMAP::tile-px GRID * 4 +
    0x000000 DRAW::fill-rect
    APP::draw-fd
    TILEMAP::offx 1 -
    TILEMAP::offy 1 -
    TILEMAP::tile-px GRID * 2 +
    TILEMAP::tile-px GRID * 2 +
    0xFFFFFF DRAW::fill-rect
    0
    [ dup len LOADI < ] [
        dup
        head LOADI OVER - get-seg
        ROT 0 = [
            cell-solid
        ] [
            0 cell-pat
        ] ?:
        1 +
    ] |:
    drop
    foodx LOADI foody LOADI 3 cell-pat
;

@paint-banner ( title -- )
    btitle STOREI
    APP::width 220 - 2 /
    APP::height 120 - 2 /
    2 frame! ( 0:by 1:bx )
    APP::draw-fd 1 local@ 0 local@ 220 120 0x000000 DRAW::fill-rect
    APP::draw-fd 1 local@ 2 + 0 local@ 2 + 216 116 0xFFFFFF DRAW::fill-rect
    APP::draw-fd 1 local@ 30 + 0 local@ 20 + btitle LOADI 0x000000 1 DRAW::draw-str
    2 unframe!
;

@begin ( val -- )
    drop
    reset
    1 state STOREI
    UI::overlay-clear
;

@place-start
    UI::overlay-clear
    T"Start"
    APP::width 80 - 2 /
    APP::height 2 / 16 +
    80 20 [ begin ] UI::overlay-button
;

@place-again
    UI::overlay-clear
    T"Play Again"
    APP::width 100 - 2 /
    APP::height 2 / 16 +
    100 20 [ begin ] UI::overlay-button
;

@on-kbd ( kpkt -- )
    dup EVENT::kbd-type EVENT::KEY_DOWN = [
        EVENT::kbd-key
        state LOADI 1 = [
            dup EVENT::KEY_UP_ARROW = [ 0 steer ] ?
            dup EVENT::KEY_DOWN_ARROW = [ 2 steer ] ?
            dup EVENT::KEY_LEFT_ARROW = [ 3 steer ] ?
            dup EVENT::KEY_RIGHT_ARROW = [ 1 steer ] ?
            dup 119 = [ 0 steer ] ?
            dup 115 = [ 2 steer ] ?
            dup 97 = [ 3 steer ] ?
            dup 100 = [ 1 steer ] ?
            drop
        ] [
            EVENT::KEY_ENTER = [
                0 begin
            ] ?
        ] ?:
    ] [
        drop
    ] ?:
;

@on-mouse ( mpkt -- )
    state LOADI 1 = [
        drop
    ] [
        UI::overlay-feed
        UI::overlay-handle
    ] ?:
;

( Simulation. `tick`/`speed` count APP's fixed 16ms steps rather than rendered
  frames, so the snake crawls at the same rate on any display and under any
  frame cost. The step counts are unchanged -- frames were already ~60Hz. )
@on-tick ( -- )
    APP::esc-open? 0 = [
        state LOADI 1 = [
            tick LOADI 1 + tick STOREI
            tick LOADI speed LOADI >= [
                0 tick STOREI
                step
            ] ?
        ] ?
    ] ?
;

@on-frame ( -- )
    APP::draw-fd 0 0 APP::width APP::height 0xFFFFFF DRAW::fill-rect
    paint-bar
    state LOADI 0 = [
        T"SNAKE" paint-banner
        UI::overlay-draw
    ] [
        paint-field
        state LOADI 2 = [
            T"GAME OVER" paint-banner
            UI::overlay-draw
        ] ?
    ] ?:
;

@start
    T"Snake" APP::init
    UI::new
    1 seed STOREI
    0 state STOREI
    load-best
    layout
    reset
    place-start
    [ on-mouse ] APP::on-mouse!
    [ on-kbd ] APP::on-kbd!
    [ on-tick ] APP::on-tick!
    [ on-frame ] APP::on-frame!
    APP::loop
;

SNAKE::start
HALT
